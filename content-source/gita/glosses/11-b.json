      { "sa": "lokān", "en": "the worlds" },
      { "sa": "samāhartum", "en": "to draw in" },
      { "sa": "iha", "en": "here" },
      { "sa": "pravṛttaḥ", "en": "set in motion" },
      { "sa": "ṛte", "en": "without" },
      { "sa": "api", "en": "even" },
      { "sa": "tvām", "en": "you" },
      { "sa": "na", "en": "not" },

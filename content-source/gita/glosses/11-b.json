      { "sa": "sarvāḥ", "en": "all" },
      { "sa": "dṛṣṭvā", "en": "having seen" },
      { "sa": "adbhutam", "en": "wondrous" },
      { "sa": "rūpam", "en": "form" },
      { "sa": "ugram", "en": "fierce" },

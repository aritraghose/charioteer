      { "sa": "dṛṣṭvā", "en": "having seen" },
      { "sa": "hi", "en": "indeed" },
      { "sa": "tvām", "en": "you" },
      { "sa": "pravyathita-antar-ātmā", "en": "with inner self shaken", "term": "atman" },

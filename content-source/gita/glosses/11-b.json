      { "sa": "tava", "en": "your" },
      { "sa": "pravṛttim", "en": "activity" }
    ],
    "translation": "Tell me who you are, sir, of fierce form. Let there be homage to you, O best of gods. Be gracious. I wish to know you fully, sir, the first one, for I do not understand your activity.",
    "notes": ["\"Your activity\" can also be read as \"your purpose\"."]
  },
  "32": {
    "words": [
      { "sa": "kālaḥ", "en": "time" },
      { "sa": "asmi", "en": "I am" },
      { "sa": "loka-kṣaya-kṛt", "en": "causing the destruction of the worlds" },

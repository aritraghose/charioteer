{
  "19": {
    "words": [
      { "sa": "anādi-madhya-antam", "en": "without beginning, middle or end" },
      { "sa": "ananta-vīryam", "en": "of endless power" },
      { "sa": "ananta-bāhum", "en": "of endless arms" },
      { "sa": "śaśi-sūrya-netram", "en": "having the moon and sun as eyes" },
      { "sa": "paśyāmi", "en": "I see" },
      { "sa": "tvām", "en": "you" },
      { "sa": "dīpta-hutāśa-vaktram", "en": "having blazing fire as mouth" },
      { "sa": "sva-tejasā", "en": "by your own radiance" },
      { "sa": "viśvam", "en": "universe" },
      { "sa": "idam", "en": "this" },
      { "sa": "tapantam", "en": "heating" }
    ],
    "translation": "I see you without beginning, middle or end, of endless power, of endless arms, having the moon and sun as eyes, having blazing fire as mouth, heating this universe by your own radiance."
  },

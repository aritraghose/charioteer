      { "sa": "bhītāni", "en": "frightened" },
      { "sa": "diśaḥ", "en": "to the directions" },
      { "sa": "dravanti", "en": "they run" },
      { "sa": "sarve", "en": "all" },
      { "sa": "namasyanti", "en": "they pay homage" },

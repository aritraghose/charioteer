{
  "1": {
    "words": [
      { "sa": "evam", "en": "thus" },
      { "sa": "satata-yuktāḥ", "en": "constantly yoked", "term": "yoga" },
      { "sa": "ye", "en": "those who" },
      { "sa": "bhaktāḥ", "en": "devotees" },
      { "sa": "tvām", "en": "you" },
      { "sa": "paryupāsate", "en": "they worship" },
      { "sa": "ye", "en": "those who" },
      { "sa": "ca", "en": "and" },
      { "sa": "api", "en": "also" },
      { "sa": "akṣaram", "en": "the imperishable" },
      { "sa": "avyaktam", "en": "the unmanifest" },
      { "sa": "teṣām", "en": "of them" },
      { "sa": "ke", "en": "which ones" },
      { "sa": "yoga-vit-tamāḥ", "en": "the best knowers of yoga", "term": "yoga" }
    ],
    "translation": "The devotees who, thus constantly yoked, worship you, and also those who worship the imperishable, the unmanifest: of them, which are the best knowers of yoga?"
  },
  "2": {
    "words": [
      { "sa": "mayi", "en": "on me" },
      { "sa": "āveśya", "en": "having fixed" },
      { "sa": "manaḥ", "en": "the mind", "term": "manas" },
      { "sa": "ye", "en": "those who" },
      { "sa": "mām", "en": "me" },
      { "sa": "nitya-yuktāḥ", "en": "always yoked", "term": "yoga" },
      { "sa": "upāsate", "en": "they worship" },
      { "sa": "śraddhayā", "en": "with faith" },
      { "sa": "parayā", "en": "with supreme" },
      { "sa": "upetāḥ", "en": "endowed" },
      { "sa": "te", "en": "they" },
      { "sa": "me", "en": "by me" },
      { "sa": "yukta-tamāḥ", "en": "the most yoked", "term": "yoga" },
      { "sa": "matāḥ", "en": "are held to be" }
    ],
    "translation": "Those who, having fixed the mind on me, worship me, always yoked, endowed with supreme faith: they are held by me to be the most yoked."
  },
  "3": {
    "words": [
      { "sa": "ye", "en": "those who" },
      { "sa": "tu", "en": "but" },
      { "sa": "akṣaram", "en": "the imperishable" },
      { "sa": "anirdeśyam", "en": "the indefinable" },
      { "sa": "avyaktam", "en": "the unmanifest" },
      { "sa": "paryupāsate", "en": "they worship" },
      { "sa": "sarvatra-gam", "en": "going everywhere" },
      { "sa": "acintyam", "en": "the unthinkable" },
      { "sa": "ca", "en": "and" },
      { "sa": "kūṭa-stham", "en": "the unchanging" },
      { "sa": "acalam", "en": "the unmoving" },
      { "sa": "dhruvam", "en": "the fixed" }
    ],
    "translation": "But those who worship the imperishable, the indefinable, the unmanifest, which goes everywhere and is unthinkable, the unchanging, the unmoving, the fixed,",
    "notes": [
      "Verses 3 to 4 are one sentence in the Sanskrit.",
      "\"The unchanging\" can also be read as \"that which stands at the summit\"."
    ]
  },
  "4": {
    "words": [
      { "sa": "sanniyamya", "en": "having restrained" },
      { "sa": "indriya-grāmam", "en": "the whole group of the senses", "term": "indriya" },
      { "sa": "sarvatra", "en": "everywhere" },
      { "sa": "sama-buddhayaḥ", "en": "of even buddhi", "term": "samatva" },
      { "sa": "te", "en": "they" },
      { "sa": "prāpnuvanti", "en": "they reach" },
      { "sa": "mām", "en": "me" },
      { "sa": "eva", "en": "alone" },
      { "sa": "sarva-bhūta-hite", "en": "in the welfare of all beings" },
      { "sa": "ratāḥ", "en": "delighting" }
    ],
    "translation": "having restrained the whole group of the senses, of even buddhi everywhere, they reach me alone, delighting in the welfare of all beings.",
    "notes": [
      "\"They reach me alone\" can also be read as \"they too reach me\"."
    ]
  },
  "5": {
    "words": [
      { "sa": "kleśaḥ", "en": "the trouble" },
      { "sa": "adhika-taraḥ", "en": "greater" },
      { "sa": "teṣām", "en": "of those" },
      { "sa": "avyakta-āsakta-cetasām", "en": "whose minds are attached to the unmanifest", "term": "sanga" },
      { "sa": "avyaktā", "en": "unmanifest" },
      { "sa": "hi", "en": "for" },
      { "sa": "gatiḥ", "en": "the goal" },
      { "sa": "duḥkham", "en": "with pain" },
      { "sa": "dehavadbhiḥ", "en": "by those who have bodies", "term": "dehin" },
      { "sa": "avāpyate", "en": "is reached" }
    ],
    "translation": "The trouble is greater for those whose minds are attached to the unmanifest, for the unmanifest goal is reached with pain by those who have bodies."
  },
  "6": {
    "words": [
      { "sa": "ye", "en": "those who" },
      { "sa": "tu", "en": "but" },
      { "sa": "sarvāṇi", "en": "all" },
      { "sa": "karmāṇi", "en": "actions", "term": "karma" },
      { "sa": "mayi", "en": "in me" },
      { "sa": "saṁnyasya", "en": "having laid down", "term": "sannyasa" },
      { "sa": "mat-parāḥ", "en": "holding me as the highest" },
      { "sa": "ananyena", "en": "with no other" },
      { "sa": "eva", "en": "indeed" },
      { "sa": "yogena", "en": "by yoga", "term": "yoga" },
      { "sa": "mām", "en": "me" },
      { "sa": "dhyāyantaḥ", "en": "meditating on" },
      { "sa": "upāsate", "en": "they worship" }
    ],
    "translation": "But those who, having laid down all actions in me, holding me as the highest, worship me, meditating on me by a yoga that indeed has no other object,",
    "notes": [
      "Verses 6 to 7 are one sentence in the Sanskrit."
    ]
  },
  "7": {
    "words": [
      { "sa": "teṣām", "en": "of them" },
      { "sa": "aham", "en": "I" },
      { "sa": "samuddhartā", "en": "the one who lifts out" },
      { "sa": "mṛtyu-saṁsāra-sāgarāt", "en": "from the ocean of death and wandering on" },
      { "sa": "bhavāmi", "en": "I become" },
      { "sa": "nacirāt", "en": "before long" },
      { "sa": "pārtha", "en": "O son of Pṛthā" },
      { "sa": "mayi", "en": "on me" },
      { "sa": "āveśita-cetasām", "en": "whose minds are fixed" }
    ],
    "translation": "of them, whose minds are fixed on me, I become before long the one who lifts them out from the ocean of death and wandering on, O son of Pṛthā."
  },
  "8": {
    "words": [
      { "sa": "mayi", "en": "on me" },
      { "sa": "eva", "en": "alone" },
      { "sa": "manaḥ", "en": "the mind", "term": "manas" },
      { "sa": "ādhatsva", "en": "place" },
      { "sa": "mayi", "en": "into me" },
      { "sa": "buddhim", "en": "buddhi", "term": "buddhi" },
      { "sa": "niveśaya", "en": "make enter" },
      { "sa": "nivasiṣyasi", "en": "you will dwell" },
      { "sa": "mayi", "en": "in me" },
      { "sa": "eva", "en": "alone" },
      { "sa": "ataḥ", "en": "from this" },
      { "sa": "ūrdhvam", "en": "onward" },
      { "sa": "na", "en": "not" },
      { "sa": "saṁśayaḥ", "en": "doubt" }
    ],
    "translation": "Place the mind on me alone, make buddhi enter into me. From this onward you will dwell in me alone. There is no doubt."
  },
  "9": {
    "words": [
      { "sa": "atha", "en": "now if" },
      { "sa": "cittam", "en": "the mind" },
      { "sa": "samādhātum", "en": "to settle", "term": "samadhi" },
      { "sa": "na", "en": "not" },
      { "sa": "śaknoṣi", "en": "you are able" },
      { "sa": "mayi", "en": "on me" },
      { "sa": "sthiram", "en": "steadily" },
      { "sa": "abhyāsa-yogena", "en": "by the yoga of practice", "term": "abhyasa" },
      { "sa": "tataḥ", "en": "then" },
      { "sa": "mām", "en": "me" },
      { "sa": "iccha", "en": "seek" },
      { "sa": "āptum", "en": "to reach" },
      { "sa": "dhanañjaya", "en": "O winner of wealth" }
    ],
    "translation": "Now if you are not able to settle the mind steadily on me, then seek to reach me by the yoga of practice, O winner of wealth."
  },
  "10": {
    "words": [
      { "sa": "abhyāse", "en": "in practice", "term": "abhyasa" },
      { "sa": "api", "en": "even" },
      { "sa": "asamarthaḥ", "en": "unable" },
      { "sa": "asi", "en": "you are" },
      { "sa": "mat-karma-paramaḥ", "en": "one for whom action for me is the highest", "term": "karma" },
      { "sa": "bhava", "en": "become" },
      { "sa": "mat-artham", "en": "for my sake" },
      { "sa": "api", "en": "even" },
      { "sa": "karmāṇi", "en": "actions", "term": "karma" },
      { "sa": "kurvan", "en": "doing" },
      { "sa": "siddhim", "en": "perfection" },
      { "sa": "avāpsyasi", "en": "you will reach" }
    ],
    "translation": "If you are unable even in practice, become one for whom action for me is the highest. Even doing actions for my sake, you will reach perfection."
  },
  "11": {
    "words": [
      { "sa": "atha", "en": "now if" },
      { "sa": "etat", "en": "this" },
      { "sa": "api", "en": "even" },
      { "sa": "aśaktaḥ", "en": "unable" },
      { "sa": "asi", "en": "you are" },
      { "sa": "kartum", "en": "to do" },
      { "sa": "mat-yogam", "en": "to my yoga", "term": "yoga" },
      { "sa": "āśritaḥ", "en": "resorting" },
      { "sa": "sarva-karma-phala-tyāgam", "en": "the giving up of the fruit of all action", "term": "karma" },
      { "sa": "tataḥ", "en": "then" },
      { "sa": "kuru", "en": "do" },
      { "sa": "yata-ātmavān", "en": "with the self restrained", "term": "atman" }
    ],
    "translation": "Now if you are unable to do even this, then, resorting to my yoga, with the self restrained, give up the fruit of all action.",
    "notes": [
      "\"Then, resorting to my yoga\" can also be read with the first half: \"if you are unable to do even this while resorting to my yoga\"."
    ]
  },
  "12": {
    "words": [
      { "sa": "śreyaḥ", "en": "better" },
      { "sa": "hi", "en": "for" },
      { "sa": "jñānam", "en": "knowledge" },
      { "sa": "abhyāsāt", "en": "than practice", "term": "abhyasa" },
      { "sa": "jñānāt", "en": "than knowledge" },
      { "sa": "dhyānam", "en": "meditation" },
      { "sa": "viśiṣyate", "en": "it surpasses" },
      { "sa": "dhyānāt", "en": "than meditation" },
      { "sa": "karma-phala-tyāgaḥ", "en": "the giving up of the fruit of action", "term": "karma" },
      { "sa": "tyāgāt", "en": "from giving up" },
      { "sa": "śāntiḥ", "en": "peace", "term": "shanti" },
      { "sa": "anantaram", "en": "immediately after" }
    ],
    "translation": "For knowledge is better than practice, meditation surpasses knowledge, and the giving up of the fruit of action surpasses meditation. From giving up, peace comes immediately after."
  },
  "13": {
    "words": [
      { "sa": "adveṣṭā", "en": "one who does not hate" },
      { "sa": "sarva-bhūtānām", "en": "of all beings" },
      { "sa": "maitraḥ", "en": "friendly" },
      { "sa": "karuṇaḥ", "en": "compassionate" },
      { "sa": "eva", "en": "indeed" },
      { "sa": "ca", "en": "and" },
      { "sa": "nirmamaḥ", "en": "without the sense of mine" },
      { "sa": "nirahaṅkāraḥ", "en": "without the sense of I" },
      { "sa": "sama-duḥkha-sukhaḥ", "en": "the same in pain and pleasure", "term": "samatva" },
      { "sa": "kṣamī", "en": "patient" }
    ],
    "translation": "One who does not hate any of all beings, friendly and indeed compassionate, without the sense of mine, without the sense of I, the same in pain and pleasure, patient,",
    "notes": [
      "Verses 13 to 14 are one sentence in the Sanskrit."
    ]
  },
  "14": {
    "words": [
      { "sa": "santuṣṭaḥ", "en": "content" },
      { "sa": "satatam", "en": "always" },
      { "sa": "yogī", "en": "a yogī", "term": "yoga" },
      { "sa": "yata-ātmā", "en": "with the self restrained", "term": "atman" },
      { "sa": "dṛḍha-niścayaḥ", "en": "of firm resolve" },
      { "sa": "mayi", "en": "to me" },
      { "sa": "arpita-manaḥ-buddhiḥ", "en": "with mind and buddhi offered", "term": "buddhi" },
      { "sa": "yaḥ", "en": "he who" },
      { "sa": "mat-bhaktaḥ", "en": "devoted to me" },
      { "sa": "saḥ", "en": "he" },
      { "sa": "me", "en": "to me" },
      { "sa": "priyaḥ", "en": "dear" }
    ],
    "translation": "always content, a yogī, with the self restrained, of firm resolve, with mind and buddhi offered to me: he who is devoted to me is dear to me.",
    "notes": [
      "\"Always content, a yogī\" can also be read as \"content, always a yogī\"."
    ]
  },
  "15": {
    "words": [
      { "sa": "yasmāt", "en": "from whom" },
      { "sa": "na", "en": "not" },
      { "sa": "udvijate", "en": "it shrinks" },
      { "sa": "lokaḥ", "en": "the world" },
      { "sa": "lokāt", "en": "from the world" },
      { "sa": "na", "en": "not" },
      { "sa": "udvijate", "en": "he shrinks" },
      { "sa": "ca", "en": "and" },
      { "sa": "yaḥ", "en": "who" },
      { "sa": "harṣa-amarṣa-bhaya-udvegaiḥ", "en": "from joy, impatience, fear and agitation" },
      { "sa": "muktaḥ", "en": "freed" },
      { "sa": "yaḥ", "en": "who" },
      { "sa": "saḥ", "en": "he" },
      { "sa": "ca", "en": "too" },
      { "sa": "me", "en": "to me" },
      { "sa": "priyaḥ", "en": "dear" }
    ],
    "translation": "He from whom the world does not shrink, and who does not shrink from the world, who is freed from joy, impatience, fear and agitation: he too is dear to me."
  },
  "16": {
    "words": [
      { "sa": "anapekṣaḥ", "en": "expecting nothing" },
      { "sa": "śuciḥ", "en": "pure" },
      { "sa": "dakṣaḥ", "en": "skilled" },
      { "sa": "udāsīnaḥ", "en": "sitting apart" },
      { "sa": "gata-vyathaḥ", "en": "with distress gone" },
      { "sa": "sarva-ārambha-parityāgī", "en": "giving up all undertakings" },
      { "sa": "yaḥ", "en": "he who" },
      { "sa": "mat-bhaktaḥ", "en": "devoted to me" },
      { "sa": "saḥ", "en": "he" },
      { "sa": "me", "en": "to me" },
      { "sa": "priyaḥ", "en": "dear" }
    ],
    "translation": "Expecting nothing, pure, skilled, sitting apart, with distress gone, giving up all undertakings: he who is devoted to me is dear to me."
  },
  "17": {
    "words": [
      { "sa": "yaḥ", "en": "he who" },
      { "sa": "na", "en": "not" },
      { "sa": "hṛṣyati", "en": "he rejoices" },
      { "sa": "na", "en": "not" },
      { "sa": "dveṣṭi", "en": "he hates" },
      { "sa": "na", "en": "not" },
      { "sa": "śocati", "en": "he grieves" },
      { "sa": "na", "en": "not" },
      { "sa": "kāṅkṣati", "en": "he longs" },
      { "sa": "śubha-aśubha-parityāgī", "en": "giving up the auspicious and the inauspicious" },
      { "sa": "bhaktimān", "en": "full of devotion" },
      { "sa": "yaḥ", "en": "who" },
      { "sa": "saḥ", "en": "he" },
      { "sa": "me", "en": "to me" },
      { "sa": "priyaḥ", "en": "dear" }
    ],
    "translation": "He who does not rejoice, does not hate, does not grieve, does not long, giving up the auspicious and the inauspicious, who is full of devotion: he is dear to me."
  },
  "18": {
    "words": [
      { "sa": "samaḥ", "en": "the same", "term": "samatva" },
      { "sa": "śatrau", "en": "toward an enemy" },
      { "sa": "ca", "en": "and" },
      { "sa": "mitre", "en": "toward a friend" },
      { "sa": "ca", "en": "and" },
      { "sa": "tathā", "en": "likewise" },
      { "sa": "māna-apamānayoḥ", "en": "in honour and dishonour" },
      { "sa": "śīta-uṣṇa-sukha-duḥkheṣu", "en": "in cold and heat, pleasure and pain" },
      { "sa": "samaḥ", "en": "the same", "term": "samatva" },
      { "sa": "saṅga-vivarjitaḥ", "en": "free from attachment", "term": "sanga" }
    ],
    "translation": "The same toward an enemy and toward a friend, and likewise in honour and dishonour, the same in cold and heat, pleasure and pain, free from attachment,",
    "notes": [
      "Verses 18 to 19 are one sentence in the Sanskrit."
    ]
  },
  "19": {
    "words": [
      { "sa": "tulya-nindā-stutiḥ", "en": "to whom blame and praise are equal" },
      { "sa": "maunī", "en": "silent" },
      { "sa": "santuṣṭaḥ", "en": "content" },
      { "sa": "yena", "en": "with whatever" },
      { "sa": "kenacit", "en": "with anything" },
      { "sa": "aniketaḥ", "en": "without a home" },
      { "sa": "sthira-matiḥ", "en": "of steady mind" },
      { "sa": "bhaktimān", "en": "full of devotion" },
      { "sa": "me", "en": "to me" },
      { "sa": "priyaḥ", "en": "dear" },
      { "sa": "naraḥ", "en": "the man" }
    ],
    "translation": "to whom blame and praise are equal, silent, content with anything whatever, without a home, of steady mind, full of devotion: that man is dear to me."
  },
  "20": {
    "words": [
      { "sa": "ye", "en": "those who" },
      { "sa": "tu", "en": "but" },
      { "sa": "dharmya-amṛtam", "en": "the nectar that accords with dharma", "term": "dharma" },
      { "sa": "idam", "en": "this" },
      { "sa": "yathā-uktam", "en": "as spoken" },
      { "sa": "paryupāsate", "en": "they honour" },
      { "sa": "śraddadhānāḥ", "en": "having faith" },
      { "sa": "mat-paramāḥ", "en": "holding me as the highest" },
      { "sa": "bhaktāḥ", "en": "devotees" },
      { "sa": "te", "en": "they" },
      { "sa": "atīva", "en": "exceedingly" },
      { "sa": "me", "en": "to me" },
      { "sa": "priyāḥ", "en": "dear" }
    ],
    "translation": "But those who honour this nectar that accords with dharma, as spoken, having faith, holding me as the highest, devotees: they are exceedingly dear to me.",
    "notes": [
      "\"This nectar that accords with dharma\" can also be read as \"this immortal dharma\"."
    ]
  }
}

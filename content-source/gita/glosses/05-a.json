{
  "1": {
    "words": [
      { "sa": "saṁnyāsam", "en": "the renunciation", "term": "sannyasa" },
      { "sa": "karmaṇām", "en": "of actions", "term": "karma" },
      { "sa": "kṛṣṇa", "en": "O Kṛṣṇa" },
      { "sa": "punaḥ", "en": "again" },
      { "sa": "yogam", "en": "yoga", "term": "yoga" },
      { "sa": "ca", "en": "and" },
      { "sa": "śaṁsasi", "en": "you praise" },
      { "sa": "yat", "en": "which" },
      { "sa": "śreyaḥ", "en": "better" },
      { "sa": "etayoḥ", "en": "of these two" },
      { "sa": "ekam", "en": "one" },
      { "sa": "tat", "en": "that" },
      { "sa": "me", "en": "to me" },
      { "sa": "brūhi", "en": "tell" },
      { "sa": "su-niścitam", "en": "well determined" }
    ],
    "translation": "You praise the renunciation of actions, O Kṛṣṇa, and again yoga. Which one of these two is better, tell me that, well determined."
  },
  "2": {
    "words": [
      { "sa": "saṁnyāsaḥ", "en": "renunciation", "term": "sannyasa" },
      { "sa": "karma-yogaḥ", "en": "the yoga of action", "term": "yoga" },
      { "sa": "ca", "en": "and" },
      { "sa": "niḥśreyasa-karau", "en": "bringing about the highest good" },
      { "sa": "ubhau", "en": "both" },
      { "sa": "tayoḥ", "en": "of the two" },
      { "sa": "tu", "en": "but" },
      { "sa": "karma-saṁnyāsāt", "en": "than the renunciation of action", "term": "sannyasa" },
      { "sa": "karma-yogaḥ", "en": "the yoga of action", "term": "yoga" },
      { "sa": "viśiṣyate", "en": "excels" }
    ],
    "translation": "Renunciation and the yoga of action both bring about the highest good. But of the two, the yoga of action excels the renunciation of action."
  },
  "3": {
    "words": [
      { "sa": "jñeyaḥ", "en": "to be known" },
      { "sa": "saḥ", "en": "he" },
      { "sa": "nitya-saṁnyāsī", "en": "a constant renouncer", "term": "sannyasa" },
      { "sa": "yaḥ", "en": "who" },
      { "sa": "na", "en": "not" },
      { "sa": "dveṣṭi", "en": "hates" },
      { "sa": "na", "en": "not" },
      { "sa": "kāṅkṣati", "en": "longs" },
      { "sa": "nirdvandvaḥ", "en": "free from the pairs of opposites" },
      { "sa": "hi", "en": "for" },
      { "sa": "mahā-bāho", "en": "O mighty-armed one" },
      { "sa": "sukham", "en": "easily" },
      { "sa": "bandhāt", "en": "from bondage" },
      { "sa": "pramucyate", "en": "is released" }
    ],
    "translation": "He is to be known as a constant renouncer who neither hates nor longs. For one free from the pairs of opposites, O mighty-armed one, is easily released from bondage."
  },
  "4": {
    "words": [
      { "sa": "sāṅkhya-yogau", "en": "sāṅkhya and yoga", "term": "sankhya" },
      { "sa": "pṛthak", "en": "separate" },
      { "sa": "bālāḥ", "en": "the childish" },
      { "sa": "pravadanti", "en": "declare" },
      { "sa": "na", "en": "not" },
      { "sa": "paṇḍitāḥ", "en": "the learned" },
      { "sa": "ekam", "en": "in one" },
      { "sa": "api", "en": "even" },
      { "sa": "āsthitaḥ", "en": "established" },
      { "sa": "samyak", "en": "rightly" },
      { "sa": "ubhayoḥ", "en": "of both" },
      { "sa": "vindate", "en": "finds" },
      { "sa": "phalam", "en": "the fruit" }
    ],
    "translation": "The childish, not the learned, declare sāṅkhya and yoga to be separate. One who is rightly established in even one finds the fruit of both."
  },
  "5": {
    "words": [
      { "sa": "yat", "en": "which" },
      { "sa": "sāṅkhyaiḥ", "en": "by the followers of sāṅkhya", "term": "sankhya" },
      { "sa": "prāpyate", "en": "is reached" },
      { "sa": "sthānam", "en": "the place" },
      { "sa": "tat", "en": "that" },
      { "sa": "yogaiḥ", "en": "by the followers of yoga", "term": "yoga" },
      { "sa": "api", "en": "also" },
      { "sa": "gamyate", "en": "is gone to" },
      { "sa": "ekam", "en": "one" },
      { "sa": "sāṅkhyam", "en": "sāṅkhya", "term": "sankhya" },
      { "sa": "ca", "en": "and" },
      { "sa": "yogam", "en": "yoga", "term": "yoga" },
      { "sa": "ca", "en": "and" },
      { "sa": "yaḥ", "en": "who" },
      { "sa": "paśyati", "en": "sees" },
      { "sa": "saḥ", "en": "he" },
      { "sa": "paśyati", "en": "sees" }
    ],
    "translation": "The place that is reached by the followers of sāṅkhya, that is also gone to by the followers of yoga. One who sees sāṅkhya and yoga as one, he sees."
  },
  "6": {
    "words": [
      { "sa": "saṁnyāsaḥ", "en": "renunciation", "term": "sannyasa" },
      { "sa": "tu", "en": "but" },
      { "sa": "mahā-bāho", "en": "O mighty-armed one" },
      { "sa": "duḥkham", "en": "hard" },
      { "sa": "āptum", "en": "to reach" },
      { "sa": "ayogataḥ", "en": "without yoga", "term": "yoga" },
      { "sa": "yoga-yuktaḥ", "en": "yoked by yoga", "term": "yoga" },
      { "sa": "muniḥ", "en": "the sage" },
      { "sa": "brahma", "en": "to brahman", "term": "brahman" },
      { "sa": "nacireṇa", "en": "before long" },
      { "sa": "adhigacchati", "en": "goes" }
    ],
    "translation": "But renunciation, O mighty-armed one, is hard to reach without yoga. The sage yoked by yoga goes to brahman before long."
  },
  "7": {
    "words": [
      { "sa": "yoga-yuktaḥ", "en": "yoked by yoga", "term": "yoga" },
      { "sa": "viśuddha-ātmā", "en": "whose self is purified", "term": "atman" },
      { "sa": "vijita-ātmā", "en": "whose self is conquered", "term": "atman" },
      { "sa": "jita-indriyaḥ", "en": "whose senses are conquered", "term": "indriya" },
      { "sa": "sarva-bhūta-ātma-bhūta-ātmā", "en": "whose self has become the self of all beings", "term": "atman" },
      { "sa": "kurvan", "en": "acting" },
      { "sa": "api", "en": "even" },
      { "sa": "na", "en": "not" },
      { "sa": "lipyate", "en": "is smeared" }
    ],
    "translation": "One who is yoked by yoga, whose self is purified, whose self is conquered, whose senses are conquered, whose self has become the self of all beings, is not smeared even while acting."
  },
  "8": {
    "words": [
      { "sa": "na", "en": "not" },
      { "sa": "eva", "en": "at all" },
      { "sa": "kiñcit", "en": "anything" },
      { "sa": "karomi", "en": "I do" },
      { "sa": "iti", "en": "thus" },
      { "sa": "yuktaḥ", "en": "the yoked one", "term": "yoga" },
      { "sa": "manyeta", "en": "should think" },
      { "sa": "tattva-vit", "en": "the knower of the truth" },
      { "sa": "paśyan", "en": "seeing" },
      { "sa": "śṛṇvan", "en": "hearing" },
      { "sa": "spṛśan", "en": "touching" },
      { "sa": "jighran", "en": "smelling" },
      { "sa": "aśnan", "en": "eating" },
      { "sa": "gacchan", "en": "going" },
      { "sa": "svapan", "en": "sleeping" },
      { "sa": "śvasan", "en": "breathing" }
    ],
    "translation": "\"I do not do anything at all\": thus the yoked one, the knower of the truth, should think, while seeing, hearing, touching, smelling, eating, going, sleeping, breathing,",
    "notes": ["Verses 8 to 9 are one sentence in the Sanskrit."]
  },
  "9": {
    "words": [
      { "sa": "pralapan", "en": "talking" },
      { "sa": "visṛjan", "en": "letting go" },
      { "sa": "gṛhṇan", "en": "grasping" },
      { "sa": "unmiṣan", "en": "opening the eyes" },
      { "sa": "nimiṣan", "en": "closing the eyes" },
      { "sa": "api", "en": "even" },
      { "sa": "indriyāṇi", "en": "the senses", "term": "indriya" },
      { "sa": "indriya-artheṣu", "en": "among the objects of the senses", "term": "indriya" },
      { "sa": "vartante", "en": "move" },
      { "sa": "iti", "en": "thus" },
      { "sa": "dhārayan", "en": "holding" }
    ],
    "translation": "talking, letting go, grasping, even opening the eyes and closing the eyes, holding thus: \"The senses move among the objects of the senses.\"",
    "notes": ["\"Letting go\" can also be read as \"excreting\"."]
  },
  "10": {
    "words": [
      { "sa": "brahmaṇi", "en": "in brahman", "term": "brahman" },
      { "sa": "ādhāya", "en": "having placed" },
      { "sa": "karmāṇi", "en": "actions", "term": "karma" },
      { "sa": "saṅgam", "en": "attachment", "term": "sanga" },
      { "sa": "tyaktvā", "en": "having given up" },
      { "sa": "karoti", "en": "acts" },
      { "sa": "yaḥ", "en": "who" },
      { "sa": "lipyate", "en": "is smeared" },
      { "sa": "na", "en": "not" },
      { "sa": "saḥ", "en": "he" },
      { "sa": "pāpena", "en": "by evil" },
      { "sa": "padma-patram", "en": "a lotus leaf" },
      { "sa": "iva", "en": "like" },
      { "sa": "ambhasā", "en": "by water" }
    ],
    "translation": "One who acts having placed actions in brahman, having given up attachment, he is not smeared by evil, like a lotus leaf by water."
  },
  "11": {
    "words": [
      { "sa": "kāyena", "en": "with the body" },
      { "sa": "manasā", "en": "with the mind", "term": "manas" },
      { "sa": "buddhyā", "en": "with the buddhi", "term": "buddhi" },
      { "sa": "kevalaiḥ", "en": "alone" },
      { "sa": "indriyaiḥ", "en": "with the senses", "term": "indriya" },
      { "sa": "api", "en": "even" },
      { "sa": "yoginaḥ", "en": "yogīs", "term": "yoga" },
      { "sa": "karma", "en": "action", "term": "karma" },
      { "sa": "kurvanti", "en": "do" },
      { "sa": "saṅgam", "en": "attachment", "term": "sanga" },
      { "sa": "tyaktvā", "en": "having given up" },
      { "sa": "ātma-śuddhaye", "en": "for the purification of the self", "term": "atman" }
    ],
    "translation": "With the body, with the mind, with the buddhi, even with the senses alone, yogīs do action, having given up attachment, for the purification of the self."
  },
  "12": {
    "words": [
      { "sa": "yuktaḥ", "en": "the yoked one", "term": "yoga" },
      { "sa": "karma-phalam", "en": "the fruit of action", "term": "karma" },
      { "sa": "tyaktvā", "en": "having given up" },
      { "sa": "śāntim", "en": "peace", "term": "shanti" },
      { "sa": "āpnoti", "en": "attains" },
      { "sa": "naiṣṭhikīm", "en": "final" },
      { "sa": "ayuktaḥ", "en": "the unyoked one", "term": "yoga" },
      { "sa": "kāma-kāreṇa", "en": "by the working of desire", "term": "kama" },
      { "sa": "phale", "en": "to the fruit" },
      { "sa": "saktaḥ", "en": "attached", "term": "sanga" },
      { "sa": "nibadhyate", "en": "is bound" }
    ],
    "translation": "The yoked one, having given up the fruit of action, attains final peace. The unyoked one, attached to the fruit by the working of desire, is bound.",
    "notes": ["\"Final peace\" can also be read as \"the peace that comes from steadfastness\"."]
  },
  "13": {
    "words": [
      { "sa": "sarva-karmāṇi", "en": "all actions", "term": "karma" },
      { "sa": "manasā", "en": "with the mind", "term": "manas" },
      { "sa": "saṁnyasya", "en": "having renounced", "term": "sannyasa" },
      { "sa": "āste", "en": "sits" },
      { "sa": "sukham", "en": "happily" },
      { "sa": "vaśī", "en": "in control" },
      { "sa": "nava-dvāre", "en": "of nine gates" },
      { "sa": "pure", "en": "in the city" },
      { "sa": "dehī", "en": "the embodied one", "term": "dehin" },
      { "sa": "na", "en": "not" },
      { "sa": "eva", "en": "at all" },
      { "sa": "kurvan", "en": "acting" },
      { "sa": "na", "en": "not" },
      { "sa": "kārayan", "en": "causing action" }
    ],
    "translation": "Having renounced all actions with the mind, the embodied one sits happily, in control, in the city of nine gates, not acting at all and not causing action."
  },
  "14": {
    "words": [
      { "sa": "na", "en": "not" },
      { "sa": "kartṛtvam", "en": "doership" },
      { "sa": "na", "en": "not" },
      { "sa": "karmāṇi", "en": "actions", "term": "karma" },
      { "sa": "lokasya", "en": "of the world" },
      { "sa": "sṛjati", "en": "creates" },
      { "sa": "prabhuḥ", "en": "the lord" },
      { "sa": "na", "en": "not" },
      { "sa": "karma-phala-saṁyogam", "en": "the joining of action with its fruit", "term": "karma" },
      { "sa": "svabhāvaḥ", "en": "one's own nature" },
      { "sa": "tu", "en": "but" },
      { "sa": "pravartate", "en": "goes forward" }
    ],
    "translation": "The lord does not create the doership of the world, nor its actions, nor the joining of action with its fruit. But one's own nature goes forward.",
    "notes": ["\"The lord\" can be read as the self, the master of the body, or as the Lord of the universe."]
  },
  "15": {
    "words": [
      { "sa": "na", "en": "not" },
      { "sa": "ādatte", "en": "takes on" },
      { "sa": "kasyacit", "en": "of anyone" },
      { "sa": "pāpam", "en": "the evil" },
      { "sa": "na", "en": "not" },
      { "sa": "ca", "en": "and" },
      { "sa": "eva", "en": "indeed" },
      { "sa": "sukṛtam", "en": "the good deed" },
      { "sa": "vibhuḥ", "en": "the all-pervading one" },
      { "sa": "ajñānena", "en": "by ignorance" },
      { "sa": "āvṛtam", "en": "covered" },
      { "sa": "jñānam", "en": "knowledge" },
      { "sa": "tena", "en": "by that" },
      { "sa": "muhyanti", "en": "are deluded" },
      { "sa": "jantavaḥ", "en": "creatures" }
    ],
    "translation": "The all-pervading one does not take on the evil of anyone, and indeed not the good deed. Knowledge is covered by ignorance. By that, creatures are deluded."
  },
  "16": {
    "words": [
      { "sa": "jñānena", "en": "by knowledge" },
      { "sa": "tu", "en": "but" },
      { "sa": "tat", "en": "that" },
      { "sa": "ajñānam", "en": "ignorance" },
      { "sa": "yeṣām", "en": "of whom" },
      { "sa": "nāśitam", "en": "destroyed" },
      { "sa": "ātmanaḥ", "en": "of the self", "term": "atman" },
      { "sa": "teṣām", "en": "of them" },
      { "sa": "āditya-vat", "en": "like the sun" },
      { "sa": "jñānam", "en": "knowledge" },
      { "sa": "prakāśayati", "en": "lights up" },
      { "sa": "tat", "en": "that" },
      { "sa": "param", "en": "supreme" }
    ],
    "translation": "But for those whose ignorance is destroyed by knowledge of the self, their knowledge, like the sun, lights up that supreme.",
    "notes": ["\"Whose ignorance is destroyed by knowledge of the self\" can also be read as \"whose ignorance of the self is destroyed by knowledge\"."]
  },
  "17": {
    "words": [
      { "sa": "tat-buddhayaḥ", "en": "whose buddhi is in that", "term": "buddhi" },
      { "sa": "tat-ātmānaḥ", "en": "whose self is that", "term": "atman" },
      { "sa": "tat-niṣṭhāḥ", "en": "whose foundation is that" },
      { "sa": "tat-parāyaṇāḥ", "en": "whose highest goal is that" },
      { "sa": "gacchanti", "en": "they go" },
      { "sa": "apunar-āvṛttim", "en": "to no return" },
      { "sa": "jñāna-nirdhūta-kalmaṣāḥ", "en": "whose stains are shaken off by knowledge" }
    ],
    "translation": "Those whose buddhi is in that, whose self is that, whose foundation is that, whose highest goal is that, whose stains are shaken off by knowledge, go to no return."
  },
  "18": {
    "words": [
      { "sa": "vidyā-vinaya-sampanne", "en": "endowed with learning and humility" },
      { "sa": "brāhmaṇe", "en": "in a brāhmaṇa" },
      { "sa": "gavi", "en": "in a cow" },
      { "sa": "hastini", "en": "in an elephant" },
      { "sa": "śuni", "en": "in a dog" },
      { "sa": "ca", "en": "and" },
      { "sa": "eva", "en": "even" },
      { "sa": "śva-pāke", "en": "in one who cooks dogs" },
      { "sa": "ca", "en": "and" },
      { "sa": "paṇḍitāḥ", "en": "the learned" },
      { "sa": "sama-darśinaḥ", "en": "seeing the same", "term": "samatva" }
    ],
    "translation": "In a brāhmaṇa endowed with learning and humility, in a cow, in an elephant, and even in a dog and in one who cooks dogs, the learned see the same."
  },
  "19": {
    "words": [
      { "sa": "iha", "en": "here" },
      { "sa": "eva", "en": "right" },
      { "sa": "taiḥ", "en": "by them" },
      { "sa": "jitaḥ", "en": "conquered" },
      { "sa": "sargaḥ", "en": "creation" },
      { "sa": "yeṣām", "en": "of whom" },
      { "sa": "sāmye", "en": "in sameness", "term": "samatva" },
      { "sa": "sthitam", "en": "standing" },
      { "sa": "manaḥ", "en": "the mind", "term": "manas" },
      { "sa": "nirdoṣam", "en": "flawless" },
      { "sa": "hi", "en": "for" },
      { "sa": "samam", "en": "the same", "term": "samatva" },
      { "sa": "brahma", "en": "brahman", "term": "brahman" },
      { "sa": "tasmāt", "en": "therefore" },
      { "sa": "brahmaṇi", "en": "in brahman", "term": "brahman" },
      { "sa": "te", "en": "they" },
      { "sa": "sthitāḥ", "en": "standing" }
    ],
    "translation": "Right here creation is conquered by those whose mind stands in sameness. For brahman is flawless and the same. Therefore they stand in brahman.",
    "notes": ["\"Creation\" can also be read as \"birth\", meaning the round of being born again."]
  },
  "20": {
    "words": [
      { "sa": "na", "en": "not" },
      { "sa": "prahṛṣyet", "en": "one should rejoice" },
      { "sa": "priyam", "en": "the pleasant" },
      { "sa": "prāpya", "en": "having got" },
      { "sa": "na", "en": "not" },
      { "sa": "udvijet", "en": "one should shudder" },
      { "sa": "prāpya", "en": "having got" },
      { "sa": "ca", "en": "and" },
      { "sa": "apriyam", "en": "the unpleasant" },
      { "sa": "sthira-buddhiḥ", "en": "whose buddhi is steady", "term": "buddhi" },
      { "sa": "asammūḍhaḥ", "en": "undeluded" },
      { "sa": "brahma-vit", "en": "the knower of brahman", "term": "brahman" },
      { "sa": "brahmaṇi", "en": "in brahman", "term": "brahman" },
      { "sa": "sthitaḥ", "en": "standing" }
    ],
    "translation": "One should not rejoice having got the pleasant, and one should not shudder having got the unpleasant. The knower of brahman, whose buddhi is steady, undeluded, stands in brahman."
  },
  "21": {
    "words": [
      { "sa": "bāhya-sparśeṣu", "en": "to outer contacts" },
      { "sa": "asakta-ātmā", "en": "whose self is unattached", "term": "atman" },
      { "sa": "vindati", "en": "finds" },
      { "sa": "ātmani", "en": "in the self", "term": "atman" },
      { "sa": "yat", "en": "which" },
      { "sa": "sukham", "en": "happiness" },
      { "sa": "saḥ", "en": "he" },
      { "sa": "brahma-yoga-yukta-ātmā", "en": "whose self is yoked by the yoga of brahman", "term": "yoga" },
      { "sa": "sukham", "en": "happiness" },
      { "sa": "akṣayam", "en": "undecaying" },
      { "sa": "aśnute", "en": "attains" }
    ],
    "translation": "One whose self is unattached to outer contacts finds the happiness which is in the self. He, whose self is yoked by the yoga of brahman, attains undecaying happiness.",
    "notes": ["\"Whose self is yoked by the yoga of brahman\" can also be read as \"whose self is yoked to brahman by yoga\"."]
  },
  "22": {
    "words": [
      { "sa": "ye", "en": "which" },
      { "sa": "hi", "en": "for" },
      { "sa": "saṁsparśa-jāḥ", "en": "born of contact" },
      { "sa": "bhogāḥ", "en": "enjoyments" },
      { "sa": "duḥkha-yonayaḥ", "en": "wombs of pain" },
      { "sa": "eva", "en": "only" },
      { "sa": "te", "en": "they" },
      { "sa": "ādi-anta-vantaḥ", "en": "having a beginning and an end" },
      { "sa": "kaunteya", "en": "O son of Kuntī" },
      { "sa": "na", "en": "not" },
      { "sa": "teṣu", "en": "in them" },
      { "sa": "ramate", "en": "delights" },
      { "sa": "budhaḥ", "en": "the wise one" }

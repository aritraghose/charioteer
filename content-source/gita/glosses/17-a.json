{
  "1": {
    "words": [
      { "sa": "ye", "en": "those who" },
      { "sa": "śāstra-vidhim", "en": "the rule of scripture" },
      { "sa": "utsṛjya", "en": "having set aside" },
      { "sa": "yajante", "en": "they sacrifice" },
      { "sa": "śraddhayā", "en": "with faith" },
      { "sa": "anvitāḥ", "en": "endowed" },
      { "sa": "teṣām", "en": "of them" },
      { "sa": "niṣṭhā", "en": "standing" },
      { "sa": "tu", "en": "indeed" },
      { "sa": "kā", "en": "what" },
      { "sa": "kṛṣṇa", "en": "O Kṛṣṇa" },
      { "sa": "sattvam", "en": "sattva", "term": "guna" },
      { "sa": "āho", "en": "or" },
      { "sa": "rajaḥ", "en": "rajas", "term": "guna" },
      { "sa": "tamaḥ", "en": "tamas", "term": "guna" }
    ],
    "translation": "Those who, having set aside the rule of scripture, sacrifice endowed with faith: what indeed is their standing, O Kṛṣṇa? Is it sattva, or rajas, or tamas?"
  },
  "2": {
    "words": [
      { "sa": "tri-vidhā", "en": "of three kinds" },
      { "sa": "bhavati", "en": "is" },
      { "sa": "śraddhā", "en": "faith" },
      { "sa": "dehinām", "en": "of the embodied ones", "term": "dehin" },
      { "sa": "sā", "en": "it" },
      { "sa": "svabhāva-jā", "en": "born of their own nature" },
      { "sa": "sāttvikī", "en": "of sattva", "term": "guna" },
      { "sa": "rājasī", "en": "of rajas", "term": "guna" },
      { "sa": "ca", "en": "and" },
      { "sa": "eva", "en": "indeed" },
      { "sa": "tāmasī", "en": "of tamas", "term": "guna" },
      { "sa": "ca", "en": "and" },
      { "sa": "iti", "en": "thus" },
      { "sa": "tām", "en": "of it" },
      { "sa": "śṛṇu", "en": "hear" }
    ],
    "translation": "The faith of the embodied ones is of three kinds. It is born of their own nature: of sattva, and indeed of rajas, and of tamas. Hear of it thus."
  },
  "3": {
    "words": [
      { "sa": "sattva-anurūpā", "en": "in keeping with his nature", "term": "guna" },
      { "sa": "sarvasya", "en": "of everyone" },
      { "sa": "śraddhā", "en": "faith" },
      { "sa": "bhavati", "en": "is" },
      { "sa": "bhārata", "en": "O descendant of Bharata" },
      { "sa": "śraddhā-mayaḥ", "en": "made of faith" },
      { "sa": "ayam", "en": "this" },
      { "sa": "puruṣaḥ", "en": "person" },
      { "sa": "yaḥ", "en": "who" },
      { "sa": "yat-śraddhaḥ", "en": "having whatever faith" },
      { "sa": "saḥ", "en": "that" },
      { "sa": "eva", "en": "indeed" },
      { "sa": "saḥ", "en": "he" }
    ],
    "translation": "The faith of everyone is in keeping with his nature, O descendant of Bharata. This person is made of faith. Whatever faith one has, that indeed he is.",
    "notes": ["\"In keeping with his nature\" can also be read as \"in keeping with his mind\", or as \"in keeping with the sattva in him\"."]
  },
  "4": {
    "words": [
      { "sa": "yajante", "en": "they worship" },
      { "sa": "sāttvikāḥ", "en": "those of sattva", "term": "guna" },
      { "sa": "devān", "en": "the gods" },
      { "sa": "yakṣa-rakṣāṁsi", "en": "the yakṣas and rākṣasas" },
      { "sa": "rājasāḥ", "en": "those of rajas", "term": "guna" },
      { "sa": "pretān", "en": "the departed" },
      { "sa": "bhūta-gaṇān", "en": "the hosts of spirits" },
      { "sa": "ca", "en": "and" },
      { "sa": "anye", "en": "the others" },
      { "sa": "yajante", "en": "they worship" },
      { "sa": "tāmasāḥ", "en": "of tamas", "term": "guna" },
      { "sa": "janāḥ", "en": "people" }
    ],
    "translation": "Those of sattva worship the gods, those of rajas the yakṣas and rākṣasas. The others, the people of tamas, worship the departed and the hosts of spirits."
  },
  "5": {
    "words": [
      { "sa": "aśāstra-vihitam", "en": "not ordained by scripture" },
      { "sa": "ghoram", "en": "fierce" },
      { "sa": "tapyante", "en": "they practise" },
      { "sa": "ye", "en": "who" },
      { "sa": "tapaḥ", "en": "austerity" },
      { "sa": "janāḥ", "en": "people" },
      { "sa": "dambha-ahaṅkāra-saṁyuktāḥ", "en": "joined to hypocrisy and ego" },
      { "sa": "kāma-rāga-bala-anvitāḥ", "en": "endowed with the force of desire and passion", "term": "kama" }
    ],
    "translation": "The people who practise fierce austerity not ordained by scripture, joined to hypocrisy and ego, endowed with the force of desire and passion,",
    "notes": [
      "Verses 5 to 6 are one sentence in the Sanskrit.",
      "\"Endowed with the force of desire and passion\" can also be read as \"endowed with desire, passion and force\"."
    ]
  },
  "6": {
    "words": [
      { "sa": "karṣayantaḥ", "en": "tormenting" },
      { "sa": "śarīra-stham", "en": "standing in the body" },
      { "sa": "bhūta-grāmam", "en": "the group of elements" },
      { "sa": "acetasaḥ", "en": "senseless" },
      { "sa": "mām", "en": "me" },
      { "sa": "ca", "en": "and" },
      { "sa": "eva", "en": "also" },
      { "sa": "antaḥ-śarīra-stham", "en": "standing within the body" },
      { "sa": "tān", "en": "them" },
      { "sa": "viddhi", "en": "know" },
      { "sa": "āsura-niścayān", "en": "of demonic resolve" }
    ],
    "translation": "senseless, tormenting the group of elements standing in the body, and also me standing within the body: know them to be of demonic resolve."
  },
  "7": {
    "words": [
      { "sa": "āhāraḥ", "en": "food" },
      { "sa": "tu", "en": "but" },
      { "sa": "api", "en": "also" },
      { "sa": "sarvasya", "en": "of everyone" },
      { "sa": "tri-vidhaḥ", "en": "of three kinds" },
      { "sa": "bhavati", "en": "is" },
      { "sa": "priyaḥ", "en": "dear" },
      { "sa": "yajñaḥ", "en": "sacrifice" },
      { "sa": "tapaḥ", "en": "austerity" },
      { "sa": "tathā", "en": "likewise" },
      { "sa": "dānam", "en": "giving" },
      { "sa": "teṣām", "en": "of them" },
      { "sa": "bhedam", "en": "the distinction" },
      { "sa": "imam", "en": "this" },
      { "sa": "śṛṇu", "en": "hear" }
    ],
    "translation": "But the food also that is dear to everyone is of three kinds, and likewise sacrifice, austerity and giving. Hear this distinction of them."
  },
  "8": {
    "words": [
      { "sa": "āyuḥ-sattva-bala-ārogya-sukha-prīti-vivardhanāḥ", "en": "increasing life, vitality, strength, health, happiness and delight" },
      { "sa": "rasyāḥ", "en": "juicy" },
      { "sa": "snigdhāḥ", "en": "oily" },
      { "sa": "sthirāḥ", "en": "firm" },
      { "sa": "hṛdyāḥ", "en": "pleasing to the heart" },
      { "sa": "āhārāḥ", "en": "foods" },
      { "sa": "sāttvika-priyāḥ", "en": "dear to one of sattva", "term": "guna" }
    ],
    "translation": "Foods that increase life, vitality, strength, health, happiness and delight, that are juicy, oily, firm and pleasing to the heart, are dear to one of sattva.",
    "notes": ["\"Firm\" can also be read as \"lasting\", that is, food that sustains for a long time."]
  },
  "9": {
    "words": [
      { "sa": "kaṭu-amla-lavaṇa-ati-uṣṇa-tīkṣṇa-rūkṣa-vidāhinaḥ", "en": "pungent, sour, salty, very hot, sharp, dry and burning" },
      { "sa": "āhārāḥ", "en": "foods" },
      { "sa": "rājasasya", "en": "of one of rajas", "term": "guna" },
      { "sa": "iṣṭāḥ", "en": "wished for" },
      { "sa": "duḥkha-śoka-āmaya-pradāḥ", "en": "giving pain, grief and sickness" }
    ],
    "translation": "Foods that are pungent, sour, salty, very hot, sharp, dry and burning are wished for by one of rajas. They give pain, grief and sickness."
  },
  "10": {
    "words": [
      { "sa": "yāta-yāmam", "en": "stale" },
      { "sa": "gata-rasam", "en": "with its taste gone" },
      { "sa": "pūti", "en": "putrid" },
      { "sa": "paryuṣitam", "en": "left overnight" },
      { "sa": "ca", "en": "and" },
      { "sa": "yat", "en": "which" },
      { "sa": "ucchiṣṭam", "en": "left over by others" },
      { "sa": "api", "en": "also" },
      { "sa": "ca", "en": "and" },
      { "sa": "amedhyam", "en": "unfit for offering" },
      { "sa": "bhojanam", "en": "food" },
      { "sa": "tāmasa-priyam", "en": "dear to one of tamas", "term": "guna" }
    ],
    "translation": "Food which is stale, with its taste gone, putrid and left overnight, and also left over by others and unfit for offering, is dear to one of tamas."
  },
  "11": {
    "words": [
      { "sa": "aphala-ākāṅkṣibhiḥ", "en": "by those not longing for fruit" },
      { "sa": "yajñaḥ", "en": "sacrifice" },
      { "sa": "vidhi-dṛṣṭaḥ", "en": "seen in the rule" },
      { "sa": "yaḥ", "en": "which" },
      { "sa": "ijyate", "en": "is offered" },
      { "sa": "yaṣṭavyam", "en": "it is to be offered" },
      { "sa": "eva", "en": "simply" },
      { "sa": "iti", "en": "thus" },
      { "sa": "manaḥ", "en": "the mind", "term": "manas" },
      { "sa": "samādhāya", "en": "having settled", "term": "samadhi" },
      { "sa": "saḥ", "en": "that" },
      { "sa": "sāttvikaḥ", "en": "of sattva", "term": "guna" }
    ],
    "translation": "The sacrifice seen in the rule, which is offered by those not longing for fruit, having settled the mind thus: 'it is simply to be offered', that is of sattva."
  },
  "12": {
    "words": [
      { "sa": "abhisandhāya", "en": "having aimed at" },
      { "sa": "tu", "en": "but" },
      { "sa": "phalam", "en": "fruit" },
      { "sa": "dambha-artham", "en": "for the sake of show" },
      { "sa": "api", "en": "also" },
      { "sa": "ca", "en": "and" },
      { "sa": "eva", "en": "indeed" },
      { "sa": "yat", "en": "which" },
      { "sa": "ijyate", "en": "is offered" },
      { "sa": "bharata-śreṣṭha", "en": "O best of the Bharatas" },
      { "sa": "tam", "en": "that" },
      { "sa": "yajñam", "en": "sacrifice" },
      { "sa": "viddhi", "en": "know" },
      { "sa": "rājasam", "en": "of rajas", "term": "guna" }
    ],
    "translation": "But that which is offered having aimed at fruit, and indeed also for the sake of show, O best of the Bharatas, know that sacrifice to be of rajas."
  },
  "13": {
    "words": [
      { "sa": "vidhi-hīnam", "en": "lacking the rule" },
      { "sa": "asṛṣṭa-annam", "en": "with no food given out" },
      { "sa": "mantra-hīnam", "en": "lacking the sacred words" },
      { "sa": "adakṣiṇam", "en": "without the gift to the priest" },
      { "sa": "śraddhā-virahitam", "en": "devoid of faith" },
      { "sa": "yajñam", "en": "sacrifice" },
      { "sa": "tāmasam", "en": "of tamas", "term": "guna" },
      { "sa": "paricakṣate", "en": "they declare" }
    ],
    "translation": "A sacrifice lacking the rule, with no food given out, lacking the sacred words, without the gift to the priest, devoid of faith, they declare to be of tamas."
  },
  "14": {
    "words": [
      { "sa": "deva-dvija-guru-prājña-pūjanam", "en": "honouring of the gods, the twice-born, the teachers and the wise", "term": "prajna" },
      { "sa": "śaucam", "en": "purity" },
      { "sa": "ārjavam", "en": "straightness" },
      { "sa": "brahmacaryam", "en": "celibacy" },
      { "sa": "ahiṁsā", "en": "non-harming" },
      { "sa": "ca", "en": "and" },
      { "sa": "śārīram", "en": "of the body" },
      { "sa": "tapaḥ", "en": "austerity" },
      { "sa": "ucyate", "en": "is called" }
    ],
    "translation": "Honouring of the gods, the twice-born, the teachers and the wise, purity, straightness, celibacy and non-harming are called austerity of the body."
  },
  "15": {
    "words": [
      { "sa": "anudvega-karam", "en": "causing no agitation" },
      { "sa": "vākyam", "en": "speech" },
      { "sa": "satyam", "en": "true" },
      { "sa": "priya-hitam", "en": "pleasant and beneficial" },
      { "sa": "ca", "en": "and" },
      { "sa": "yat", "en": "which" },
      { "sa": "svādhyāya-abhyasanam", "en": "the practice of one's own recitation", "term": "abhyasa" },
      { "sa": "ca", "en": "and" },
      { "sa": "eva", "en": "also" },
      { "sa": "vāk-mayam", "en": "made of speech" },
      { "sa": "tapaḥ", "en": "austerity" },
      { "sa": "ucyate", "en": "is called" }
    ],
    "translation": "Speech which causes no agitation, which is true, pleasant and beneficial, and also the practice of one's own recitation, are called austerity made of speech."
  },
  "16": {
    "words": [
      { "sa": "manaḥ-prasādaḥ", "en": "calmness of mind", "term": "manas" },
      { "sa": "saumyatvam", "en": "gentleness" },
      { "sa": "maunam", "en": "silence" },
      { "sa": "ātma-vinigrahaḥ", "en": "restraint of the self", "term": "atman" },
      { "sa": "bhāva-saṁśuddhiḥ", "en": "purity of feeling" },
      { "sa": "iti", "en": "thus" },
      { "sa": "etat", "en": "this" },
      { "sa": "tapaḥ", "en": "austerity" },
      { "sa": "mānasam", "en": "of the mind", "term": "manas" },
      { "sa": "ucyate", "en": "is called" }
    ],
    "translation": "Calmness of mind, gentleness, silence, restraint of the self, purity of feeling: this is called austerity of the mind."
  },
  "17": {
    "words": [
      { "sa": "śraddhayā", "en": "with faith" },
      { "sa": "parayā", "en": "supreme" },
      { "sa": "taptam", "en": "practised" },
      { "sa": "tapaḥ", "en": "austerity" },
      { "sa": "tat", "en": "that" },
      { "sa": "tri-vidham", "en": "threefold" },
      { "sa": "naraiḥ", "en": "by men" },
      { "sa": "aphala-ākāṅkṣibhiḥ", "en": "by those not longing for fruit" },
      { "sa": "yuktaiḥ", "en": "by the yoked", "term": "yoga" },
      { "sa": "sāttvikam", "en": "of sattva", "term": "guna" },
      { "sa": "paricakṣate", "en": "they declare" }
    ],
    "translation": "That threefold austerity, practised with supreme faith by men who are yoked and not longing for fruit, they declare to be of sattva."
  },
  "18": {
    "words": [
      { "sa": "satkāra-māna-pūjā-artham", "en": "for the sake of good treatment, respect and honour" },
      { "sa": "tapaḥ", "en": "austerity" },
      { "sa": "dambhena", "en": "with hypocrisy" },
      { "sa": "ca", "en": "and" },
      { "sa": "eva", "en": "indeed" },
      { "sa": "yat", "en": "which" },
      { "sa": "kriyate", "en": "is done" },
      { "sa": "tat", "en": "that" },
      { "sa": "iha", "en": "here" },
      { "sa": "proktam", "en": "is said" },
      { "sa": "rājasam", "en": "of rajas", "term": "guna" },
      { "sa": "calam", "en": "moving" },
      { "sa": "adhruvam", "en": "unlasting" }
    ],
    "translation": "The austerity which is done for the sake of good treatment, respect and honour, and indeed with hypocrisy, that is here said to be of rajas, moving and unlasting."
  },
  "19": {
    "words": [
      { "sa": "mūḍha-grāheṇa", "en": "with a deluded grasp" },
      { "sa": "ātmanaḥ", "en": "of the self", "term": "atman" },
      { "sa": "yat", "en": "which" },
      { "sa": "pīḍayā", "en": "with torment" },
      { "sa": "kriyate", "en": "is done" },
      { "sa": "tapaḥ", "en": "austerity" },
      { "sa": "parasya", "en": "of another" },
      { "sa": "utsādana-artham", "en": "for the sake of destroying" },
      { "sa": "vā", "en": "or" },
      { "sa": "tat", "en": "that" },
      { "sa": "tāmasam", "en": "of tamas", "term": "guna" },
      { "sa": "udāhṛtam", "en": "is declared" }
    ],
    "translation": "The austerity which is done with a deluded grasp, with torment of the self, or for the sake of destroying another, that is declared to be of tamas.",
    "notes": ["\"With torment of the self\" can also be read as \"with torment of oneself\", that is, of one's own body."]
  },
  "20": {
    "words": [
      { "sa": "dātavyam", "en": "it is to be given" },
      { "sa": "iti", "en": "thus" },
      { "sa": "yat", "en": "which" },
      { "sa": "dānam", "en": "gift" },
      { "sa": "dīyate", "en": "is given" },
      { "sa": "anupakāriṇe", "en": "to one who does no favour in return" },
      { "sa": "deśe", "en": "in the proper place" },
      { "sa": "kāle", "en": "at the proper time" },
      { "sa": "ca", "en": "and" },
      { "sa": "pātre", "en": "to a worthy receiver" },
      { "sa": "ca", "en": "and" },
      { "sa": "tat", "en": "that" },
      { "sa": "dānam", "en": "gift" },
      { "sa": "sāttvikam", "en": "of sattva", "term": "guna" },
      { "sa": "smṛtam", "en": "is remembered" }
    ],
    "translation": "The gift which is given thus: 'it is to be given', to one who does no favour in return, in the proper place and at the proper time and to a worthy receiver, that gift is remembered as of sattva.",
    "notes": ["\"To one who does no favour in return\" can also be read as \"to one who has done no favour before\"."]
  },
  "21": {
    "words": [
      { "sa": "yat", "en": "which" },
      { "sa": "tu", "en": "but" },
      { "sa": "prati-upakāra-artham", "en": "for the sake of a favour in return" },
      { "sa": "phalam", "en": "fruit" },
      { "sa": "uddiśya", "en": "having aimed at" },
      { "sa": "vā", "en": "or" },
      { "sa": "punaḥ", "en": "again" },
      { "sa": "dīyate", "en": "is given" },
      { "sa": "ca", "en": "and" },
      { "sa": "parikliṣṭam", "en": "grudgingly" },
      { "sa": "tat", "en": "that" },
      { "sa": "dānam", "en": "gift" },
      { "sa": "rājasam", "en": "of rajas", "term": "guna" },
      { "sa": "smṛtam", "en": "is remembered" }
    ],
    "translation": "But that which is given for the sake of a favour in return, or again having aimed at fruit, and is given grudgingly, that gift is remembered as of rajas."
  },
  "22": {
    "words": [
      { "sa": "adeśa-kāle", "en": "at the wrong place and time" },
      { "sa": "yat", "en": "which" },
      { "sa": "dānam", "en": "gift" },
      { "sa": "apātrebhyaḥ", "en": "to unworthy receivers" },
      { "sa": "ca", "en": "and" },
      { "sa": "dīyate", "en": "is given" },
      { "sa": "asat-kṛtam", "en": "without good treatment" },
      { "sa": "avajñātam", "en": "with contempt" },
      { "sa": "tat", "en": "that" },
      { "sa": "tāmasam", "en": "of tamas", "term": "guna" },
      { "sa": "udāhṛtam", "en": "is declared" }
    ],
    "translation": "The gift which is given at the wrong place and time and to unworthy receivers, without good treatment, with contempt, that is declared to be of tamas."
  },
  "23": {
    "words": [
      { "sa": "oṁ", "en": "oṁ" },
      { "sa": "tat", "en": "tat, \"that\"" },
      { "sa": "sat", "en": "sat, \"real, good\"" },
      { "sa": "iti", "en": "thus" },
      { "sa": "nirdeśaḥ", "en": "the designation" },
      { "sa": "brahmaṇaḥ", "en": "of brahman", "term": "brahman" },
      { "sa": "tri-vidhaḥ", "en": "threefold" },
      { "sa": "smṛtaḥ", "en": "is remembered" },
      { "sa": "brāhmaṇāḥ", "en": "the brahmins" },
      { "sa": "tena", "en": "by it" },
      { "sa": "vedāḥ", "en": "the Vedas" },
      { "sa": "ca", "en": "and" },
      { "sa": "yajñāḥ", "en": "the sacrifices" },
      { "sa": "ca", "en": "and" },
      { "sa": "vihitāḥ", "en": "were ordained" },
      { "sa": "purā", "en": "of old" }
    ],
    "translation": "'Oṁ, tat, sat': thus the threefold designation of brahman is remembered. By it the brahmins and the Vedas and the sacrifices were ordained of old.",
    "notes": ["\"The brahmins\" can also be read as \"the Brāhmaṇas\", the ritual texts attached to the Vedas."]
  },
  "24": {
    "words": [
      { "sa": "tasmāt", "en": "therefore" },
      { "sa": "oṁ", "en": "oṁ" },

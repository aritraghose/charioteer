      { "sa": "akṣaraḥ", "en": "the imperishable" },
      { "sa": "iti", "en": "thus" },
      { "sa": "uktaḥ", "en": "it is called" },
      { "sa": "tam", "en": "it" },
      { "sa": "āhuḥ", "en": "they call" },
      { "sa": "paramām", "en": "the highest" },
      { "sa": "gatim", "en": "goal" },
      { "sa": "yam", "en": "which" },
      { "sa": "prāpya", "en": "having reached" },
      { "sa": "na", "en": "not" },
      { "sa": "nivartante", "en": "they return" },
      { "sa": "tat", "en": "that" },
      { "sa": "dhāma", "en": "abode" },
      { "sa": "paramam", "en": "highest" },
      { "sa": "mama", "en": "my" }

      { "sa": "kalevaram", "en": "the body" },
      { "sa": "yaḥ", "en": "who" },
      { "sa": "prayāti", "en": "departs" },
      { "sa": "saḥ", "en": "he" },
      { "sa": "mad-bhāvam", "en": "to my state of being" },
      { "sa": "yāti", "en": "goes" },
      { "sa": "na", "en": "not" },
      { "sa": "asti", "en": "there is" },
      { "sa": "atra", "en": "here" },
      { "sa": "saṁśayaḥ", "en": "doubt" }
    ],
    "translation": "And he who departs at the time of the end, remembering me alone, having let go of the body, goes to my state of being. There is no doubt here."
  },
  "6": {
    "words": [

      { "sa": "saḥ", "en": "that" },
      { "sa": "paraḥ", "en": "highest" },
      { "sa": "pārtha", "en": "O son of Pṛthā" },
      { "sa": "bhaktyā", "en": "by devotion" },
      { "sa": "labhyaḥ", "en": "to be gained" },
      { "sa": "tu", "en": "but" },
      { "sa": "ananyayā", "en": "to no other" },
      { "sa": "yasya", "en": "of whom" },
      { "sa": "antaḥ-sthāni", "en": "standing within" },
      { "sa": "bhūtāni", "en": "beings" },
      { "sa": "yena", "en": "by whom" },
      { "sa": "sarvam", "en": "all" },
      { "sa": "idam", "en": "this" },
      { "sa": "tatam", "en": "spread out" }
    ],
    "translation": "But that highest person, O son of Pṛthā, within whom beings stand and by whom all this is spread out, is to be gained by devotion to no other."
  },
  "23": {

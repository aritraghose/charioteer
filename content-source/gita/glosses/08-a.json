      { "sa": "cetasā", "en": "with a mind" },
      { "sa": "na", "en": "not" },
      { "sa": "anya-gāminā", "en": "going to another" },
      { "sa": "paramam", "en": "the highest" },
      { "sa": "puruṣam", "en": "to the person" },
      { "sa": "divyam", "en": "divine" },
      { "sa": "yāti", "en": "one goes" },
      { "sa": "pārtha", "en": "O son of Pṛthā" },
      { "sa": "anucintayan", "en": "thinking on" }
    ],
    "translation": "With a mind yoked by the yoga of practice, not going to another, one goes to the highest divine person, O son of Pṛthā, thinking on him."
  },
  "9": {
    "words": [

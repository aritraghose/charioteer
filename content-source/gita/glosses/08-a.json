      { "sa": "kalevaram", "en": "the body" },
      { "sa": "tam", "en": "to that" },
      { "sa": "tam", "en": "to that" },
      { "sa": "eva", "en": "very" },
      { "sa": "eti", "en": "one goes" },
      { "sa": "kaunteya", "en": "O son of Kuntī" },
      { "sa": "sadā", "en": "always" },
      { "sa": "tad-bhāva-bhāvitaḥ", "en": "made to become that state of being" }
    ],
    "translation": "Or also, whichever state of being one remembers when one gives up the body at the end, to that very one one goes, O son of Kuntī, always made to become that state of being."
  },
  "7": {
    "words": [
      { "sa": "tasmāt", "en": "therefore" },
      { "sa": "sarveṣu", "en": "at all" },
      { "sa": "kāleṣu", "en": "at times" },
      { "sa": "mām", "en": "me" },
      { "sa": "anusmara", "en": "remember" },
      { "sa": "yudhya", "en": "fight" },
      { "sa": "ca", "en": "and" },
      { "sa": "mayi", "en": "on me" },
      { "sa": "arpita-manaḥ-buddhiḥ", "en": "with mind and buddhi fixed", "term": "manas" },
      { "sa": "mām", "en": "to me" },
      { "sa": "eva", "en": "alone" },
      { "sa": "eṣyasi", "en": "you will come" },
      { "sa": "asaṁśayaḥ", "en": "without doubt" }
    ],
    "translation": "Therefore at all times remember me and fight. With mind and buddhi fixed on me, you will come to me alone, without doubt.",
    "notes": ["\"Without doubt\" can be read either as \"it is certain that you will come\" or as \"you, being free of doubt, will come\"."]
  },
  "8": {
    "words": [

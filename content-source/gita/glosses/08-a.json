    "notes": ["\"The brahman of one syllable\" can also be read as \"the one imperishable brahman\"."]
  },
  "14": {
    "words": [
      { "sa": "ananya-cetāḥ", "en": "with a mind on no other" },
      { "sa": "satatam", "en": "continually" },
      { "sa": "yaḥ", "en": "who" },
      { "sa": "mām", "en": "me" },
      { "sa": "smarati", "en": "remembers" },
      { "sa": "nityaśaḥ", "en": "always" },
      { "sa": "tasya", "en": "for him" },
      { "sa": "aham", "en": "I" },
      { "sa": "sulabhaḥ", "en": "easy to reach" },
      { "sa": "pārtha", "en": "O son of Pṛthā" },
      { "sa": "nitya-yuktasya", "en": "for the ever-yoked", "term": "yoga" },
      { "sa": "yoginaḥ", "en": "for the yogī", "term": "yoga" }
    ],
    "translation": "He who, with a mind on no other, continually and always remembers me: for him, the ever-yoked yogī, I am easy to reach, O son of Pṛthā."
  },
  "15": {
    "words": [

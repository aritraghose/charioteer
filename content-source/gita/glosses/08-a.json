      { "sa": "yatayaḥ", "en": "strivers" },
      { "sa": "vīta-rāgāḥ", "en": "whose passion is gone" },
      { "sa": "yat", "en": "which" },
      { "sa": "icchantaḥ", "en": "desiring" },

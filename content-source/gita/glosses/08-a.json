{
  "1": {
    "words": [
      { "sa": "kim", "en": "what" },
      { "sa": "tat", "en": "that" },
      { "sa": "brahma", "en": "brahman", "term": "brahman" },
      { "sa": "kim", "en": "what" },
      { "sa": "adhyātmam", "en": "what concerns the self", "term": "atman" },
      { "sa": "kim", "en": "what" },
      { "sa": "karma", "en": "action", "term": "karma" },
      { "sa": "puruṣa-uttama", "en": "O highest of persons" },
      { "sa": "adhibhūtam", "en": "what concerns beings" },

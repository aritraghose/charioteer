      { "sa": "iti", "en": "thus" },
      { "sa": "eka-akṣaram", "en": "of one syllable" },
      { "sa": "brahma", "en": "brahman", "term": "brahman" },
      { "sa": "vyāharan", "en": "uttering" },
      { "sa": "mām", "en": "me" },
      { "sa": "anusmaran", "en": "remembering" },
      { "sa": "yaḥ", "en": "who" },
      { "sa": "prayāti", "en": "departs" },

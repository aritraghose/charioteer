      { "sa": "madhye", "en": "in the middle" },
      { "sa": "prāṇam", "en": "the breath" },
      { "sa": "āveśya", "en": "having made enter" },
      { "sa": "samyak", "en": "rightly" },
      { "sa": "saḥ", "en": "he" },
      { "sa": "tam", "en": "that" },

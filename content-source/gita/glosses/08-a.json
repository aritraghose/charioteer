      { "sa": "upetya", "en": "having come" },
      { "sa": "punar-janma", "en": "rebirth" },
      { "sa": "duḥkha-ālayam", "en": "the home of suffering" },
      { "sa": "aśāśvatam", "en": "not lasting" },
      { "sa": "na", "en": "not" },
      { "sa": "āpnuvanti", "en": "they obtain" },
      { "sa": "mahā-ātmānaḥ", "en": "those of great self", "term": "atman" },
      { "sa": "saṁsiddhim", "en": "to perfection" },
      { "sa": "paramām", "en": "highest" },
      { "sa": "gatāḥ", "en": "gone" }
    ],
    "translation": "Having come to me, those of great self, gone to the highest perfection, do not obtain rebirth, the home of suffering, which does not last."
  },
  "16": {
    "words": [

      { "sa": "mām", "en": "to me" },
      { "sa": "upetya", "en": "having come" },
      { "sa": "tu", "en": "but" },
      { "sa": "kaunteya", "en": "O son of Kuntī" },
      { "sa": "punar-janma", "en": "rebirth" },
      { "sa": "na", "en": "not" },
      { "sa": "vidyate", "en": "there is" }
    ],
    "translation": "The worlds, up to the realm of Brahmā, return again, O Arjuna. But having come to me, O son of Kuntī, there is no rebirth.",
    "notes": ["\"The worlds, up to the realm of Brahmā, return again\" can also be read as \"the worlds, up to the realm of Brahmā, are places from which one returns again\"."]
  },
  "17": {
    "words": [
      { "sa": "sahasra-yuga-paryantam", "en": "reaching to a thousand ages" },
      { "sa": "ahaḥ", "en": "the day" },
      { "sa": "yat", "en": "which" },
      { "sa": "brahmaṇaḥ", "en": "of Brahmā" },
      { "sa": "viduḥ", "en": "they know" },
      { "sa": "rātrim", "en": "the night" },
      { "sa": "yuga-sahasra-antām", "en": "ending in a thousand ages" },
      { "sa": "te", "en": "those" },
      { "sa": "ahaḥ-rātra-vidaḥ", "en": "knowers of day and night" },
      { "sa": "janāḥ", "en": "people" }
    ],
    "translation": "Those who know the day of Brahmā, which reaches to a thousand ages, and the night, ending in a thousand ages: those people are knowers of day and night."
  },
  "18": {
    "words": [
      { "sa": "avyaktāt", "en": "from the unmanifest" },
      { "sa": "vyaktayaḥ", "en": "manifest things" },
      { "sa": "sarvāḥ", "en": "all" },
      { "sa": "prabhavanti", "en": "they come forth" },
      { "sa": "ahaḥ-āgame", "en": "at the coming of the day" },
      { "sa": "rātri-āgame", "en": "at the coming of the night" },
      { "sa": "pralīyante", "en": "they dissolve" },
      { "sa": "tatra", "en": "into that" },
      { "sa": "eva", "en": "very" },
      { "sa": "avyakta-saṁjñake", "en": "into what is named the unmanifest" }
    ],
    "translation": "From the unmanifest all manifest things come forth at the coming of the day. At the coming of the night they dissolve into that very thing which is named the unmanifest."
  },
  "19": {
    "words": [
      { "sa": "bhūta-grāmaḥ", "en": "the multitude of beings" },
      { "sa": "saḥ", "en": "that" },
      { "sa": "eva", "en": "very same" },
      { "sa": "ayam", "en": "this" },
      { "sa": "bhūtvā", "en": "having come to be" },
      { "sa": "bhūtvā", "en": "having come to be" },
      { "sa": "pralīyate", "en": "it dissolves" },
      { "sa": "rātri-āgame", "en": "at the coming of the night" },
      { "sa": "avaśaḥ", "en": "without will" },
      { "sa": "pārtha", "en": "O son of Pṛthā" },
      { "sa": "prabhavati", "en": "it comes forth" },
      { "sa": "ahaḥ-āgame", "en": "at the coming of the day" }
    ],
    "translation": "This very same multitude of beings, having come to be again and again, dissolves without will at the coming of the night, O son of Pṛthā. It comes forth at the coming of the day."
  },
  "20": {
    "words": [
      { "sa": "paraḥ", "en": "higher" },
      { "sa": "tasmāt", "en": "than that" },
      { "sa": "tu", "en": "but" },
      { "sa": "bhāvaḥ", "en": "existence" },
      { "sa": "anyaḥ", "en": "another" },
      { "sa": "avyaktaḥ", "en": "unmanifest" },
      { "sa": "avyaktāt", "en": "than the unmanifest" },
      { "sa": "sanātanaḥ", "en": "eternal" },
      { "sa": "yaḥ", "en": "which" },
      { "sa": "saḥ", "en": "that" },
      { "sa": "sarveṣu", "en": "when all" },
      { "sa": "bhūteṣu", "en": "when beings" },
      { "sa": "naśyatsu", "en": "are perishing" },
      { "sa": "na", "en": "not" },
      { "sa": "vinaśyati", "en": "it perishes" }
    ],
    "translation": "But higher than that, than the unmanifest, there is another existence, unmanifest and eternal: that which does not perish when all beings are perishing."
  },

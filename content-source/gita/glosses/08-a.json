      { "sa": "manaḥ", "en": "the mind", "term": "manas" },
      { "sa": "hṛdi", "en": "in the heart" },
      { "sa": "nirudhya", "en": "having confined" },
      { "sa": "ca", "en": "and" },
      { "sa": "mūrdhni", "en": "in the head" },
      { "sa": "ādhāya", "en": "having placed" },

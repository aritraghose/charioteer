{
  "1": {
    "words": [
      { "sa": "mat-anugrahāya", "en": "for favour to me" },
      { "sa": "paramam", "en": "highest" },
      { "sa": "guhyam", "en": "secret" },
      { "sa": "adhyātma-saṁjñitam", "en": "called \"concerning the self\"", "term": "atman" },
      { "sa": "yat", "en": "which" },
      { "sa": "tvayā", "en": "by you" },
      { "sa": "uktam", "en": "spoken" },
      { "sa": "vacaḥ", "en": "word" },
      { "sa": "tena", "en": "by that" },
      { "sa": "mohaḥ", "en": "delusion" },
      { "sa": "ayam", "en": "this" },
      { "sa": "vigataḥ", "en": "gone away" },
      { "sa": "mama", "en": "of me" }
    ],
    "translation": "The word which was spoken by you for favour to me, the highest secret, called \"concerning the self\": by that, this delusion of mine has gone away."
  },
  "2": {
    "words": [
      { "sa": "bhava-apyayau", "en": "the arising and the passing away" },
      { "sa": "hi", "en": "for" },
      { "sa": "bhūtānām", "en": "of beings" },
      { "sa": "śrutau", "en": "heard" },
      { "sa": "vistaraśaḥ", "en": "in detail" },
      { "sa": "mayā", "en": "by me" },
      { "sa": "tvattaḥ", "en": "from you" },
      { "sa": "kamala-patra-akṣa", "en": "O one with eyes like lotus petals" },
      { "sa": "māhātmyam", "en": "greatness" },
      { "sa": "api", "en": "also" },
      { "sa": "ca", "en": "and" },
      { "sa": "avyayam", "en": "imperishable" }
    ],
    "translation": "For the arising and the passing away of beings have been heard by me in detail from you, O one with eyes like lotus petals, and also the imperishable greatness."
  },
  "3": {
    "words": [
      { "sa": "evam", "en": "so" },
      { "sa": "etat", "en": "this" },
      { "sa": "yathā", "en": "as" },
      { "sa": "āttha", "en": "you have said" },
      { "sa": "tvam", "en": "you" },
      { "sa": "ātmānam", "en": "your self", "term": "atman" },
      { "sa": "parama-īśvara", "en": "O highest lord" },
      { "sa": "draṣṭum", "en": "to see" },
      { "sa": "icchāmi", "en": "I wish" },
      { "sa": "te", "en": "of you" },
      { "sa": "rūpam", "en": "form" },
      { "sa": "aiśvaram", "en": "lordly" },
      { "sa": "puruṣa-uttama", "en": "O highest of persons" }
    ],
    "translation": "This is so, as you have said your self to be, O highest lord. I wish to see your lordly form, O highest of persons."
  },
  "4": {
    "words": [
      { "sa": "manyase", "en": "you think" },
      { "sa": "yadi", "en": "if" },
      { "sa": "tat", "en": "that" },
      { "sa": "śakyam", "en": "able" },
      { "sa": "mayā", "en": "by me" },
      { "sa": "draṣṭum", "en": "to be seen" },
      { "sa": "iti", "en": "thus" },
      { "sa": "prabho", "en": "O lord" },
      { "sa": "yoga-īśvara", "en": "O lord of yoga", "term": "yoga" },
      { "sa": "tataḥ", "en": "then" },
      { "sa": "me", "en": "to me" },
      { "sa": "tvam", "en": "you" },
      { "sa": "darśaya", "en": "show" },
      { "sa": "ātmānam", "en": "your self", "term": "atman" },
      { "sa": "avyayam", "en": "imperishable" }
    ],
    "translation": "If you think thus, that it is able to be seen by me, O lord, then, O lord of yoga, show to me your imperishable self."
  },
  "5": {
    "words": [
      { "sa": "paśya", "en": "see" },
      { "sa": "me", "en": "of me" },
      { "sa": "pārtha", "en": "O son of Pṛthā" },
      { "sa": "rūpāṇi", "en": "forms" },
      { "sa": "śataśaḥ", "en": "by hundreds" },
      { "sa": "atha", "en": "and then" },
      { "sa": "sahasraśaḥ", "en": "by thousands" },
      { "sa": "nānā-vidhāni", "en": "of many kinds" },
      { "sa": "divyāni", "en": "divine" },
      { "sa": "nānā-varṇa-ākṛtīni", "en": "of many colours and shapes" },
      { "sa": "ca", "en": "and" }
    ],
    "translation": "See my forms, O son of Pṛthā, by hundreds and then by thousands, of many kinds, divine, and of many colours and shapes."
  },
  "6": {
    "words": [
      { "sa": "paśya", "en": "see" },
      { "sa": "ādityān", "en": "the Ādityas" },
      { "sa": "vasūn", "en": "the Vasus" },
      { "sa": "rudrān", "en": "the Rudras" },
      { "sa": "aśvinau", "en": "the two Aśvins" },
      { "sa": "marutaḥ", "en": "the Maruts" },
      { "sa": "tathā", "en": "and also" },
      { "sa": "bahūni", "en": "many" },
      { "sa": "adṛṣṭa-pūrvāṇi", "en": "not seen before" },
      { "sa": "paśya", "en": "see" },
      { "sa": "āścaryāṇi", "en": "wonders" },
      { "sa": "bhārata", "en": "O descendant of Bharata" }
    ],
    "translation": "See the Ādityas, the Vasus, the Rudras, the two Aśvins and also the Maruts. See many wonders not seen before, O descendant of Bharata."
  },
  "7": {
    "words": [
      { "sa": "iha", "en": "here" },
      { "sa": "eka-stham", "en": "standing in one place" },
      { "sa": "jagat", "en": "the world" },
      { "sa": "kṛtsnam", "en": "whole" },
      { "sa": "paśya", "en": "see" },
      { "sa": "adya", "en": "today" },
      { "sa": "sa-cara-acaram", "en": "with the moving and the unmoving" },
      { "sa": "mama", "en": "of me" },
      { "sa": "dehe", "en": "in the body" },
      { "sa": "guḍākeśa", "en": "O Guḍākeśa" },
      { "sa": "yat", "en": "whatever" },
      { "sa": "ca", "en": "and" },
      { "sa": "anyat", "en": "else" },
      { "sa": "draṣṭum", "en": "to see" },
      { "sa": "icchasi", "en": "you wish" }
    ],
    "translation": "See today the whole world, with the moving and the unmoving, standing in one place here in my body, O Guḍākeśa, and whatever else you wish to see."
  },
  "8": {
    "words": [
      { "sa": "na", "en": "not" },
      { "sa": "tu", "en": "but" },
      { "sa": "mām", "en": "me" },
      { "sa": "śakyase", "en": "you are able" },
      { "sa": "draṣṭum", "en": "to see" },
      { "sa": "anena", "en": "with this" },
      { "sa": "eva", "en": "only" },
      { "sa": "sva-cakṣuṣā", "en": "with your own eye" },
      { "sa": "divyam", "en": "divine" },
      { "sa": "dadāmi", "en": "I give" },
      { "sa": "te", "en": "to you" },
      { "sa": "cakṣuḥ", "en": "an eye" },
      { "sa": "paśya", "en": "see" },
      { "sa": "me", "en": "of me" },
      { "sa": "yogam", "en": "yoga", "term": "yoga" },
      { "sa": "aiśvaram", "en": "lordly" }
    ],
    "translation": "But you are not able to see me with only this, your own eye. I give to you a divine eye. See my lordly yoga."
  },
  "9": {
    "words": [
      { "sa": "evam", "en": "thus" },
      { "sa": "uktvā", "en": "having spoken" },
      { "sa": "tataḥ", "en": "then" },
      { "sa": "rājan", "en": "O king" },
      { "sa": "mahā-yoga-īśvaraḥ", "en": "the great lord of yoga", "term": "yoga" },
      { "sa": "hariḥ", "en": "Hari" },
      { "sa": "darśayām āsa", "en": "showed" },
      { "sa": "pārthāya", "en": "to the son of Pṛthā" },
      { "sa": "paramam", "en": "highest" },
      { "sa": "rūpam", "en": "form" },
      { "sa": "aiśvaram", "en": "lordly" }
    ],
    "translation": "Having spoken thus, O king, Hari, the great lord of yoga, then showed to the son of Pṛthā the highest lordly form,",
    "notes": ["Verses 9 to 11 are one sentence in the Sanskrit."]
  },
  "10": {
    "words": [
      { "sa": "aneka-vaktra-nayanam", "en": "with many mouths and eyes" },
      { "sa": "aneka-adbhuta-darśanam", "en": "with many wondrous sights" },
      { "sa": "aneka-divya-ābharaṇam", "en": "with many divine ornaments" },
      { "sa": "divya-aneka-udyata-āyudham", "en": "with many divine weapons raised" }
    ],
    "translation": "with many mouths and eyes, with many wondrous sights, with many divine ornaments, with many divine weapons raised,"
  },
  "11": {
    "words": [
      { "sa": "divya-mālya-ambara-dharam", "en": "wearing divine garlands and garments" },
      { "sa": "divya-gandha-anulepanam", "en": "anointed with divine fragrances" },
      { "sa": "sarva-āścarya-mayam", "en": "made of all wonders" },
      { "sa": "devam", "en": "the god" },
      { "sa": "anantam", "en": "endless" },
      { "sa": "viśvataḥ-mukham", "en": "with faces on every side" }
    ],
    "translation": "wearing divine garlands and garments, anointed with divine fragrances, made of all wonders, the god, endless, with faces on every side."
  },
  "12": {
    "words": [
      { "sa": "divi", "en": "in the sky" },
      { "sa": "sūrya-sahasrasya", "en": "of a thousand suns" },
      { "sa": "bhavet", "en": "were to be" },
      { "sa": "yugapat", "en": "at once" },
      { "sa": "utthitā", "en": "risen" },
      { "sa": "yadi", "en": "if" },
      { "sa": "bhāḥ", "en": "the light" },
      { "sa": "sadṛśī", "en": "like" },
      { "sa": "sā", "en": "that" },
      { "sa": "syāt", "en": "would be" },
      { "sa": "bhāsaḥ", "en": "the light" },
      { "sa": "tasya", "en": "of that" },
      { "sa": "mahā-ātmanaḥ", "en": "of the one of great self", "term": "atman" }
    ],
    "translation": "If the light of a thousand suns were to be risen at once in the sky, that would be like the light of that one of great self."
  },
  "13": {
    "words": [
      { "sa": "tatra", "en": "there" },
      { "sa": "eka-stham", "en": "standing in one place" },
      { "sa": "jagat", "en": "the world" },
      { "sa": "kṛtsnam", "en": "whole" },
      { "sa": "pravibhaktam", "en": "divided" },
      { "sa": "anekadhā", "en": "in many ways" },
      { "sa": "apaśyat", "en": "he saw" },
      { "sa": "deva-devasya", "en": "of the god of gods" },
      { "sa": "śarīre", "en": "in the body" },
      { "sa": "pāṇḍavaḥ", "en": "the son of Pāṇḍu" },
      { "sa": "tadā", "en": "then" }
    ],
    "translation": "There, in the body of the god of gods, the son of Pāṇḍu then saw the whole world standing in one place, divided in many ways."
  },
  "14": {
    "words": [
      { "sa": "tataḥ", "en": "then" },
      { "sa": "saḥ", "en": "he" },
      { "sa": "vismaya-āviṣṭaḥ", "en": "filled with amazement" },
      { "sa": "hṛṣṭa-romā", "en": "with hair standing on end" },
      { "sa": "dhanañjayaḥ", "en": "the winner of wealth" },
      { "sa": "praṇamya", "en": "having bowed" },
      { "sa": "śirasā", "en": "with the head" },
      { "sa": "devam", "en": "to the god" },
      { "sa": "kṛta-añjaliḥ", "en": "with palms joined" },
      { "sa": "abhāṣata", "en": "spoke" }
    ],
    "translation": "Then he, the winner of wealth, filled with amazement, with hair standing on end, having bowed with the head to the god, spoke with palms joined."
  },
  "15": {
    "words": [
      { "sa": "paśyāmi", "en": "I see" },
      { "sa": "devān", "en": "the gods" },
      { "sa": "tava", "en": "of you" },
      { "sa": "deva", "en": "O god" },
      { "sa": "dehe", "en": "in the body" },
      { "sa": "sarvān", "en": "all" },
      { "sa": "tathā", "en": "and also" },
      { "sa": "bhūta-viśeṣa-saṅghān", "en": "the hosts of the different kinds of beings" },
      { "sa": "brahmāṇam", "en": "Brahmā" },
      { "sa": "īśam", "en": "the lord" },
      { "sa": "kamala-āsana-stham", "en": "seated on the lotus seat" },
      { "sa": "ṛṣīn", "en": "the seers" },
      { "sa": "ca", "en": "and" },
      { "sa": "sarvān", "en": "all" },
      { "sa": "uragān", "en": "the serpents" },
      { "sa": "ca", "en": "and" },
      { "sa": "divyān", "en": "divine" }
    ],
    "translation": "I see all the gods in your body, O god, and also the hosts of the different kinds of beings, Brahmā the lord seated on the lotus seat, and all the seers and the divine serpents.",
    "notes": ["\"Brahmā the lord seated on the lotus seat\" can also be read as two gods: \"Brahmā seated on the lotus seat, and the Lord (Śiva)\"."]
  },
  "16": {
    "words": [
      { "sa": "aneka-bāhu-udara-vaktra-netram", "en": "with many arms, bellies, mouths and eyes" },
      { "sa": "paśyāmi", "en": "I see" },
      { "sa": "tvām", "en": "you" },
      { "sa": "sarvataḥ", "en": "on every side" },
      { "sa": "ananta-rūpam", "en": "of endless form" },
      { "sa": "na", "en": "not" },
      { "sa": "antam", "en": "end" },
      { "sa": "na", "en": "not" },
      { "sa": "madhyam", "en": "middle" },
      { "sa": "na", "en": "not" },
      { "sa": "punaḥ", "en": "again" },
      { "sa": "tava", "en": "of you" },
      { "sa": "ādim", "en": "beginning" },
      { "sa": "paśyāmi", "en": "I see" },
      { "sa": "viśva-īśvara", "en": "O lord of all" },
      { "sa": "viśva-rūpa", "en": "O one whose form is all" }
    ],
    "translation": "I see you with many arms, bellies, mouths and eyes, of endless form on every side. I see no end, no middle, nor again a beginning of you, O lord of all, O one whose form is all."
  },
  "17": {
    "words": [
      { "sa": "kirīṭinam", "en": "wearing a crown" },
      { "sa": "gadinam", "en": "bearing a mace" },
      { "sa": "cakriṇam", "en": "bearing a discus" },
      { "sa": "ca", "en": "and" },
      { "sa": "tejaḥ-rāśim", "en": "a mass of radiance" },
      { "sa": "sarvataḥ", "en": "on every side" },
      { "sa": "dīptimantam", "en": "shining" },
      { "sa": "paśyāmi", "en": "I see" },
      { "sa": "tvām", "en": "you" },
      { "sa": "durnirīkṣyam", "en": "hard to look at" },
      { "sa": "samantāt", "en": "all around" },
      { "sa": "dīpta-anala-arka-dyutim", "en": "with the brightness of blazing fire and sun" },
      { "sa": "aprameyam", "en": "immeasurable" }
    ],
    "translation": "I see you wearing a crown, bearing a mace and bearing a discus, a mass of radiance shining on every side, hard to look at, all around with the brightness of blazing fire and sun, immeasurable."
  },
  "18": {
    "words": [
      { "sa": "tvam", "en": "you" },
      { "sa": "akṣaram", "en": "the undecaying" },
      { "sa": "paramam", "en": "highest" },
      { "sa": "veditavyam", "en": "to be known" },
      { "sa": "tvam", "en": "you" },
      { "sa": "asya", "en": "of this" },
      { "sa": "viśvasya", "en": "of all" },
      { "sa": "param", "en": "highest" },
      { "sa": "nidhānam", "en": "resting place" },
      { "sa": "tvam", "en": "you" },
      { "sa": "avyayaḥ", "en": "imperishable" },
      { "sa": "śāśvata-dharma-goptā", "en": "guardian of the everlasting dharma", "term": "dharma" },
      { "sa": "sanātanaḥ", "en": "eternal" },
      { "sa": "tvam", "en": "you" },
      { "sa": "puruṣaḥ", "en": "the person" },
      { "sa": "mataḥ", "en": "thought" },
      { "sa": "me", "en": "by me" }
    ],
    "translation": "You are the undecaying, the highest, to be known. You are the highest resting place of this all. You are the imperishable guardian of the everlasting dharma. You are the eternal person: so it is thought by me.",
    "notes": ["\"The undecaying, the highest, to be known\" can also be read as \"the highest undecaying one that is to be known\"."]
  }
}

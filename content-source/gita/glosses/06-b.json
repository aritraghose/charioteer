{
  "13": {
    "words": [
      { "sa": "samam", "en": "even" },
      { "sa": "kāya-śiraḥ-grīvam", "en": "body, head and neck" },
      { "sa": "dhārayan", "en": "holding" },
      { "sa": "acalam", "en": "unmoving" },
      { "sa": "sthiraḥ", "en": "steady" },
      { "sa": "samprekṣya", "en": "having looked at" },
      { "sa": "nāsikā-agram", "en": "the tip of the nose" },
      { "sa": "svam", "en": "one's own" },
      { "sa": "diśaḥ", "en": "the directions" },
      { "sa": "ca", "en": "and" },
      { "sa": "anavalokayan", "en": "not looking at" }
    ],
    "translation": "Holding body, head and neck even and unmoving, steady, having looked at the tip of one's own nose and not looking at the directions,"
  },
  "14": {
    "words": [
      { "sa": "praśānta-ātmā", "en": "with the self made calm", "term": "atman" },
      { "sa": "vigata-bhīḥ", "en": "with fear gone" },
      { "sa": "brahmacāri-vrate", "en": "in the vow of a celibate student", "term": "brahman" },
      { "sa": "sthitaḥ", "en": "established" },
      { "sa": "manaḥ", "en": "the mind", "term": "manas" },
      { "sa": "saṁyamya", "en": "having restrained" },
      { "sa": "mat-cittaḥ", "en": "with mind on me" },
      { "sa": "yuktaḥ", "en": "yoked", "term": "yoga" },
      { "sa": "āsīta", "en": "one should sit" },
      { "sa": "mat-paraḥ", "en": "having me as the highest" }
    ],
    "translation": "with the self made calm, with fear gone, established in the vow of a celibate student, having restrained the mind, with mind on me, one should sit yoked, having me as the highest."
  },
  "15": {
    "words": [
      { "sa": "yuñjan", "en": "yoking", "term": "yoga" },
      { "sa": "evam", "en": "thus" },
      { "sa": "sadā", "en": "always" },
      { "sa": "ātmānam", "en": "the self", "term": "atman" },
      { "sa": "yogī", "en": "the yogī", "term": "yoga" },
      { "sa": "niyata-mānasaḥ", "en": "whose mind is controlled", "term": "manas" },
      { "sa": "śāntim", "en": "peace", "term": "shanti" },
      { "sa": "nirvāṇa-paramām", "en": "having nirvāṇa as its highest" },
      { "sa": "mat-saṁsthām", "en": "abiding in me" },
      { "sa": "adhigacchati", "en": "reaches" }
    ],
    "translation": "Thus always yoking the self, the yogī whose mind is controlled reaches the peace that has nirvāṇa as its highest and abides in me."
  },
  "16": {
    "words": [
      { "sa": "na", "en": "not" },
      { "sa": "ati-aśnataḥ", "en": "of one who eats too much" },
      { "sa": "tu", "en": "but" },
      { "sa": "yogaḥ", "en": "yoga", "term": "yoga" },
      { "sa": "asti", "en": "is" },
      { "sa": "na", "en": "not" },
      { "sa": "ca", "en": "and" },
      { "sa": "ekāntam", "en": "at all" },
      { "sa": "anaśnataḥ", "en": "of one who does not eat" },
      { "sa": "na", "en": "not" },
      { "sa": "ca", "en": "and" },
      { "sa": "ati-svapna-śīlasya", "en": "of one given to too much sleep" },
      { "sa": "jāgrataḥ", "en": "of one who stays awake" },
      { "sa": "na", "en": "not" },
      { "sa": "eva", "en": "indeed" },
      { "sa": "ca", "en": "and" },
      { "sa": "arjuna", "en": "O Arjuna" }
    ],
    "translation": "But yoga is not of one who eats too much, and not of one who does not eat at all, and not of one given to too much sleep, and indeed not of one who stays awake, O Arjuna."
  },
  "17": {
    "words": [
      { "sa": "yukta-āhāra-vihārasya", "en": "of one measured in food and recreation", "term": "yoga" },
      { "sa": "yukta-ceṣṭasya", "en": "of one measured in effort", "term": "yoga" },
      { "sa": "karmasu", "en": "in actions", "term": "karma" },
      { "sa": "yukta-svapna-avabodhasya", "en": "of one measured in sleep and waking", "term": "yoga" },
      { "sa": "yogaḥ", "en": "yoga", "term": "yoga" },
      { "sa": "bhavati", "en": "becomes" },
      { "sa": "duḥkha-hā", "en": "the destroyer of sorrow" }
    ],
    "translation": "The yoga of one measured in food and recreation, of one measured in effort in actions, of one measured in sleep and waking, becomes the destroyer of sorrow."
  },
  "18": {
    "words": [
      { "sa": "yadā", "en": "when" },
      { "sa": "viniyatam", "en": "well controlled" },
      { "sa": "cittam", "en": "the mind" },
      { "sa": "ātmani", "en": "in the self", "term": "atman" },
      { "sa": "eva", "en": "alone" },
      { "sa": "avatiṣṭhate", "en": "abides" },
      { "sa": "niḥspṛhaḥ", "en": "free of longing" },
      { "sa": "sarva-kāmebhyaḥ", "en": "for all desires", "term": "kama" },
      { "sa": "yuktaḥ", "en": "yoked", "term": "yoga" },
      { "sa": "iti", "en": "thus" },
      { "sa": "ucyate", "en": "one is called" },
      { "sa": "tadā", "en": "then" }
    ],
    "translation": "When the well controlled mind abides in the self alone, free of longing for all desires, then one is called thus: yoked."
  },
  "20": {
    "words": [
      { "sa": "yatra", "en": "where" },
      { "sa": "uparamate", "en": "comes to rest" },
      { "sa": "cittam", "en": "the mind" },
      { "sa": "niruddham", "en": "held in check" },
      { "sa": "yoga-sevayā", "en": "by the practice of yoga", "term": "yoga" },
      { "sa": "yatra", "en": "where" },
      { "sa": "ca", "en": "and" },
      { "sa": "eva", "en": "indeed" },
      { "sa": "ātmanā", "en": "by the self", "term": "atman" },
      { "sa": "ātmānam", "en": "the self", "term": "atman" },
      { "sa": "paśyan", "en": "seeing" },
      { "sa": "ātmani", "en": "in the self", "term": "atman" },
      { "sa": "tuṣyati", "en": "one is content" }
    ],
    "translation": "Where the mind, held in check by the practice of yoga, comes to rest, and where indeed, seeing the self by the self, one is content in the self,"
  },
  "21": {
    "words": [
      { "sa": "sukham", "en": "happiness" },
      { "sa": "ātyantikam", "en": "endless" },
      { "sa": "yat", "en": "which" },
      { "sa": "tat", "en": "that" },
      { "sa": "buddhi-grāhyam", "en": "to be grasped by buddhi", "term": "buddhi" },
      { "sa": "atīndriyam", "en": "beyond the senses", "term": "indriya" },
      { "sa": "vetti", "en": "one knows" },
      { "sa": "yatra", "en": "where" },
      { "sa": "na", "en": "not" },
      { "sa": "ca", "en": "and" },
      { "sa": "eva", "en": "indeed" },
      { "sa": "ayam", "en": "this one" },
      { "sa": "sthitaḥ", "en": "established" },
      { "sa": "calati", "en": "moves" },
      { "sa": "tattvataḥ", "en": "from the truth" }
    ],
    "translation": "where one knows that endless happiness which is to be grasped by buddhi and is beyond the senses, and where, established, this one indeed does not move from the truth,"
  },
  "22": {
    "words": [
      { "sa": "yam", "en": "which" },
      { "sa": "labdhvā", "en": "having gained" },
      { "sa": "ca", "en": "and" },
      { "sa": "aparam", "en": "another" },
      { "sa": "lābham", "en": "gain" },
      { "sa": "manyate", "en": "one thinks" },
      { "sa": "na", "en": "not" },
      { "sa": "adhikam", "en": "greater" },
      { "sa": "tataḥ", "en": "than that" },
      { "sa": "yasmin", "en": "in which" },
      { "sa": "sthitaḥ", "en": "established" },
      { "sa": "na", "en": "not" },
      { "sa": "duḥkhena", "en": "by sorrow" },
      { "sa": "guruṇā", "en": "heavy" },
      { "sa": "api", "en": "even" },
      { "sa": "vicālyate", "en": "one is shaken" }
    ],
    "translation": "and having gained which, one does not think another gain greater than that, established in which, one is not shaken even by heavy sorrow,"
  },
  "23": {
    "words": [
      { "sa": "tam", "en": "that" },
      { "sa": "vidyāt", "en": "one should know" },
      { "sa": "duḥkha-saṁyoga-viyogam", "en": "the unjoining of the joining with sorrow" },
      { "sa": "yoga-saṁjñitam", "en": "named yoga", "term": "yoga" },
      { "sa": "saḥ", "en": "that" },
      { "sa": "niścayena", "en": "with resolve" },
      { "sa": "yoktavyaḥ", "en": "is to be practised", "term": "yoga" },
      { "sa": "yogaḥ", "en": "yoga", "term": "yoga" },
      { "sa": "anirviṇṇa-cetasā", "en": "with an undespairing mind" }
    ],
    "translation": "one should know that, the unjoining of the joining with sorrow, as named yoga. That yoga is to be practised with resolve, with an undespairing mind."
  },
  "24": {
    "words": [
      { "sa": "saṅkalpa-prabhavān", "en": "born of intention" },
      { "sa": "kāmān", "en": "desires", "term": "kama" },
      { "sa": "tyaktvā", "en": "having abandoned" },
      { "sa": "sarvān", "en": "all" },
      { "sa": "aśeṣataḥ", "en": "without remainder" },
      { "sa": "manasā", "en": "by the mind", "term": "manas" },
      { "sa": "eva", "en": "alone" },
      { "sa": "indriya-grāmam", "en": "the group of the senses", "term": "indriya" },
      { "sa": "viniyamya", "en": "having controlled" },
      { "sa": "samantataḥ", "en": "on all sides" }
    ],
    "translation": "Having abandoned without remainder all desires born of intention, having controlled the group of the senses on all sides by the mind alone,"
  },
  "25": {
    "words": [
      { "sa": "śanaiḥ śanaiḥ", "en": "little by little" },
      { "sa": "uparamet", "en": "one should come to rest" },
      { "sa": "buddhyā", "en": "by buddhi", "term": "buddhi" },
      { "sa": "dhṛti-gṛhītayā", "en": "held by firmness" },
      { "sa": "ātma-saṁstham", "en": "abiding in the self", "term": "atman" },
      { "sa": "manaḥ", "en": "the mind", "term": "manas" },
      { "sa": "kṛtvā", "en": "having made" },
      { "sa": "na", "en": "not" },
      { "sa": "kiñcit", "en": "anything" },
      { "sa": "api", "en": "at all" },
      { "sa": "cintayet", "en": "one should think of" }
    ],
    "translation": "little by little one should come to rest, by buddhi held by firmness. Having made the mind abide in the self, one should not think of anything at all."
  },
  "27": {
    "words": [
      { "sa": "praśānta-manasam", "en": "whose mind is calm", "term": "manas" },
      { "sa": "hi", "en": "for" },
      { "sa": "enam", "en": "this" },
      { "sa": "yoginam", "en": "to the yogī", "term": "yoga" },
      { "sa": "sukham", "en": "happiness" },
      { "sa": "uttamam", "en": "highest" },
      { "sa": "upaiti", "en": "comes" },
      { "sa": "śānta-rajasam", "en": "whose rajas is stilled", "term": "guna" },
      { "sa": "brahma-bhūtam", "en": "who has become brahman", "term": "brahman" },
      { "sa": "akalmaṣam", "en": "without stain" }
    ],
    "translation": "For the highest happiness comes to this yogī whose mind is calm, whose rajas is stilled, who has become brahman, who is without stain."
  },
  "28": {
    "words": [
      { "sa": "yuñjan", "en": "yoking", "term": "yoga" },
      { "sa": "evam", "en": "thus" },
      { "sa": "sadā", "en": "always" },
      { "sa": "ātmānam", "en": "the self", "term": "atman" },
      { "sa": "yogī", "en": "the yogī", "term": "yoga" },
      { "sa": "vigata-kalmaṣaḥ", "en": "with stain gone" },
      { "sa": "sukhena", "en": "with ease" },
      { "sa": "brahma-saṁsparśam", "en": "the touch of brahman", "term": "brahman" },
      { "sa": "atyantam", "en": "endless" },
      { "sa": "sukham", "en": "happiness" },
      { "sa": "aśnute", "en": "attains" }
    ],
    "translation": "Thus always yoking the self, the yogī with stain gone attains with ease the touch of brahman, endless happiness."
  },
  "29": {
    "words": [
      { "sa": "sarva-bhūta-stham", "en": "abiding in all beings" },
      { "sa": "ātmānam", "en": "the self", "term": "atman" },
      { "sa": "sarva-bhūtāni", "en": "all beings" },
      { "sa": "ca", "en": "and" },
      { "sa": "ātmani", "en": "in the self", "term": "atman" },
      { "sa": "īkṣate", "en": "sees" },
      { "sa": "yoga-yukta-ātmā", "en": "one whose self is yoked by yoga", "term": "yoga" },
      { "sa": "sarvatra", "en": "everywhere" },
      { "sa": "sama-darśanaḥ", "en": "seeing the same", "term": "samatva" }
    ],
    "translation": "One whose self is yoked by yoga, seeing the same everywhere, sees the self abiding in all beings and all beings in the self."
  },
  "30": {
    "words": [
      { "sa": "yaḥ", "en": "who" },
      { "sa": "mām", "en": "me" },
      { "sa": "paśyati", "en": "sees" },
      { "sa": "sarvatra", "en": "everywhere" },
      { "sa": "sarvam", "en": "everything" },
      { "sa": "ca", "en": "and" },
      { "sa": "mayi", "en": "in me" },
      { "sa": "paśyati", "en": "sees" },
      { "sa": "tasya", "en": "to that one" },
      { "sa": "aham", "en": "I" },
      { "sa": "na", "en": "not" },
      { "sa": "praṇaśyāmi", "en": "am lost" },
      { "sa": "saḥ", "en": "that one" },
      { "sa": "ca", "en": "and" },
      { "sa": "me", "en": "to me" },
      { "sa": "na", "en": "not" },
      { "sa": "praṇaśyati", "en": "is lost" }
    ],
    "translation": "Who sees me everywhere and sees everything in me, to that one I am not lost, and that one is not lost to me."
  },
  "31": {
    "words": [
      { "sa": "sarva-bhūta-sthitam", "en": "abiding in all beings" },
      { "sa": "yaḥ", "en": "who" },
      { "sa": "mām", "en": "me" },
      { "sa": "bhajati", "en": "worships" },
      { "sa": "ekatvam", "en": "oneness" },
      { "sa": "āsthitaḥ", "en": "resting on" },
      { "sa": "sarvathā", "en": "in every way" },
      { "sa": "vartamānaḥ", "en": "living" },
      { "sa": "api", "en": "even though" },
      { "sa": "saḥ", "en": "that" },
      { "sa": "yogī", "en": "yogī", "term": "yoga" },
      { "sa": "mayi", "en": "in me" },
      { "sa": "vartate", "en": "lives" }
    ],
    "translation": "Who, resting on oneness, worships me abiding in all beings, that yogī, even though living in every way, lives in me."
  },
  "32": {
    "words": [
      { "sa": "ātma-aupamyena", "en": "by likeness to the self", "term": "atman" },
      { "sa": "sarvatra", "en": "everywhere" },
      { "sa": "samam", "en": "the same", "term": "samatva" },
      { "sa": "paśyati", "en": "sees" },
      { "sa": "yaḥ", "en": "who" },
      { "sa": "arjuna", "en": "O Arjuna" },
      { "sa": "sukham", "en": "happiness" },
      { "sa": "vā", "en": "or" },
      { "sa": "yadi", "en": "if" },
      { "sa": "vā", "en": "or" },
      { "sa": "duḥkham", "en": "sorrow" },
      { "sa": "saḥ", "en": "that" },
      { "sa": "yogī", "en": "yogī", "term": "yoga" },
      { "sa": "paramaḥ", "en": "highest" },
      { "sa": "mataḥ", "en": "is thought" }
    ],
    "translation": "Who, by likeness to the self, sees the same everywhere, O Arjuna, be it happiness or if it be sorrow, that yogī is thought the highest."
  },
  "33": {
    "words": [
      { "sa": "yaḥ", "en": "which" },
      { "sa": "ayam", "en": "this" },
      { "sa": "yogaḥ", "en": "yoga", "term": "yoga" },
      { "sa": "tvayā", "en": "by you" },
      { "sa": "proktaḥ", "en": "declared" },
      { "sa": "sāmyena", "en": "as sameness", "term": "samatva" },
      { "sa": "madhusūdana", "en": "O slayer of Madhu" },
      { "sa": "etasya", "en": "of this" },
      { "sa": "aham", "en": "I" },
      { "sa": "na", "en": "not" },
      { "sa": "paśyāmi", "en": "see" },
      { "sa": "cañcalatvāt", "en": "because of restlessness" },
      { "sa": "sthitim", "en": "footing" },
      { "sa": "sthirām", "en": "steady" }
    ],
    "translation": "This yoga which was declared by you as sameness, O slayer of Madhu: I do not see a steady footing of this, because of restlessness."
  }
}

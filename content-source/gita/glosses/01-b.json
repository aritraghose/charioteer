{
  "25": {
    "words": [
      { "sa": "bhīṣma-droṇa-pramukhataḥ", "en": "in front of Bhīṣma and Droṇa" },
      { "sa": "sarveṣām", "en": "of all" },
      { "sa": "ca", "en": "and" },
      { "sa": "mahī-kṣitām", "en": "of the rulers of the earth" },
      { "sa": "uvāca", "en": "he said" },
      { "sa": "pārtha", "en": "O son of Pṛthā" },
      { "sa": "paśya", "en": "see" },
      { "sa": "etān", "en": "these" },
      { "sa": "samavetān", "en": "assembled" },
      { "sa": "kurūn", "en": "the Kurus" },
      { "sa": "iti", "en": "thus" }
    ],
    "translation": "in front of Bhīṣma and Droṇa and of all the rulers of the earth, he said thus: O son of Pṛthā, see these Kurus assembled."
  },
  "26": {
    "words": [
      { "sa": "tatra", "en": "there" },
      { "sa": "apaśyat", "en": "he saw" },
      { "sa": "sthitān", "en": "standing" },
      { "sa": "pārthaḥ", "en": "the son of Pṛthā" },
      { "sa": "pitṝn", "en": "fathers" },
      { "sa": "atha", "en": "and then" },
      { "sa": "pitāmahān", "en": "grandfathers" },
      { "sa": "ācāryān", "en": "teachers" },
      { "sa": "mātulān", "en": "maternal uncles" },
      { "sa": "bhrātṝn", "en": "brothers" },
      { "sa": "putrān", "en": "sons" },
      { "sa": "pautrān", "en": "grandsons" },
      { "sa": "sakhīn", "en": "friends" },
      { "sa": "tathā", "en": "likewise" }
    ],
    "translation": "There the son of Pṛthā saw standing fathers and then grandfathers, teachers, maternal uncles, brothers, sons, grandsons and likewise friends,",
    "notes": ["Verses 26 to 29 are one sentence in the Sanskrit."]
  },
  "27": {
    "words": [
      { "sa": "śvaśurān", "en": "fathers-in-law" },
      { "sa": "suhṛdaḥ", "en": "well-wishers" },
      { "sa": "ca", "en": "and" },
      { "sa": "eva", "en": "indeed" },
      { "sa": "senayoḥ", "en": "in the two armies" },
      { "sa": "ubhayoḥ", "en": "in both" },
      { "sa": "api", "en": "also" },
      { "sa": "tān", "en": "those" },
      { "sa": "samīkṣya", "en": "having looked closely at" },
      { "sa": "saḥ", "en": "he" },
      { "sa": "kaunteyaḥ", "en": "the son of Kuntī" },
      { "sa": "sarvān", "en": "all" },
      { "sa": "bandhūn", "en": "relatives" },
      { "sa": "avasthitān", "en": "stationed" }
    ],
    "translation": "fathers-in-law and indeed well-wishers also, in both of the two armies. Having looked closely at all those relatives stationed there, he, the son of Kuntī,"
  },
  "28": {
    "words": [
      { "sa": "kṛpayā", "en": "by compassion" },
      { "sa": "parayā", "en": "by supreme" },
      { "sa": "āviṣṭaḥ", "en": "filled" },
      { "sa": "viṣīdan", "en": "despairing" },
      { "sa": "idam", "en": "this" },
      { "sa": "abravīt", "en": "he said" },
      { "sa": "dṛṣṭvā", "en": "having seen" },
      { "sa": "imam", "en": "this" },
      { "sa": "sva-janam", "en": "own people" },
      { "sa": "kṛṣṇa", "en": "O Kṛṣṇa" },
      { "sa": "yuyutsum", "en": "wishing to fight" },
      { "sa": "samupasthitam", "en": "come near" }
    ],
    "translation": "filled by supreme compassion, despairing, said this: having seen this people of my own, O Kṛṣṇa, come near and wishing to fight,"
  },
  "29": {
    "words": [
      { "sa": "sīdanti", "en": "they sink" },
      { "sa": "mama", "en": "my" },
      { "sa": "gātrāṇi", "en": "limbs" },
      { "sa": "mukham", "en": "the mouth" },
      { "sa": "ca", "en": "and" },
      { "sa": "pariśuṣyati", "en": "dries up" },
      { "sa": "vepathuḥ", "en": "trembling" },
      { "sa": "ca", "en": "and" },
      { "sa": "śarīre", "en": "in the body" },
      { "sa": "me", "en": "my" },
      { "sa": "roma-harṣaḥ", "en": "bristling of the hair" },
      { "sa": "ca", "en": "and" },
      { "sa": "jāyate", "en": "arises" }
    ],
    "translation": "my limbs sink and the mouth dries up, and trembling in my body and bristling of the hair arises."
  },
  "30": {
    "words": [
      { "sa": "gāṇḍīvam", "en": "the bow Gāṇḍīva" },
      { "sa": "sraṁsate", "en": "slips" },
      { "sa": "hastāt", "en": "from the hand" },
      { "sa": "tvak", "en": "the skin" },
      { "sa": "ca", "en": "and" },
      { "sa": "eva", "en": "indeed" },
      { "sa": "paridahyate", "en": "burns all over" },
      { "sa": "na", "en": "not" },
      { "sa": "ca", "en": "and" },
      { "sa": "śaknomi", "en": "I am able" },
      { "sa": "avasthātum", "en": "to stay standing" },
      { "sa": "bhramati", "en": "it whirls" },
      { "sa": "iva", "en": "as if" },
      { "sa": "ca", "en": "and" },
      { "sa": "me", "en": "my" },
      { "sa": "manaḥ", "en": "the mind", "term": "manas" }
    ],
    "translation": "The bow Gāṇḍīva slips from the hand, and the skin indeed burns all over. And I am not able to stay standing, and my mind whirls, as it were."
  },
  "31": {
    "words": [
      { "sa": "nimittāni", "en": "omens" },
      { "sa": "ca", "en": "and" },
      { "sa": "paśyāmi", "en": "I see" },
      { "sa": "viparītāni", "en": "adverse" },
      { "sa": "keśava", "en": "O Keśava" },
      { "sa": "na", "en": "not" },
      { "sa": "ca", "en": "and" },
      { "sa": "śreyaḥ", "en": "good" },
      { "sa": "anupaśyāmi", "en": "I foresee" },
      { "sa": "hatvā", "en": "having killed" },
      { "sa": "sva-janam", "en": "own people" },
      { "sa": "āhave", "en": "in battle" }
    ],
    "translation": "And I see adverse omens, O Keśava. And I do not foresee good, having killed my own people in battle."
  },
  "32": {
    "words": [
      { "sa": "na", "en": "not" },
      { "sa": "kāṅkṣe", "en": "I desire" },
      { "sa": "vijayam", "en": "victory" },
      { "sa": "kṛṣṇa", "en": "O Kṛṣṇa" },
      { "sa": "na", "en": "not" },
      { "sa": "ca", "en": "and" },
      { "sa": "rājyam", "en": "kingdom" },
      { "sa": "sukhāni", "en": "pleasures" },
      { "sa": "ca", "en": "and" },
      { "sa": "kim", "en": "what use" },
      { "sa": "naḥ", "en": "to us" },
      { "sa": "rājyena", "en": "with kingdom" },
      { "sa": "govinda", "en": "O Govinda" },
      { "sa": "kim", "en": "what use" },
      { "sa": "bhogaiḥ", "en": "with enjoyments" },
      { "sa": "jīvitena", "en": "with life" },
      { "sa": "vā", "en": "or" }
    ],
    "translation": "I do not desire victory, O Kṛṣṇa, and not kingdom and pleasures. What use to us is kingdom, O Govinda, what use are enjoyments or life?"
  },
  "33": {
    "words": [
      { "sa": "yeṣām", "en": "of whom" },
      { "sa": "arthe", "en": "for the sake" },
      { "sa": "kāṅkṣitam", "en": "desired" },
      { "sa": "naḥ", "en": "by us" },
      { "sa": "rājyam", "en": "kingdom" },
      { "sa": "bhogāḥ", "en": "enjoyments" },
      { "sa": "sukhāni", "en": "pleasures" },
      { "sa": "ca", "en": "and" },
      { "sa": "te", "en": "they" },
      { "sa": "ime", "en": "these" },
      { "sa": "avasthitāḥ", "en": "stationed" },
      { "sa": "yuddhe", "en": "in battle" },
      { "sa": "prāṇān", "en": "lives" },
      { "sa": "tyaktvā", "en": "having given up" },
      { "sa": "dhanāni", "en": "riches" },
      { "sa": "ca", "en": "and" }
    ],
    "translation": "Those for whose sake kingdom, enjoyments and pleasures are desired by us, they, these here, are stationed in battle, having given up lives and riches,",
    "notes": ["Verses 33 to 34 are one sentence in the Sanskrit."]
  },
  "34": {
    "words": [
      { "sa": "ācāryāḥ", "en": "teachers" },
      { "sa": "pitaraḥ", "en": "fathers" },
      { "sa": "putrāḥ", "en": "sons" },
      { "sa": "tathā", "en": "likewise" },
      { "sa": "eva", "en": "indeed" },
      { "sa": "ca", "en": "and" },
      { "sa": "pitāmahāḥ", "en": "grandfathers" },
      { "sa": "mātulāḥ", "en": "maternal uncles" },
      { "sa": "śvaśurāḥ", "en": "fathers-in-law" },
      { "sa": "pautrāḥ", "en": "grandsons" },
      { "sa": "śyālāḥ", "en": "brothers-in-law" },
      { "sa": "sambandhinaḥ", "en": "kinsmen by marriage" },
      { "sa": "tathā", "en": "likewise" }
    ],
    "translation": "teachers, fathers, sons, and likewise indeed grandfathers, maternal uncles, fathers-in-law, grandsons, brothers-in-law and likewise kinsmen by marriage."
  },
  "35": {
    "words": [
      { "sa": "etān", "en": "these" },
      { "sa": "na", "en": "not" },
      { "sa": "hantum", "en": "to kill" },
      { "sa": "icchāmi", "en": "I wish" },
      { "sa": "ghnataḥ", "en": "who are killing" },
      { "sa": "api", "en": "even though" },
      { "sa": "madhusūdana", "en": "O slayer of Madhu" },
      { "sa": "api", "en": "even" },
      { "sa": "trailokya-rājyasya", "en": "of kingship over the three worlds" },
      { "sa": "hetoḥ", "en": "for the sake" },
      { "sa": "kim", "en": "how much less" },
      { "sa": "nu", "en": "then" },
      { "sa": "mahī-kṛte", "en": "for the sake of the earth" }
    ],
    "translation": "These I do not wish to kill, even though they are killing, O slayer of Madhu, even for the sake of kingship over the three worlds. How much less, then, for the sake of the earth?"
  },
  "36": {
    "words": [
      { "sa": "nihatya", "en": "having struck down" },
      { "sa": "dhārtarāṣṭrān", "en": "the sons of Dhṛtarāṣṭra" },
      { "sa": "naḥ", "en": "ours" },
      { "sa": "kā", "en": "what" },
      { "sa": "prītiḥ", "en": "joy" },
      { "sa": "syāt", "en": "would be" },
      { "sa": "janārdana", "en": "O Janārdana" },
      { "sa": "pāpam", "en": "evil" },
      { "sa": "eva", "en": "only" },
      { "sa": "āśrayet", "en": "would settle on" },
      { "sa": "asmān", "en": "us" },
      { "sa": "hatvā", "en": "having killed" },
      { "sa": "etān", "en": "these" },
      { "sa": "ātatāyinaḥ", "en": "aggressors" }
    ],
    "translation": "Having struck down the sons of Dhṛtarāṣṭra, what joy would be ours, O Janārdana? Only evil would settle on us, having killed these aggressors."
  },
  "37": {
    "words": [
      { "sa": "tasmāt", "en": "therefore" },
      { "sa": "na", "en": "not" },
      { "sa": "arhāḥ", "en": "entitled" },
      { "sa": "vayam", "en": "we" },
      { "sa": "hantum", "en": "to kill" },
      { "sa": "dhārtarāṣṭrān", "en": "the sons of Dhṛtarāṣṭra" },
      { "sa": "sva-bāndhavān", "en": "own relatives" },
      { "sa": "sva-janam", "en": "own people" },
      { "sa": "hi", "en": "for" },
      { "sa": "katham", "en": "how" },
      { "sa": "hatvā", "en": "having killed" },
      { "sa": "sukhinaḥ", "en": "happy" },
      { "sa": "syāma", "en": "would we be" },
      { "sa": "mādhava", "en": "O Mādhava" }
    ],
    "translation": "Therefore we are not entitled to kill the sons of Dhṛtarāṣṭra, our own relatives. For how, having killed our own people, would we be happy, O Mādhava?"
  },
  "38": {
    "words": [
      { "sa": "yadi", "en": "if" },
      { "sa": "api", "en": "even" },
      { "sa": "ete", "en": "these" },
      { "sa": "na", "en": "not" },
      { "sa": "paśyanti", "en": "they see" },
      { "sa": "lobha-upahata-cetasaḥ", "en": "whose minds are struck down by greed" },
      { "sa": "kula-kṣaya-kṛtam", "en": "made by the destruction of the family" },
      { "sa": "doṣam", "en": "the fault" },
      { "sa": "mitra-drohe", "en": "in the betrayal of friends" },
      { "sa": "ca", "en": "and" },
      { "sa": "pātakam", "en": "the crime" }
    ],
    "translation": "Even if these, whose minds are struck down by greed, do not see the fault made by the destruction of the family and the crime in the betrayal of friends,",
    "notes": ["Verses 38 to 39 are one sentence in the Sanskrit."]
  },
  "39": {
    "words": [
      { "sa": "katham", "en": "how" },
      { "sa": "na", "en": "not" },
      { "sa": "jñeyam", "en": "to be known" },
      { "sa": "asmābhiḥ", "en": "by us" },
      { "sa": "pāpāt", "en": "from evil" },
      { "sa": "asmāt", "en": "from this" },
      { "sa": "nivartitum", "en": "to turn back" },
      { "sa": "kula-kṣaya-kṛtam", "en": "made by the destruction of the family" },
      { "sa": "doṣam", "en": "the fault" },
      { "sa": "prapaśyadbhiḥ", "en": "by those who see clearly" },
      { "sa": "janārdana", "en": "O Janārdana" }
    ],
    "translation": "how is it not to be known by us, who see clearly the fault made by the destruction of the family, to turn back from this evil, O Janārdana?"
  },
  "40": {
    "words": [
      { "sa": "kula-kṣaye", "en": "in the destruction of the family" },
      { "sa": "praṇaśyanti", "en": "they perish" },
      { "sa": "kula-dharmāḥ", "en": "the family dharmas", "term": "dharma" },
      { "sa": "sanātanāḥ", "en": "eternal" },
      { "sa": "dharme", "en": "when dharma", "term": "dharma" },
      { "sa": "naṣṭe", "en": "is lost" },
      { "sa": "kulam", "en": "the family" },
      { "sa": "kṛtsnam", "en": "whole" },
      { "sa": "adharmaḥ", "en": "the opposite of dharma", "term": "dharma" },
      { "sa": "abhibhavati", "en": "overpowers" },
      { "sa": "uta", "en": "indeed" }
    ],
    "translation": "In the destruction of the family, the eternal family dharmas perish. When dharma is lost, the opposite of dharma indeed overpowers the whole family."
  },
  "41": {
    "words": [
      { "sa": "adharma-abhibhavāt", "en": "from the overpowering by the opposite of dharma", "term": "dharma" },
      { "sa": "kṛṣṇa", "en": "O Kṛṣṇa" },
      { "sa": "praduṣyanti", "en": "they become corrupted" },
      { "sa": "kula-striyaḥ", "en": "the women of the family" },
      { "sa": "strīṣu", "en": "when the women" },
      { "sa": "duṣṭāsu", "en": "are corrupted" },
      { "sa": "vārṣṇeya", "en": "O descendant of Vṛṣṇi" },
      { "sa": "jāyate", "en": "arises" },
      { "sa": "varṇa-saṅkaraḥ", "en": "mixing of the classes" }
    ],
    "translation": "From the overpowering by the opposite of dharma, O Kṛṣṇa, the women of the family become corrupted. When the women are corrupted, O descendant of Vṛṣṇi, mixing of the classes arises."
  },
  "42": {
    "words": [
      { "sa": "saṅkaraḥ", "en": "the mixing" },
      { "sa": "narakāya", "en": "for hell" },
      { "sa": "eva", "en": "only" },
      { "sa": "kula-ghnānām", "en": "of the destroyers of the family" },
      { "sa": "kulasya", "en": "of the family" },
      { "sa": "ca", "en": "and" },
      { "sa": "patanti", "en": "they fall" },
      { "sa": "pitaraḥ", "en": "the ancestors" },
      { "sa": "hi", "en": "for" },
      { "sa": "eṣām", "en": "of these" },
      { "sa": "lupta-piṇḍa-udaka-kriyāḥ", "en": "whose rites of rice-ball and water are cut off" }
    ],
    "translation": "The mixing leads only to hell, for the destroyers of the family and for the family. For the ancestors of these fall, their rites of rice-ball and water cut off.",
    "notes": ["\"The ancestors of these\" can mean the ancestors of the destroyers of the family, or the ancestors of the whole family."]
  },
  "43": {
    "words": [
      { "sa": "doṣaiḥ", "en": "by faults" },
      { "sa": "etaiḥ", "en": "by these" },
      { "sa": "kula-ghnānām", "en": "of the destroyers of the family" },
      { "sa": "varṇa-saṅkara-kārakaiḥ", "en": "which cause mixing of the classes" },
      { "sa": "utsādyante", "en": "they are uprooted" },
      { "sa": "jāti-dharmāḥ", "en": "the dharmas of the birth-group", "term": "dharma" },
      { "sa": "kula-dharmāḥ", "en": "the family dharmas", "term": "dharma" },
      { "sa": "ca", "en": "and" },
      { "sa": "śāśvatāḥ", "en": "everlasting" }
    ],
    "translation": "By these faults of the destroyers of the family, which cause mixing of the classes, the dharmas of the birth-group and the everlasting family dharmas are uprooted."
  },
  "44": {
    "words": [
      { "sa": "utsanna-kula-dharmāṇām", "en": "whose family dharmas are uprooted", "term": "dharma" },
      { "sa": "manuṣyāṇām", "en": "of men" },
      { "sa": "janārdana", "en": "O Janārdana" },
      { "sa": "narake", "en": "in hell" },
      { "sa": "niyatam", "en": "certainly" },
      { "sa": "vāsaḥ", "en": "dwelling" },
      { "sa": "bhavati", "en": "there is" },
      { "sa": "iti", "en": "thus" },
      { "sa": "anuśuśruma", "en": "we have heard" }
    ],
    "translation": "For men whose family dharmas are uprooted, O Janārdana, there is certainly dwelling in hell: thus we have heard.",
    "notes": ["\"Certainly\" can also be read as \"for a fixed time\", describing how long the dwelling in hell lasts."]
  },
  "45": {
    "words": [
      { "sa": "aho", "en": "ah" },
      { "sa": "bata", "en": "alas" },
      { "sa": "mahat", "en": "great" },
      { "sa": "pāpam", "en": "evil" },
      { "sa": "kartum", "en": "to do" },
      { "sa": "vyavasitāḥ", "en": "resolved" },
      { "sa": "vayam", "en": "we" },
      { "sa": "yat", "en": "in that" },
      { "sa": "rājya-sukha-lobhena", "en": "by greed for the pleasure of kingdom" },
      { "sa": "hantum", "en": "to kill" },
      { "sa": "sva-janam", "en": "own people" },
      { "sa": "udyatāḥ", "en": "prepared" }
    ],
    "translation": "Ah, alas, we are resolved to do a great evil, in that by greed for the pleasure of kingdom we are prepared to kill our own people."
  },
  "46": {
    "words": [
      { "sa": "yadi", "en": "if" },
      { "sa": "mām", "en": "me" },
      { "sa": "apratīkāram", "en": "unresisting" },
      { "sa": "aśastram", "en": "unarmed" },
      { "sa": "śastra-pāṇayaḥ", "en": "with weapons in hand" },
      { "sa": "dhārtarāṣṭrāḥ", "en": "the sons of Dhṛtarāṣṭra" },
      { "sa": "raṇe", "en": "in battle" },
      { "sa": "hanyuḥ", "en": "they should kill" },
      { "sa": "tat", "en": "that" },
      { "sa": "me", "en": "for me" },
      { "sa": "kṣemataram", "en": "better" },
      { "sa": "bhavet", "en": "would be" }
    ],
    "translation": "If the sons of Dhṛtarāṣṭra, with weapons in hand, should kill me in battle, unresisting and unarmed, that would be better for me."
  },
  "47": {
    "words": [
      { "sa": "evam", "en": "thus" },
      { "sa": "uktvā", "en": "having spoken" },
      { "sa": "arjunaḥ", "en": "Arjuna" },
      { "sa": "saṅkhye", "en": "in the battle" },
      { "sa": "ratha-upasthe", "en": "on the seat of the chariot" },
      { "sa": "upāviśat", "en": "he sat down" },
      { "sa": "visṛjya", "en": "having cast away" },
      { "sa": "sa-śaram", "en": "together with arrow" },
      { "sa": "cāpam", "en": "the bow" },
      { "sa": "śoka-saṁvigna-mānasaḥ", "en": "whose mind is shaken by grief", "term": "manas" }
    ],
    "translation": "Having spoken thus in the battle, Arjuna sat down on the seat of the chariot, having cast away the bow together with arrow, his mind shaken by grief."
  }
}

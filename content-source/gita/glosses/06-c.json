{
  "36": {
    "words": [
      { "sa": "asaṁyata-ātmanā", "en": "by one whose self is unrestrained", "term": "atman" },
      { "sa": "yogaḥ", "en": "yoga", "term": "yoga" },
      { "sa": "duṣprāpaḥ", "en": "hard to reach" },
      { "sa": "iti", "en": "thus" },
      { "sa": "me", "en": "my" },
      { "sa": "matiḥ", "en": "view" },
      { "sa": "vaśya-ātmanā", "en": "by one whose self is under control", "term": "atman" },
      { "sa": "tu", "en": "but" },
      { "sa": "yatatā", "en": "by one who strives" },
      { "sa": "śakyaḥ", "en": "possible" },
      { "sa": "avāptum", "en": "to reach" },
      { "sa": "upāyataḥ", "en": "through the right means" }
    ],
    "translation": "Yoga is hard to reach by one whose self is unrestrained: thus is my view. But by one who strives, whose self is under control, it is possible to reach through the right means."
  },
  "37": {
    "words": [

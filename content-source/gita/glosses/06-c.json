      { "sa": "yoga-saṁsiddhim", "en": "full success in yoga", "term": "yoga" },
      { "sa": "kām", "en": "what" },
      { "sa": "gatim", "en": "course" },
      { "sa": "kṛṣṇa", "en": "O Kṛṣṇa" },
      { "sa": "gacchati", "en": "he goes" }

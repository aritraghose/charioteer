      { "sa": "lubdhaḥ", "en": "greedy" },
      { "sa": "hiṁsā-ātmakaḥ", "en": "harmful in nature" },
      { "sa": "aśuciḥ", "en": "impure" },
      { "sa": "harṣa-śoka-anvitaḥ", "en": "filled with joy and grief" },
      { "sa": "kartā", "en": "the doer" },
      { "sa": "rājasaḥ", "en": "of rajas", "term": "guna" },

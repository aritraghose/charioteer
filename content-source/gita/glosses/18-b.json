      { "sa": "dhārayate", "en": "one holds" },
      { "sa": "arjuna", "en": "O Arjuna" },
      { "sa": "prasaṅgena", "en": "with attachment", "term": "sanga" },
      { "sa": "phala-ākāṅkṣī", "en": "longing for the fruit" },
      { "sa": "dhṛtiḥ", "en": "firmness" },

{
  "1": {
    "words": [
      { "sa": "idam", "en": "this" },
      { "sa": "tu", "en": "but" },
      { "sa": "te", "en": "to you" },
      { "sa": "guhyatamam", "en": "most secret" },
      { "sa": "pravakṣyāmi", "en": "I will declare" },
      { "sa": "anasūyave", "en": "to one who does not find fault" },
      { "sa": "jñānam", "en": "knowledge" },
      { "sa": "vijñāna-sahitam", "en": "together with realization" },
      { "sa": "yat", "en": "which" },
      { "sa": "jñātvā", "en": "having known" },
      { "sa": "mokṣyase", "en": "you will be freed" },
      { "sa": "aśubhāt", "en": "from the inauspicious" }
    ],
    "translation": "But to you, who do not find fault, I will declare this most secret knowledge, together with realization, having known which you will be freed from the inauspicious."
  },
  "2": {
    "words": [
      { "sa": "rāja-vidyā", "en": "the king of knowledge" },
      { "sa": "rāja-guhyam", "en": "the king of secrets" },
      { "sa": "pavitram", "en": "purifier" },
      { "sa": "idam", "en": "this" },
      { "sa": "uttamam", "en": "highest" },
      { "sa": "pratyakṣa-avagamam", "en": "understood by direct perception" },
      { "sa": "dharmyam", "en": "in accord with dharma", "term": "dharma" },
      { "sa": "su-sukham", "en": "very easy" },
      { "sa": "kartum", "en": "to do" },
      { "sa": "avyayam", "en": "imperishable" }
    ],
    "translation": "This is the king of knowledge, the king of secrets, the highest purifier, understood by direct perception, in accord with dharma, very easy to do, imperishable.",
    "notes": ["\"The king of knowledge, the king of secrets\" can also be read as \"the knowledge of kings, the secret of kings\"."]
  },
  "3": {
    "words": [
      { "sa": "aśraddadhānāḥ", "en": "having no faith" },
      { "sa": "puruṣāḥ", "en": "men" },
      { "sa": "dharmasya", "en": "in dharma", "term": "dharma" },
      { "sa": "asya", "en": "in this" },
      { "sa": "parantapa", "en": "O scorcher of foes" },
      { "sa": "aprāpya", "en": "not having reached" },
      { "sa": "mām", "en": "me" },
      { "sa": "nivartante", "en": "they turn back" },
      { "sa": "mṛtyu-saṁsāra-vartmani", "en": "on the path of death and the round of rebirth" }
    ],
    "translation": "Men who have no faith in this dharma, O scorcher of foes, not having reached me, turn back on the path of death and the round of rebirth."
  },
  "4": {
    "words": [
      { "sa": "mayā", "en": "by me" },
      { "sa": "tatam", "en": "pervaded" },
      { "sa": "idam", "en": "this" },
      { "sa": "sarvam", "en": "all" },
      { "sa": "jagat", "en": "world" },
      { "sa": "avyakta-mūrtinā", "en": "by the one of unmanifest form" },
      { "sa": "mat-sthāni", "en": "standing in me" },
      { "sa": "sarva-bhūtāni", "en": "all beings" },
      { "sa": "na", "en": "not" },
      { "sa": "ca", "en": "and" },

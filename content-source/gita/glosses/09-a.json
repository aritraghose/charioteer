      { "sa": "pavitram", "en": "the purifier" },
      { "sa": "oṁkāraḥ", "en": "the syllable Oṁ" },
      { "sa": "ṛk", "en": "the Ṛg Veda" },
      { "sa": "sāma", "en": "the Sāma Veda" },
      { "sa": "yajuḥ", "en": "the Yajur Veda" },
      { "sa": "eva", "en": "indeed" },
      { "sa": "ca", "en": "and" }
    ],
    "translation": "I am the father of this world, the mother, the ordainer, the grandfather, what is to be known, the purifier, the syllable Oṁ, the Ṛg Veda, the Sāma Veda and indeed the Yajur Veda.",
    "notes": ["\"The ordainer\" can also be read as \"the supporter\"."]
  }
}

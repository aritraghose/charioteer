      { "sa": "kīrtayantaḥ", "en": "glorifying" },
      { "sa": "mām", "en": "me" },
      { "sa": "yatantaḥ", "en": "striving" },
      { "sa": "ca", "en": "and" },
      { "sa": "dṛḍha-vratāḥ", "en": "firm in vows" },
      { "sa": "namasyantaḥ", "en": "bowing" },
      { "sa": "ca", "en": "and" },
      { "sa": "mām", "en": "to me" },
      { "sa": "bhaktyā", "en": "with devotion" },
      { "sa": "nitya-yuktāḥ", "en": "always yoked", "term": "yoga" },
      { "sa": "upāsate", "en": "they worship" }
    ],
    "translation": "Constantly glorifying me and striving, firm in vows, and bowing to me with devotion, always yoked, they worship."
  },
  "15": {

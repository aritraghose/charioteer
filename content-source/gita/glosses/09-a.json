      { "sa": "bhūta-mahā-īśvaram", "en": "the great lord of beings" }
    ],
    "translation": "The deluded despise me, who have resorted to a human body, not knowing my higher being as the great lord of beings."
  },
  "12": {
    "words": [
      { "sa": "mogha-āśāḥ", "en": "of vain hopes" },
      { "sa": "mogha-karmāṇaḥ", "en": "of vain actions", "term": "karma" },
      { "sa": "mogha-jñānāḥ", "en": "of vain knowledge" },

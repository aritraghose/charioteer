      { "sa": "sa-cara-acaram", "en": "the moving together with the unmoving" },
      { "sa": "hetunā", "en": "by cause" },
      { "sa": "anena", "en": "by this" },
      { "sa": "kaunteya", "en": "O son of Kuntī" },
      { "sa": "jagat", "en": "the world" },
      { "sa": "viparivartate", "en": "revolves" }
    ],
    "translation": "With me as overseer, nature gives birth to the moving together with the unmoving. By this cause, O son of Kuntī, the world revolves."
  },
  "11": {
    "words": [
      { "sa": "avajānanti", "en": "they despise" },
      { "sa": "mām", "en": "me" },
      { "sa": "mūḍhāḥ", "en": "the deluded" },

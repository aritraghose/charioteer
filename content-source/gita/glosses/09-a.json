      { "sa": "rākṣasīm", "en": "fiendish" },
      { "sa": "āsurīm", "en": "demonic" },
      { "sa": "ca", "en": "and" },
      { "sa": "eva", "en": "indeed" },
      { "sa": "prakṛtim", "en": "nature" },
      { "sa": "mohinīm", "en": "deluding" },
      { "sa": "śritāḥ", "en": "having resorted to" }
    ],
    "translation": "Of vain hopes, of vain actions, of vain knowledge, without sense, they have resorted to the deluding nature, fiendish and indeed demonic."
  },
  "13": {
    "words": [
      { "sa": "mahā-ātmānaḥ", "en": "those of great self", "term": "atman" },
      { "sa": "tu", "en": "but" },
      { "sa": "mām", "en": "me" },
      { "sa": "pārtha", "en": "O son of Pṛthā" },
      { "sa": "daivīm", "en": "divine" },
      { "sa": "prakṛtim", "en": "nature" },
      { "sa": "āśritāḥ", "en": "having resorted to" },
      { "sa": "bhajanti", "en": "they worship" },
      { "sa": "ananya-manasaḥ", "en": "with mind on nothing else", "term": "manas" },
      { "sa": "jñātvā", "en": "having known" },
      { "sa": "bhūta-ādim", "en": "the beginning of beings" },
      { "sa": "avyayam", "en": "imperishable" }
    ],
    "translation": "But those of great self, O son of Pṛthā, having resorted to the divine nature, worship me with mind on nothing else, having known the imperishable beginning of beings."
  },
  "14": {
    "words": [

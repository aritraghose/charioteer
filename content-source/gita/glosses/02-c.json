      { "sa": "te", "en": "to you" },
      { "sa": "abhihitā", "en": "declared" },
      { "sa": "sāṅkhye", "en": "in sāṅkhya", "term": "sankhya" },
      { "sa": "buddhiḥ", "en": "buddhi", "term": "buddhi" },
      { "sa": "yoge", "en": "in yoga", "term": "yoga" },
      { "sa": "tu", "en": "but" },
      { "sa": "imām", "en": "this" },
      { "sa": "śṛṇu", "en": "hear" },
      { "sa": "buddhyā", "en": "with buddhi", "term": "buddhi" },
      { "sa": "yuktaḥ", "en": "yoked", "term": "yoga" },
      { "sa": "yayā", "en": "with which" },
      { "sa": "pārtha", "en": "O son of Pṛthā" },
      { "sa": "karma-bandham", "en": "the bondage of action", "term": "karma" },
      { "sa": "prahāsyasi", "en": "you will cast off" }
    ],
    "translation": "This buddhi has been declared to you in sāṅkhya. But hear this in yoga, the buddhi yoked with which, O son of Pṛthā, you will cast off the bondage of action."
  },
  "40": {
    "words": [
      { "sa": "na", "en": "not" },
      { "sa": "iha", "en": "here" },
      { "sa": "abhikrama-nāśaḥ", "en": "loss of what is begun" },
      { "sa": "asti", "en": "there is" },
      { "sa": "pratyavāyaḥ", "en": "a setback" },
      { "sa": "na", "en": "not" },
      { "sa": "vidyate", "en": "is found" },
      { "sa": "su-alpam", "en": "a very little" },
      { "sa": "api", "en": "even" },
      { "sa": "asya", "en": "of this" },
      { "sa": "dharmasya", "en": "of dharma", "term": "dharma" },
      { "sa": "trāyate", "en": "protects" },
      { "sa": "mahataḥ", "en": "from great" },
      { "sa": "bhayāt", "en": "from fear" }
    ],
    "translation": "Here there is no loss of what is begun, and no setback is found. Even a very little of this dharma protects from great fear."
  },
  "41": {
    "words": [
      { "sa": "vyavasāya-ātmikā", "en": "whose nature is resolve" },
      { "sa": "buddhiḥ", "en": "buddhi", "term": "buddhi" },
      { "sa": "ekā", "en": "one" },
      { "sa": "iha", "en": "here" },
      { "sa": "kuru-nandana", "en": "O joy of the Kurus" },
      { "sa": "bahu-śākhāḥ", "en": "many-branched" },
      { "sa": "hi", "en": "for" },
      { "sa": "anantāḥ", "en": "endless" },
      { "sa": "ca", "en": "and" },
      { "sa": "buddhayaḥ", "en": "the buddhis", "term": "buddhi" },
      { "sa": "avyavasāyinām", "en": "of the irresolute" }
    ],
    "translation": "The buddhi whose nature is resolve is one here, O joy of the Kurus. For the buddhis of the irresolute are many-branched and endless."
  },
  "42": {
    "words": [
      { "sa": "yām", "en": "which" },
      { "sa": "imām", "en": "this" },
      { "sa": "puṣpitām", "en": "flowery" },
      { "sa": "vācam", "en": "speech" },
      { "sa": "pravadanti", "en": "they proclaim" },
      { "sa": "avipaścitaḥ", "en": "the undiscerning" },
      { "sa": "veda-vāda-ratāḥ", "en": "delighting in the words of the Vedas" },
      { "sa": "pārtha", "en": "O son of Pṛthā" },
      { "sa": "na", "en": "not" },
      { "sa": "anyat", "en": "anything else" },
      { "sa": "asti", "en": "there is" },
      { "sa": "iti", "en": "thus" },
      { "sa": "vādinaḥ", "en": "saying" }
    ],
    "translation": "This is the flowery speech which the undiscerning proclaim, delighting in the words of the Vedas, O son of Pṛthā, saying thus: there is nothing else."
  },
  "43": {
    "words": [
      { "sa": "kāma-ātmānaḥ", "en": "whose nature is desire", "term": "kama" },
      { "sa": "svarga-parāḥ", "en": "holding heaven as the highest" },
      { "sa": "janma-karma-phala-pradām", "en": "giving birth as the fruit of action", "term": "karma" },
      { "sa": "kriyā-viśeṣa-bahulām", "en": "abounding in particular rites" },
      { "sa": "bhoga-aiśvarya-gatim", "en": "the attainment of enjoyment and lordship" },
      { "sa": "prati", "en": "toward" }
    ],
    "translation": "Their nature is desire and they hold heaven as the highest. That speech gives birth as the fruit of action and abounds in particular rites, toward the attainment of enjoyment and lordship."
  },
  "44": {
    "words": [
      { "sa": "bhoga-aiśvarya-prasaktānām", "en": "of those clinging to enjoyment and lordship" },
      { "sa": "tayā", "en": "by that" },
      { "sa": "apahṛta-cetasām", "en": "of those whose thought is carried away" },
      { "sa": "vyavasāya-ātmikā", "en": "whose nature is resolve" },
      { "sa": "buddhiḥ", "en": "buddhi", "term": "buddhi" },
      { "sa": "samādhau", "en": "in samādhi", "term": "samadhi" },
      { "sa": "na", "en": "not" },
      { "sa": "vidhīyate", "en": "is established" }
    ],
    "translation": "For those who cling to enjoyment and lordship, whose thought is carried away by that speech, the buddhi whose nature is resolve is not established in samādhi."
  },
  "45": {
    "words": [
      { "sa": "trai-guṇya-viṣayāḥ", "en": "having the three guṇas as their domain", "term": "guna" },
      { "sa": "vedāḥ", "en": "the Vedas" },
      { "sa": "nis-trai-guṇyaḥ", "en": "free of the three guṇas", "term": "guna" },
      { "sa": "bhava", "en": "be" },
      { "sa": "arjuna", "en": "O Arjuna" },
      { "sa": "nir-dvandvaḥ", "en": "free of the pairs of opposites" },
      { "sa": "nitya-sattva-sthaḥ", "en": "always standing in sattva", "term": "guna" },
      { "sa": "nir-yoga-kṣemaḥ", "en": "free of gaining and keeping" },
      { "sa": "ātma-vān", "en": "possessed of the self", "term": "atman" }
    ],
    "translation": "The Vedas have the three guṇas as their domain. Be free of the three guṇas, O Arjuna, free of the pairs of opposites, always standing in sattva, free of gaining and keeping, possessed of the self."
  },
  "46": {
    "words": [
      { "sa": "yāvān", "en": "as much" },
      { "sa": "arthaḥ", "en": "use" },
      { "sa": "uda-pāne", "en": "in a well" },
      { "sa": "sarvataḥ", "en": "on every side" },
      { "sa": "sampluta-udake", "en": "when water is flooding" },
      { "sa": "tāvān", "en": "so much" },
      { "sa": "sarveṣu", "en": "in all" },
      { "sa": "vedeṣu", "en": "in the Vedas" },
      { "sa": "brāhmaṇasya", "en": "for a brahmin" },
      { "sa": "vijānataḥ", "en": "who knows" }
    ],
    "translation": "As much use as there is in a well when water is flooding on every side, so much is there in all the Vedas for a brahmin who knows."
  },
  "49": {
    "words": [
      { "sa": "dūreṇa", "en": "by far" },
      { "sa": "hi", "en": "for" },
      { "sa": "avaram", "en": "lower" },
      { "sa": "karma", "en": "action", "term": "karma" },
      { "sa": "buddhi-yogāt", "en": "than the yoga of buddhi", "term": "buddhi" },
      { "sa": "dhanañjaya", "en": "O winner of wealth" },
      { "sa": "buddhau", "en": "in buddhi", "term": "buddhi" },
      { "sa": "śaraṇam", "en": "refuge" },
      { "sa": "anviccha", "en": "seek" },
      { "sa": "kṛpaṇāḥ", "en": "pitiable" },
      { "sa": "phala-hetavaḥ", "en": "those whose motive is the fruit" }
    ],
    "translation": "For action is by far lower than the yoga of buddhi, O winner of wealth. Seek refuge in buddhi. Pitiable are those whose motive is the fruit."
  },
  "50": {
    "words": [
      { "sa": "buddhi-yuktaḥ", "en": "one yoked with buddhi", "term": "buddhi" },
      { "sa": "jahāti", "en": "casts off" },
      { "sa": "iha", "en": "here" },
      { "sa": "ubhe", "en": "both" },
      { "sa": "sukṛta-duṣkṛte", "en": "good deeds and bad deeds" },
      { "sa": "tasmāt", "en": "therefore" },
      { "sa": "yogāya", "en": "to yoga", "term": "yoga" },
      { "sa": "yujyasva", "en": "yoke yourself", "term": "yoga" },
      { "sa": "yogaḥ", "en": "yoga", "term": "yoga" },
      { "sa": "karmasu", "en": "in actions", "term": "karma" },
      { "sa": "kauśalam", "en": "skill" }
    ],
    "translation": "One yoked with buddhi casts off here both good deeds and bad deeds. Therefore yoke yourself to yoga. Yoga is skill in actions."
  },
  "51": {
    "words": [
      { "sa": "karma-jam", "en": "born of action", "term": "karma" },
      { "sa": "buddhi-yuktāḥ", "en": "yoked with buddhi", "term": "buddhi" },
      { "sa": "hi", "en": "for" },
      { "sa": "phalam", "en": "the fruit" },
      { "sa": "tyaktvā", "en": "having abandoned" },
      { "sa": "manīṣiṇaḥ", "en": "the wise" },
      { "sa": "janma-bandha-vinirmuktāḥ", "en": "freed from the bondage of birth" },
      { "sa": "padam", "en": "the state" },
      { "sa": "gacchanti", "en": "they go to" },
      { "sa": "anāmayam", "en": "without affliction" }
    ],
    "translation": "For the wise, yoked with buddhi, having abandoned the fruit born of action, freed from the bondage of birth, go to the state without affliction."
  },
  "52": {
    "words": [
      { "sa": "yadā", "en": "when" },
      { "sa": "te", "en": "your" },
      { "sa": "moha-kalilam", "en": "the thicket of delusion" },

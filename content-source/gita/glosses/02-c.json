      { "sa": "vyatitariṣyati", "en": "will cross beyond" },
      { "sa": "tadā", "en": "then" },
      { "sa": "gantāsi", "en": "you will go" },
      { "sa": "nirvedam", "en": "to indifference" },
      { "sa": "śrotavyasya", "en": "toward what is to be heard" },
      { "sa": "śrutasya", "en": "toward what has been heard" },
      { "sa": "ca", "en": "and" }
    ],
    "translation": "When your buddhi will cross beyond the thicket of delusion, then you will go to indifference toward what is to be heard and toward what has been heard."
  },
  "53": {
    "words": [
      { "sa": "śruti-vipratipannā", "en": "perplexed by what is heard" },
      { "sa": "te", "en": "your" },
      { "sa": "yadā", "en": "when" },
      { "sa": "sthāsyati", "en": "will stand" },
      { "sa": "niścalā", "en": "unmoving" },
      { "sa": "samādhau", "en": "in samādhi", "term": "samadhi" },
      { "sa": "acalā", "en": "unshaken" },
      { "sa": "buddhiḥ", "en": "buddhi", "term": "buddhi" },
      { "sa": "tadā", "en": "then" },
      { "sa": "yogam", "en": "yoga", "term": "yoga" },
      { "sa": "avāpsyasi", "en": "you will attain" }
    ],
    "translation": "When your buddhi, perplexed by what is heard, will stand unmoving, unshaken in samādhi, then you will attain yoga."
  },
  "54": {
    "words": [
      { "sa": "sthita-prajñasya", "en": "of one whose wisdom is steady", "term": "sthitadhi" },
      { "sa": "kā", "en": "what" },
      { "sa": "bhāṣā", "en": "description" },
      { "sa": "samādhi-sthasya", "en": "of one standing in samādhi", "term": "samadhi" },
      { "sa": "keśava", "en": "O Keśava" },
      { "sa": "sthita-dhīḥ", "en": "one whose thought is steady", "term": "sthitadhi" },
      { "sa": "kim", "en": "how" },
      { "sa": "prabhāṣeta", "en": "would he speak" },
      { "sa": "kim", "en": "how" },
      { "sa": "āsīta", "en": "would he sit" },
      { "sa": "vrajeta", "en": "would he walk" },
      { "sa": "kim", "en": "how" }
    ],
    "translation": "What is the description of one whose wisdom is steady, of one standing in samādhi, O Keśava? How would one whose thought is steady speak, how would he sit, how would he walk?"
  },
  "55": {
    "words": [
      { "sa": "prajahāti", "en": "he casts off" },
      { "sa": "yadā", "en": "when" },
      { "sa": "kāmān", "en": "desires", "term": "kama" },
      { "sa": "sarvān", "en": "all" },
      { "sa": "pārtha", "en": "O son of Pṛthā" },
      { "sa": "manaḥ-gatān", "en": "gone into the mind", "term": "manas" },
      { "sa": "ātmani", "en": "in the self", "term": "atman" },
      { "sa": "eva", "en": "alone" },
      { "sa": "ātmanā", "en": "by the self", "term": "atman" },
      { "sa": "tuṣṭaḥ", "en": "content" },
      { "sa": "sthita-prajñaḥ", "en": "one whose wisdom is steady", "term": "sthitadhi" },
      { "sa": "tadā", "en": "then" },
      { "sa": "ucyate", "en": "he is called" }
    ],
    "translation": "When he casts off all desires gone into the mind, O son of Pṛthā, content in the self alone by the self, then he is called one whose wisdom is steady."
  },
  "57": {
    "words": [
      { "sa": "yaḥ", "en": "he who" },
      { "sa": "sarvatra", "en": "everywhere" },
      { "sa": "anabhisnehaḥ", "en": "without fondness" },
      { "sa": "tat", "en": "this" },
      { "sa": "tat", "en": "that" },
      { "sa": "prāpya", "en": "having met with" },
      { "sa": "śubha-aśubham", "en": "pleasant and unpleasant" },
      { "sa": "na", "en": "not" },
      { "sa": "abhinandati", "en": "rejoices" },
      { "sa": "na", "en": "not" },
      { "sa": "dveṣṭi", "en": "hates" },
      { "sa": "tasya", "en": "his" },
      { "sa": "prajñā", "en": "wisdom", "term": "prajna" },
      { "sa": "pratiṣṭhitā", "en": "firmly established" }
    ],
    "translation": "He who is without fondness everywhere, who, having met with this or that, pleasant and unpleasant, does not rejoice and does not hate, his wisdom is firmly established."
  },
  "58": {
    "words": [
      { "sa": "yadā", "en": "when" },
      { "sa": "saṁharate", "en": "draws in" },
      { "sa": "ca", "en": "and" },
      { "sa": "ayam", "en": "this one" },
      { "sa": "kūrmaḥ", "en": "a tortoise" },
      { "sa": "aṅgāni", "en": "limbs" },
      { "sa": "iva", "en": "like" },
      { "sa": "sarvaśaḥ", "en": "completely" },
      { "sa": "indriyāṇi", "en": "the senses", "term": "indriya" },
      { "sa": "indriya-arthebhyaḥ", "en": "from the objects of the senses", "term": "indriya" },
      { "sa": "tasya", "en": "his" },
      { "sa": "prajñā", "en": "wisdom", "term": "prajna" },
      { "sa": "pratiṣṭhitā", "en": "firmly established" }
    ],
    "translation": "And when this one completely draws in the senses from the objects of the senses, like a tortoise its limbs, his wisdom is firmly established."
  },
  "59": {
    "words": [
      { "sa": "viṣayāḥ", "en": "the objects" },
      { "sa": "vinivartante", "en": "turn away" },
      { "sa": "nirāhārasya", "en": "from one who takes no food" },
      { "sa": "dehinaḥ", "en": "from the embodied one", "term": "dehin" },
      { "sa": "rasa-varjam", "en": "except the taste" },
      { "sa": "rasaḥ", "en": "the taste" },
      { "sa": "api", "en": "even" },
      { "sa": "asya", "en": "his" },
      { "sa": "param", "en": "the supreme" },
      { "sa": "dṛṣṭvā", "en": "having seen" },
      { "sa": "nivartate", "en": "turns away" }
    ],
    "translation": "The objects turn away from the embodied one who takes no food, except the taste. Having seen the supreme, even his taste turns away."
  },
  "60": {
    "words": [
      { "sa": "yatataḥ", "en": "of one who strives" },
      { "sa": "hi", "en": "for" },
      { "sa": "api", "en": "even" },
      { "sa": "kaunteya", "en": "O son of Kuntī" },
      { "sa": "puruṣasya", "en": "of a man" },
      { "sa": "vipaścitaḥ", "en": "of a discerning one" },
      { "sa": "indriyāṇi", "en": "the senses", "term": "indriya" },
      { "sa": "pramāthīni", "en": "churning" },
      { "sa": "haranti", "en": "carry off" },
      { "sa": "prasabham", "en": "by force" },
      { "sa": "manaḥ", "en": "the mind", "term": "manas" }
    ],
    "translation": "For the churning senses carry off by force the mind even of a discerning man who strives, O son of Kuntī."
  },
  "61": {
    "words": [
      { "sa": "tāni", "en": "them" },
      { "sa": "sarvāṇi", "en": "all" },
      { "sa": "saṁyamya", "en": "having restrained" },
      { "sa": "yuktaḥ", "en": "yoked", "term": "yoga" },
      { "sa": "āsīta", "en": "he should sit" },
      { "sa": "mat-paraḥ", "en": "holding me as the highest" },
      { "sa": "vaśe", "en": "under control" },
      { "sa": "hi", "en": "for" },
      { "sa": "yasya", "en": "whose" },
      { "sa": "indriyāṇi", "en": "the senses", "term": "indriya" },
      { "sa": "tasya", "en": "his" },
      { "sa": "prajñā", "en": "wisdom", "term": "prajna" },
      { "sa": "pratiṣṭhitā", "en": "firmly established" }
    ],
    "translation": "Having restrained them all, he should sit yoked, holding me as the highest. For he whose senses are under control, his wisdom is firmly established."
  }
}

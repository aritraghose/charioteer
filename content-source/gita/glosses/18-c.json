      { "sa": "kalpate", "en": "he is fit" }
    ],
    "translation": "having let go of ego, force, pride, desire, anger and possession, without the sense of mine, at peace, he is fit for becoming brahman."
  },
  "54": {
    "words": [
      { "sa": "brahma-bhūtaḥ", "en": "having become brahman", "term": "brahman" },
      { "sa": "prasanna-ātmā", "en": "whose self is serene", "term": "atman" },
      { "sa": "na", "en": "not" },
      { "sa": "śocati", "en": "he grieves" },
      { "sa": "na", "en": "not" },
      { "sa": "kāṅkṣati", "en": "he longs" },
      { "sa": "samaḥ", "en": "the same", "term": "samatva" },
      { "sa": "sarveṣu", "en": "toward all" },
      { "sa": "bhūteṣu", "en": "toward beings" },
      { "sa": "mat-bhaktim", "en": "devotion to me" },
      { "sa": "labhate", "en": "he gains" },
      { "sa": "parām", "en": "supreme" }
    ],
    "translation": "Having become brahman, his self serene, he does not grieve and does not long. The same toward all beings, he gains supreme devotion to me."
  },

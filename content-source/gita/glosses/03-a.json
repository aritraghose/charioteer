{
  "1": {
    "words": [
      { "sa": "jyāyasī", "en": "superior" },
      { "sa": "cet", "en": "if" },
      { "sa": "karmaṇaḥ", "en": "to action", "term": "karma" },
      { "sa": "te", "en": "by you" },
      { "sa": "matā", "en": "thought" },
      { "sa": "buddhiḥ", "en": "buddhi", "term": "buddhi" },
      { "sa": "janārdana", "en": "O Janārdana" },
      { "sa": "tat", "en": "then" },
      { "sa": "kim", "en": "why" },
      { "sa": "karmaṇi", "en": "in action", "term": "karma" },
      { "sa": "ghore", "en": "terrible" },
      { "sa": "mām", "en": "me" },
      { "sa": "niyojayasi", "en": "you engage" },
      { "sa": "keśava", "en": "O Keśava" }
    ],
    "translation": "If buddhi is thought by you superior to action, O Janārdana, then why do you engage me in terrible action, O Keśava?"
  },
  "2": {
    "words": [
      { "sa": "vyāmiśreṇa", "en": "mixed" },
      { "sa": "iva", "en": "as if" },
      { "sa": "vākyena", "en": "by a statement" },
      { "sa": "buddhim", "en": "buddhi", "term": "buddhi" },
      { "sa": "mohayasi", "en": "you bewilder" },
      { "sa": "iva", "en": "as if" },
      { "sa": "me", "en": "my" },
      { "sa": "tat", "en": "that" },
      { "sa": "ekam", "en": "one thing" },
      { "sa": "vada", "en": "tell" },
      { "sa": "niścitya", "en": "having decided" },
      { "sa": "yena", "en": "by which" },
      { "sa": "śreyaḥ", "en": "the better" },
      { "sa": "aham", "en": "I" },
      { "sa": "āpnuyām", "en": "may reach" }
    ],
    "translation": "By a statement that is as if mixed, you as if bewilder my buddhi. Having decided, tell that one thing by which I may reach the better."
  },
  "3": {
    "words": [
      { "sa": "loke", "en": "in the world" },
      { "sa": "asmin", "en": "in this" },
      { "sa": "dvi-vidhā", "en": "of two kinds" },
      { "sa": "niṣṭhā", "en": "firm standing" },
      { "sa": "purā", "en": "formerly" },
      { "sa": "proktā", "en": "declared" },
      { "sa": "mayā", "en": "by me" },
      { "sa": "anagha", "en": "O sinless one" },
      { "sa": "jñāna-yogena", "en": "by the yoga of knowledge", "term": "yoga" },
      { "sa": "sāṅkhyānām", "en": "of the followers of sāṅkhya", "term": "sankhya" },
      { "sa": "karma-yogena", "en": "by the yoga of action", "term": "karma" },
      { "sa": "yoginām", "en": "of the yogīs", "term": "yoga" }
    ],
    "translation": "In this world a firm standing of two kinds was formerly declared by me, O sinless one: that of the followers of sāṅkhya by the yoga of knowledge, that of the yogīs by the yoga of action.",
    "notes": [
      "\"Formerly\" can mean long ago, at the beginning of things, or it can mean earlier in this same conversation."
    ]
  },
  "4": {
    "words": [
      { "sa": "na", "en": "not" },
      { "sa": "karmaṇām", "en": "of actions", "term": "karma" },
      { "sa": "anārambhāt", "en": "from not beginning" },
      { "sa": "naiṣkarmyam", "en": "actionlessness", "term": "karma" },
      { "sa": "puruṣaḥ", "en": "a person" },
      { "sa": "aśnute", "en": "reaches" },
      { "sa": "na", "en": "not" },
      { "sa": "ca", "en": "and" },
      { "sa": "saṁnyasanāt", "en": "from renouncing", "term": "sannyasa" },
      { "sa": "eva", "en": "alone" },
      { "sa": "siddhim", "en": "perfection" },
      { "sa": "samadhigacchati", "en": "he comes to" }
    ],
    "translation": "A person does not reach actionlessness from not beginning actions, and he does not come to perfection from renouncing alone."
  },
  "5": {
    "words": [
      { "sa": "na", "en": "not" },
      { "sa": "hi", "en": "for" },
      { "sa": "kaścit", "en": "anyone" },
      { "sa": "kṣaṇam", "en": "for a moment" },
      { "sa": "api", "en": "even" },
      { "sa": "jātu", "en": "ever" },
      { "sa": "tiṣṭhati", "en": "stays" },
      { "sa": "akarma-kṛt", "en": "not doing action", "term": "karma" },
      { "sa": "kāryate", "en": "is made to do" },
      { "sa": "hi", "en": "for" },
      { "sa": "avaśaḥ", "en": "without choice" },
      { "sa": "karma", "en": "action", "term": "karma" },
      { "sa": "sarvaḥ", "en": "everyone" },
      { "sa": "prakṛti-jaiḥ", "en": "born of nature" },
      { "sa": "guṇaiḥ", "en": "by the guṇas", "term": "guna" }
    ],
    "translation": "For no one ever stays even for a moment not doing action. For everyone, without choice, is made to do action by the guṇas born of nature."
  },
  "6": {
    "words": [
      { "sa": "karma-indriyāṇi", "en": "the organs of action", "term": "indriya" },
      { "sa": "saṁyamya", "en": "having restrained" },
      { "sa": "yaḥ", "en": "who" },
      { "sa": "āste", "en": "sits" },
      { "sa": "manasā", "en": "with the mind", "term": "manas" },
      { "sa": "smaran", "en": "remembering" },
      { "sa": "indriya-arthān", "en": "the objects of the senses", "term": "indriya" },
      { "sa": "vimūḍha-ātmā", "en": "one whose self is deluded", "term": "atman" },
      { "sa": "mithyā-ācāraḥ", "en": "one of false conduct" },
      { "sa": "saḥ", "en": "he" },
      { "sa": "ucyate", "en": "is called" }
    ],
    "translation": "Whoever sits, having restrained the organs of action, remembering with the mind the objects of the senses, he, one whose self is deluded, is called one of false conduct."
  },
  "7": {
    "words": [
      { "sa": "yaḥ", "en": "who" },
      { "sa": "tu", "en": "but" },
      { "sa": "indriyāṇi", "en": "the senses", "term": "indriya" },
      { "sa": "manasā", "en": "by the mind", "term": "manas" },
      { "sa": "niyamya", "en": "having controlled" },
      { "sa": "ārabhate", "en": "begins" },
      { "sa": "arjuna", "en": "O Arjuna" },
      { "sa": "karma-indriyaiḥ", "en": "with the organs of action", "term": "indriya" },
      { "sa": "karma-yogam", "en": "the yoga of action", "term": "karma" },
      { "sa": "asaktaḥ", "en": "unattached", "term": "sanga" },
      { "sa": "saḥ", "en": "he" },
      { "sa": "viśiṣyate", "en": "excels" }
    ],
    "translation": "But whoever, having controlled the senses by the mind, O Arjuna, begins the yoga of action with the organs of action, unattached, he excels."
  },
  "8": {
    "words": [
      { "sa": "niyatam", "en": "prescribed" },
      { "sa": "kuru", "en": "do" },
      { "sa": "karma", "en": "action", "term": "karma" },
      { "sa": "tvam", "en": "you" },
      { "sa": "karma", "en": "action", "term": "karma" },
      { "sa": "jyāyaḥ", "en": "superior" },
      { "sa": "hi", "en": "for" },
      { "sa": "akarmaṇaḥ", "en": "to non-action", "term": "karma" },
      { "sa": "śarīra-yātrā", "en": "the maintenance of the body" },
      { "sa": "api", "en": "even" },
      { "sa": "ca", "en": "and" },
      { "sa": "te", "en": "your" },
      { "sa": "na", "en": "not" },
      { "sa": "prasiddhyet", "en": "would succeed" },
      { "sa": "akarmaṇaḥ", "en": "from non-action", "term": "karma" }
    ],
    "translation": "You, do prescribed action, for action is superior to non-action. And even the maintenance of your body would not succeed from non-action.",
    "notes": [
      "\"Prescribed action\" can also be read as \"do action constantly\", taking the word to describe how one acts and not which action."
    ]
  },
  "9": {
    "words": [
      { "sa": "yajña-arthāt", "en": "for the purpose of sacrifice" },
      { "sa": "karmaṇaḥ", "en": "from action", "term": "karma" },
      { "sa": "anyatra", "en": "apart" },
      { "sa": "lokaḥ", "en": "world" },
      { "sa": "ayam", "en": "this" },
      { "sa": "karma-bandhanaḥ", "en": "bound by action", "term": "karma" },
      { "sa": "tad-artham", "en": "for that purpose" },
      { "sa": "karma", "en": "action", "term": "karma" },
      { "sa": "kaunteya", "en": "O son of Kuntī" },
      { "sa": "mukta-saṅgaḥ", "en": "freed from attachment", "term": "sanga" },
      { "sa": "samācara", "en": "perform" }
    ],
    "translation": "Apart from action for the purpose of sacrifice, this world is bound by action. Perform action for that purpose, O son of Kuntī, freed from attachment."
  },
  "10": {
    "words": [
      { "sa": "saha-yajñāḥ", "en": "together with sacrifice" },
      { "sa": "prajāḥ", "en": "creatures" },
      { "sa": "sṛṣṭvā", "en": "having created" },
      { "sa": "purā", "en": "formerly" },
      { "sa": "uvāca", "en": "said" },
      { "sa": "prajāpatiḥ", "en": "the lord of creatures" },
      { "sa": "anena", "en": "by this" },
      { "sa": "prasaviṣyadhvam", "en": "you shall bring forth" },
      { "sa": "eṣaḥ", "en": "this" },
      { "sa": "vaḥ", "en": "your" },
      { "sa": "astu", "en": "let it be" },
      { "sa": "iṣṭa-kāma-dhuk", "en": "yielding like milk the desires wished for", "term": "kama" }
    ],
    "translation": "Having created creatures together with sacrifice, the lord of creatures formerly said: by this you shall bring forth. Let this be yours, yielding like milk the desires wished for."
  },
  "11": {
    "words": [
      { "sa": "devān", "en": "the gods" },
      { "sa": "bhāvayata", "en": "nourish" },
      { "sa": "anena", "en": "by this" },
      { "sa": "te", "en": "those" },
      { "sa": "devāḥ", "en": "gods" },
      { "sa": "bhāvayantu", "en": "let them nourish" },
      { "sa": "vaḥ", "en": "you" },
      { "sa": "parasparam", "en": "one another" },
      { "sa": "bhāvayantaḥ", "en": "nourishing" },
      { "sa": "śreyaḥ", "en": "good" },
      { "sa": "param", "en": "the highest" },
      { "sa": "avāpsyatha", "en": "you will attain" }
    ],
    "translation": "Nourish the gods by this. Let those gods nourish you. Nourishing one another, you will attain the highest good."
  },
  "12": {
    "words": [
      { "sa": "iṣṭān", "en": "wished for" },
      { "sa": "bhogān", "en": "enjoyments" },
      { "sa": "hi", "en": "for" },
      { "sa": "vaḥ", "en": "to you" },
      { "sa": "devāḥ", "en": "the gods" },
      { "sa": "dāsyante", "en": "will give" },
      { "sa": "yajña-bhāvitāḥ", "en": "nourished by sacrifice" },
      { "sa": "taiḥ", "en": "by them" },
      { "sa": "dattān", "en": "the things given" },
      { "sa": "apradāya", "en": "without giving" },
      { "sa": "ebhyaḥ", "en": "to these" },
      { "sa": "yaḥ", "en": "who" },
      { "sa": "bhuṅkte", "en": "enjoys" },
      { "sa": "stenaḥ", "en": "a thief" },
      { "sa": "eva", "en": "only" },
      { "sa": "saḥ", "en": "he" }
    ],
    "translation": "For the gods, nourished by sacrifice, will give to you the enjoyments wished for. Whoever enjoys the things given by them without giving to these, he is only a thief."
  },
  "13": {
    "words": [
      { "sa": "yajña-śiṣṭa-āśinaḥ", "en": "eating what is left of the sacrifice" },
      { "sa": "santaḥ", "en": "the good" },
      { "sa": "mucyante", "en": "are freed" },
      { "sa": "sarva-kilbiṣaiḥ", "en": "from all faults" },
      { "sa": "bhuñjate", "en": "eat" },
      { "sa": "te", "en": "they" },
      { "sa": "tu", "en": "but" },
      { "sa": "agham", "en": "sin" },
      { "sa": "pāpāḥ", "en": "the wicked" },
      { "sa": "ye", "en": "who" },
      { "sa": "pacanti", "en": "cook" },
      { "sa": "ātma-kāraṇāt", "en": "for the sake of the self", "term": "atman" }
    ],
    "translation": "The good, eating what is left of the sacrifice, are freed from all faults. But the wicked who cook for the sake of the self, they eat sin.",
    "notes": [
      "\"For the sake of the self\" here most naturally means \"only for themselves\", with no deeper sense of the self intended."
    ]
  },
  "14": {
    "words": [
      { "sa": "annāt", "en": "from food" },
      { "sa": "bhavanti", "en": "come to be" },
      { "sa": "bhūtāni", "en": "beings" },
      { "sa": "parjanyāt", "en": "from rain" },
      { "sa": "anna-sambhavaḥ", "en": "the arising of food" },
      { "sa": "yajñāt", "en": "from sacrifice" },
      { "sa": "bhavati", "en": "comes to be" },
      { "sa": "parjanyaḥ", "en": "rain" },
      { "sa": "yajñaḥ", "en": "sacrifice" },
      { "sa": "karma-samudbhavaḥ", "en": "arising from action", "term": "karma" }
    ],
    "translation": "From food beings come to be. From rain is the arising of food. From sacrifice rain comes to be. Sacrifice is arising from action."
  },
  "15": {
    "words": [
      { "sa": "karma", "en": "action", "term": "karma" },
      { "sa": "brahma-udbhavam", "en": "arising from brahman", "term": "brahman" },
      { "sa": "viddhi", "en": "know" },
      { "sa": "brahma", "en": "brahman", "term": "brahman" },
      { "sa": "akṣara-samudbhavam", "en": "arising from the imperishable" },
      { "sa": "tasmāt", "en": "therefore" },
      { "sa": "sarva-gatam", "en": "all-pervading" },
      { "sa": "brahma", "en": "brahman", "term": "brahman" },
      { "sa": "nityam", "en": "always" },
      { "sa": "yajñe", "en": "in sacrifice" },
      { "sa": "pratiṣṭhitam", "en": "established" }
    ],
    "translation": "Know action as arising from brahman, and brahman as arising from the imperishable. Therefore the all-pervading brahman is always established in sacrifice.",
    "notes": [
      "\"Arising from brahman\" is often read with brahman meaning the Vedas, so that action arises from the Vedas and the Vedas from the imperishable. Others read brahman here as nature."
    ]
  },
  "16": {
    "words": [
      { "sa": "evam", "en": "thus" },
      { "sa": "pravartitam", "en": "set turning" },
      { "sa": "cakram", "en": "the wheel" },
      { "sa": "na", "en": "not" },
      { "sa": "anuvartayati", "en": "keeps turning" },
      { "sa": "iha", "en": "here" },
      { "sa": "yaḥ", "en": "who" },
      { "sa": "agha-āyuḥ", "en": "whose life is sin" },
      { "sa": "indriya-ārāmaḥ", "en": "whose delight is the senses", "term": "indriya" },
      { "sa": "mogham", "en": "in vain" },
      { "sa": "pārtha", "en": "O son of Pṛthā" },
      { "sa": "saḥ", "en": "he" },
      { "sa": "jīvati", "en": "lives" }
    ],
    "translation": "Whoever here does not keep turning the wheel thus set turning, whose life is sin, whose delight is the senses, he lives in vain, O son of Pṛthā."
  },
  "17": {
    "words": [
      { "sa": "yaḥ", "en": "who" },
      { "sa": "tu", "en": "but" },
      { "sa": "ātma-ratiḥ", "en": "whose delight is in the self", "term": "atman" },
      { "sa": "eva", "en": "alone" },
      { "sa": "syāt", "en": "would be" },
      { "sa": "ātma-tṛptaḥ", "en": "satisfied by the self", "term": "atman" },
      { "sa": "ca", "en": "and" },
      { "sa": "mānavaḥ", "en": "the human being" },
      { "sa": "ātmani", "en": "in the self", "term": "atman" },
      { "sa": "eva", "en": "alone" },
      { "sa": "ca", "en": "and" },
      { "sa": "santuṣṭaḥ", "en": "content" },
      { "sa": "tasya", "en": "for him" },
      { "sa": "kāryam", "en": "something to be done" },
      { "sa": "na", "en": "not" },
      { "sa": "vidyate", "en": "exists" }
    ],
    "translation": "But the human being who would be one whose delight is in the self alone, and satisfied by the self, and content in the self alone, for him something to be done does not exist."
  },
  "18": {
    "words": [
      { "sa": "na", "en": "not" },
      { "sa": "eva", "en": "indeed" },
      { "sa": "tasya", "en": "for him" },
      { "sa": "kṛtena", "en": "by what is done" },
      { "sa": "arthaḥ", "en": "a purpose" },
      { "sa": "na", "en": "not" },
      { "sa": "akṛtena", "en": "by what is not done" },
      { "sa": "iha", "en": "here" },
      { "sa": "kaścana", "en": "any" },
      { "sa": "na", "en": "not" },
      { "sa": "ca", "en": "and" },
      { "sa": "asya", "en": "for him" },
      { "sa": "sarva-bhūteṣu", "en": "among all beings" },
      { "sa": "kaścit", "en": "any" },
      { "sa": "artha-vyapāśrayaḥ", "en": "dependence for a purpose" }
    ],
    "translation": "For him there is indeed not any purpose here by what is done, nor by what is not done. And for him there is not any dependence for a purpose among all beings."
  },
  "19": {
    "words": [
      { "sa": "tasmāt", "en": "therefore" },
      { "sa": "asaktaḥ", "en": "unattached", "term": "sanga" },
      { "sa": "satatam", "en": "always" },
      { "sa": "kāryam", "en": "to be done" },
      { "sa": "karma", "en": "action", "term": "karma" },
      { "sa": "samācara", "en": "perform" },
      { "sa": "asaktaḥ", "en": "unattached", "term": "sanga" },
      { "sa": "hi", "en": "for" },
      { "sa": "ācaran", "en": "performing" },
      { "sa": "karma", "en": "action", "term": "karma" },
      { "sa": "param", "en": "the highest" },
      { "sa": "āpnoti", "en": "reaches" },
      { "sa": "pūruṣaḥ", "en": "a person" }
    ],
    "translation": "Therefore, unattached, always perform the action to be done. For performing action unattached, a person reaches the highest."
  },
  "20": {
    "words": [
      { "sa": "karmaṇā", "en": "by action", "term": "karma" },
      { "sa": "eva", "en": "alone" },
      { "sa": "hi", "en": "for" },
      { "sa": "saṁsiddhim", "en": "perfection" },
      { "sa": "āsthitāḥ", "en": "attained" },
      { "sa": "janaka-ādayaḥ", "en": "Janaka and the others" },
      { "sa": "loka-saṅgraham", "en": "the holding together of the world" },
      { "sa": "eva", "en": "only" },
      { "sa": "api", "en": "even" },
      { "sa": "sampaśyan", "en": "looking to" },
      { "sa": "kartum", "en": "to act" },
      { "sa": "arhasi", "en": "you ought" }
    ],
    "translation": "For by action alone Janaka and the others attained perfection. Even looking only to the holding together of the world, you ought to act.",
    "notes": [
      "\"The holding together of the world\" can also be read as \"the gathering of the people\", that is, keeping people on the right path and not the world in order."
    ]
  },
  "21": {
    "words": [
      { "sa": "yat", "en": "whatever" },
      { "sa": "yat", "en": "whatever" },
      { "sa": "ācarati", "en": "does" },
      { "sa": "śreṣṭhaḥ", "en": "the best one" },
      { "sa": "tat", "en": "that" },
      { "sa": "tat", "en": "that" },
      { "sa": "eva", "en": "very" },
      { "sa": "itaraḥ", "en": "other" },
      { "sa": "janaḥ", "en": "the person" },
      { "sa": "saḥ", "en": "he" },
      { "sa": "yat", "en": "what" },
      { "sa": "pramāṇam", "en": "standard" },
      { "sa": "kurute", "en": "makes" },
      { "sa": "lokaḥ", "en": "the world" },
      { "sa": "tat", "en": "that" },
      { "sa": "anuvartate", "en": "follows" }
    ],
    "translation": "Whatever the best one does, that very thing the other person does. What standard he makes, that the world follows."
  },
  "22": {
    "words": [
      { "sa": "na", "en": "not" },
      { "sa": "me", "en": "for me" },
      { "sa": "pārtha", "en": "O son of Pṛthā" },
      { "sa": "asti", "en": "there is" },
      { "sa": "kartavyam", "en": "to be done" },
      { "sa": "triṣu", "en": "in the three" },
      { "sa": "lokeṣu", "en": "in the worlds" },
      { "sa": "kiñcana", "en": "anything" },
      { "sa": "na", "en": "not" },
      { "sa": "anavāptam", "en": "unattained" },
      { "sa": "avāptavyam", "en": "to be attained" },
      { "sa": "varte", "en": "I am engaged" },
      { "sa": "eva", "en": "still" },
      { "sa": "ca", "en": "and" },
      { "sa": "karmaṇi", "en": "in action", "term": "karma" }
    ],
    "translation": "For me, O son of Pṛthā, there is not anything to be done in the three worlds, nor anything unattained to be attained, and still I am engaged in action."
  }
}

    "translation": "Those vowed to the gods go to the gods. Those vowed to the ancestors go to the ancestors. Those who sacrifice to the spirits go to the spirits. Those who sacrifice to me also go to me."
  },
  "26": {
    "words": [
      { "sa": "patram", "en": "a leaf" },
      { "sa": "puṣpam", "en": "a flower" },
      { "sa": "phalam", "en": "a fruit" },
      { "sa": "toyam", "en": "water" },
      { "sa": "yaḥ", "en": "whoever" },
      { "sa": "me", "en": "to me" },
      { "sa": "bhaktyā", "en": "with devotion" },
      { "sa": "prayacchati", "en": "offers" },
      { "sa": "tat", "en": "that" },
      { "sa": "aham", "en": "I" },
      { "sa": "bhakti-upahṛtam", "en": "brought with devotion" },

  "20": {
    "words": [
      { "sa": "trai-vidyāḥ", "en": "those who know the three Vedas" },
      { "sa": "mām", "en": "me" },
      { "sa": "soma-pāḥ", "en": "drinkers of soma" },
      { "sa": "pūta-pāpāḥ", "en": "cleansed of evil" },
      { "sa": "yajñaiḥ", "en": "with sacrifices" },
      { "sa": "iṣṭvā", "en": "having worshipped" },
      { "sa": "svar-gatim", "en": "the way to heaven" },
      { "sa": "prārthayante", "en": "they pray for" },
      { "sa": "te", "en": "they" },
      { "sa": "puṇyam", "en": "meritorious" },
      { "sa": "āsādya", "en": "having reached" },
      { "sa": "sura-indra-lokam", "en": "the world of the lord of the gods" },
      { "sa": "aśnanti", "en": "they eat" },
      { "sa": "divyān", "en": "heavenly" },
      { "sa": "divi", "en": "in heaven" },
      { "sa": "deva-bhogān", "en": "the enjoyments of the gods" }
    ],
    "translation": "Those who know the three Vedas, drinkers of soma, cleansed of evil, having worshipped me with sacrifices, pray for the way to heaven. Having reached the meritorious world of the lord of the gods, they eat in heaven the heavenly enjoyments of the gods.",
    "notes": ["\"The meritorious world of the lord of the gods\" can also be read as \"the world of the lord of the gods, the reward of their merit\"."]
  },
  "21": {
    "words": [
      { "sa": "te", "en": "they" },
      { "sa": "tam", "en": "that" },
      { "sa": "bhuktvā", "en": "having enjoyed" },
      { "sa": "svarga-lokam", "en": "the world of heaven" },
      { "sa": "viśālam", "en": "wide" },
      { "sa": "kṣīṇe", "en": "when spent" },
      { "sa": "puṇye", "en": "when merit" },
      { "sa": "martya-lokam", "en": "the world of mortals" },
      { "sa": "viśanti", "en": "they enter" },
      { "sa": "evam", "en": "thus" },
      { "sa": "trayī-dharmam", "en": "the dharma of the three Vedas", "term": "dharma" },
      { "sa": "anuprapannāḥ", "en": "following" },
      { "sa": "gata-āgatam", "en": "going and coming" },
      { "sa": "kāma-kāmāḥ", "en": "desiring desires", "term": "kama" },
      { "sa": "labhante", "en": "they get" }
    ],
    "translation": "Having enjoyed that wide world of heaven, when merit is spent they enter the world of mortals. Thus, following the dharma of the three Vedas, desiring desires, they get going and coming."
  },
  "22": {
    "words": [
      { "sa": "ananyāḥ", "en": "having no other" },
      { "sa": "cintayantaḥ", "en": "thinking of" },
      { "sa": "mām", "en": "me" },
      { "sa": "ye", "en": "who" },
      { "sa": "janāḥ", "en": "people" },
      { "sa": "paryupāsate", "en": "they worship fully" },
      { "sa": "teṣām", "en": "of them" },
      { "sa": "nitya-abhiyuktānām", "en": "of the ever joined", "term": "yoga" },
      { "sa": "yoga-kṣemam", "en": "gaining and keeping", "term": "yoga" },
      { "sa": "vahāmi", "en": "I carry" },
      { "sa": "aham", "en": "I" }
    ],
    "translation": "The people who, having no other, thinking of me, worship me fully: of them, the ever joined, I carry the gaining and keeping.",
    "notes": ["\"The gaining and keeping\" can also be read as \"the yoga and the safety\"."]
  },
  "23": {
    "words": [
      { "sa": "ye", "en": "who" },
      { "sa": "api", "en": "even" },
      { "sa": "anya-devatāḥ", "en": "other gods" },
      { "sa": "bhaktāḥ", "en": "devotees" },
      { "sa": "yajante", "en": "they worship" },
      { "sa": "śraddhayā", "en": "with faith" },
      { "sa": "anvitāḥ", "en": "filled" },
      { "sa": "te", "en": "they" },
      { "sa": "api", "en": "too" },
      { "sa": "mām", "en": "me" },
      { "sa": "eva", "en": "only" },
      { "sa": "kaunteya", "en": "O son of Kuntī" },
      { "sa": "yajanti", "en": "they worship" },
      { "sa": "avidhi-pūrvakam", "en": "not according to rule" }
    ],
    "translation": "Even the devotees who, filled with faith, worship other gods, they too worship only me, O son of Kuntī, not according to rule.",
    "notes": ["\"The devotees who, filled with faith, worship other gods\" can also be read as \"those who are devoted to other gods and worship filled with faith\"."]
  },
  "24": {
    "words": [
      { "sa": "aham", "en": "I" },
      { "sa": "hi", "en": "for" },
      { "sa": "sarva-yajñānām", "en": "of all sacrifices" },
      { "sa": "bhoktā", "en": "the enjoyer" },
      { "sa": "ca", "en": "and" },
      { "sa": "prabhuḥ", "en": "the lord" },
      { "sa": "eva", "en": "indeed" },
      { "sa": "ca", "en": "and" },
      { "sa": "na", "en": "not" },
      { "sa": "tu", "en": "but" },
      { "sa": "mām", "en": "me" },
      { "sa": "abhijānanti", "en": "they know" },
      { "sa": "tattvena", "en": "in truth" },

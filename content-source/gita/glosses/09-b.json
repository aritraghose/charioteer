      { "sa": "cyavanti", "en": "they fall" },
      { "sa": "te", "en": "they" }
    ],
    "translation": "For I am the enjoyer and indeed the lord of all sacrifices. But they do not know me in truth, therefore they fall."
  },
  "25": {
    "words": [
      { "sa": "yānti", "en": "they go" },
      { "sa": "deva-vratāḥ", "en": "those vowed to the gods" },
      { "sa": "devān", "en": "to the gods" },
      { "sa": "pitṝn", "en": "to the ancestors" },
      { "sa": "yānti", "en": "they go" },
      { "sa": "pitṛ-vratāḥ", "en": "those vowed to the ancestors" },
      { "sa": "bhūtāni", "en": "to the spirits" },
      { "sa": "yānti", "en": "they go" },
      { "sa": "bhūta-ijyāḥ", "en": "those who sacrifice to the spirits" },
      { "sa": "yānti", "en": "they go" },
      { "sa": "mat-yājinaḥ", "en": "those who sacrifice to me" },
      { "sa": "api", "en": "also" },
      { "sa": "mām", "en": "to me" }

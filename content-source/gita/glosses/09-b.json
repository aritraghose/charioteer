      { "sa": "yat", "en": "whatever" },
      { "sa": "juhoṣi", "en": "you pour in sacrifice" },
      { "sa": "dadāsi", "en": "you give" },
      { "sa": "yat", "en": "whatever" },
      { "sa": "yat", "en": "whatever" },
      { "sa": "tapasyasi", "en": "you practise as austerity" },
      { "sa": "kaunteya", "en": "O son of Kuntī" },
      { "sa": "tat", "en": "that" },
      { "sa": "kuruṣva", "en": "do" },
      { "sa": "mat-arpaṇam", "en": "as an offering to me" }
    ],
    "translation": "Whatever you do, whatever you eat, whatever you pour in sacrifice, whatever you give, whatever you practise as austerity, O son of Kuntī, do that as an offering to me."
  },
  "28": {
    "words": [
      { "sa": "śubha-aśubha-phalaiḥ", "en": "having good and bad fruits" },
      { "sa": "evam", "en": "thus" },
      { "sa": "mokṣyase", "en": "you will be freed" },
      { "sa": "karma-bandhanaiḥ", "en": "from the bonds of action", "term": "karma" },
      { "sa": "saṁnyāsa-yoga-yukta-ātmā", "en": "with the self joined to the yoga of renunciation", "term": "sannyasa" },
      { "sa": "vimuktaḥ", "en": "set free" },
      { "sa": "mām", "en": "to me" },
      { "sa": "upaiṣyasi", "en": "you will come" }
    ],
    "translation": "Thus you will be freed from the bonds of action, which have good and bad fruits. With the self joined to the yoga of renunciation, set free, you will come to me."
  },
  "29": {
    "words": [

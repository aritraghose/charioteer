      { "sa": "bhartā", "en": "the supporter" },
      { "sa": "prabhuḥ", "en": "the lord" },
      { "sa": "sākṣī", "en": "the witness" },
      { "sa": "nivāsaḥ", "en": "the dwelling" },
      { "sa": "śaraṇam", "en": "the refuge" },
      { "sa": "suhṛt", "en": "the friend" },
      { "sa": "prabhavaḥ", "en": "the origin" },
      { "sa": "pralayaḥ", "en": "the dissolution" },
      { "sa": "sthānam", "en": "the ground" },
      { "sa": "nidhānam", "en": "the storehouse" },
      { "sa": "bījam", "en": "the seed" },
      { "sa": "avyayam", "en": "imperishable" }
    ],
    "translation": "The goal, the supporter, the lord, the witness, the dwelling, the refuge, the friend, the origin, the dissolution, the ground, the storehouse, the imperishable seed."
  },
  "19": {
    "words": [
      { "sa": "tapāmi", "en": "I give heat" },
      { "sa": "aham", "en": "I" },
      { "sa": "aham", "en": "I" },
      { "sa": "varṣam", "en": "the rain" },
      { "sa": "nigṛhṇāmi", "en": "I hold back" },
      { "sa": "utsṛjāmi", "en": "I send forth" },
      { "sa": "ca", "en": "and" },
      { "sa": "amṛtam", "en": "deathlessness" },
      { "sa": "ca", "en": "and" },
      { "sa": "eva", "en": "indeed" },
      { "sa": "mṛtyuḥ", "en": "death" },
      { "sa": "ca", "en": "and" },
      { "sa": "sat", "en": "what is" },
      { "sa": "asat", "en": "what is not" },
      { "sa": "ca", "en": "and" },
      { "sa": "aham", "en": "I" },
      { "sa": "arjuna", "en": "O Arjuna" }

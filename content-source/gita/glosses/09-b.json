      { "sa": "me", "en": "to me" },
      { "sa": "dveṣyaḥ", "en": "hateful" },
      { "sa": "asti", "en": "there is" },
      { "sa": "na", "en": "not" },
      { "sa": "priyaḥ", "en": "dear" },
      { "sa": "ye", "en": "who" },
      { "sa": "bhajanti", "en": "they worship" },
      { "sa": "tu", "en": "but" },
      { "sa": "mām", "en": "me" },
      { "sa": "bhaktyā", "en": "with devotion" },
      { "sa": "mayi", "en": "in me" },
      { "sa": "te", "en": "they" },
      { "sa": "teṣu", "en": "in them" },
      { "sa": "ca", "en": "and" },
      { "sa": "api", "en": "too" },
      { "sa": "aham", "en": "I" }

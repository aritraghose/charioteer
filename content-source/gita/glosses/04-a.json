      { "sa": "hi", "en": "for" },
      { "sa": "api", "en": "also" },
      { "sa": "boddhavyam", "en": "is to be understood" },
      { "sa": "boddhavyam", "en": "is to be understood" },
      { "sa": "ca", "en": "and" },
      { "sa": "vikarmaṇaḥ", "en": "of wrong action", "term": "karma" },
      { "sa": "akarmaṇaḥ", "en": "of non-action", "term": "karma" },
      { "sa": "ca", "en": "and" },
      { "sa": "boddhavyam", "en": "is to be understood" },
      { "sa": "gahanā", "en": "deep" },
      { "sa": "karmaṇaḥ", "en": "of action", "term": "karma" },
      { "sa": "gatiḥ", "en": "the course" }
    ],
    "translation": "For there is something to be understood of action also, and to be understood of wrong action, and to be understood of non-action. Deep is the course of action.",
    "notes": [
      "\"Wrong action\" can also be read as \"action of various kinds\"."
    ]
  },
  "18": {
    "words": [
      { "sa": "karmaṇi", "en": "in action", "term": "karma" },
      { "sa": "akarma", "en": "non-action", "term": "karma" },
      { "sa": "yaḥ", "en": "who" },
      { "sa": "paśyet", "en": "would see" },
      { "sa": "akarmaṇi", "en": "in non-action", "term": "karma" },
      { "sa": "ca", "en": "and" },
      { "sa": "karma", "en": "action", "term": "karma" },
      { "sa": "yaḥ", "en": "who" },
      { "sa": "saḥ", "en": "he" },
      { "sa": "buddhimān", "en": "possessed of buddhi", "term": "buddhi" },
      { "sa": "manuṣyeṣu", "en": "among human beings" },
      { "sa": "saḥ", "en": "he" },
      { "sa": "yuktaḥ", "en": "joined in yoga", "term": "yoga" },
      { "sa": "kṛtsna-karma-kṛt", "en": "a doer of all action", "term": "karma" }
    ],
    "translation": "One who would see non-action in action, and who would see action in non-action, he is possessed of buddhi among human beings. He is joined in yoga, a doer of all action.",
    "notes": [
      "\"A doer of all action\" can also be read as \"one who has done all there is to do\"."
    ]
  },
  "19": {
    "words": [
      { "sa": "yasya", "en": "whose" },
      { "sa": "sarve", "en": "all" },
      { "sa": "samārambhāḥ", "en": "undertakings" },
      { "sa": "kāma-saṅkalpa-varjitāḥ", "en": "free from desire and purpose", "term": "kama" },
      { "sa": "jñāna-agni-dagdha-karmāṇam", "en": "whose action is burnt by the fire of knowledge", "term": "karma" },
      { "sa": "tam", "en": "him" },
      { "sa": "āhuḥ", "en": "they call" },
      { "sa": "paṇḍitam", "en": "learned" },
      { "sa": "budhāḥ", "en": "the wise" }
    ],
    "translation": "One whose undertakings are all free from desire and purpose, whose action is burnt by the fire of knowledge, him the wise call learned.",
    "notes": [
      "\"Free from desire and purpose\" can also be read as \"free from purposes born of desire\"."
    ]
  },
  "20": {
    "words": [
      { "sa": "tyaktvā", "en": "having given up" },
      { "sa": "karma-phala-āsaṅgam", "en": "attachment to the fruit of action", "term": "sanga" },
      { "sa": "nitya-tṛptaḥ", "en": "always content" },
      { "sa": "nirāśrayaḥ", "en": "without dependence" },
      { "sa": "karmaṇi", "en": "in action", "term": "karma" },
      { "sa": "abhipravṛttaḥ", "en": "engaged" },
      { "sa": "api", "en": "even though" },
      { "sa": "na", "en": "not" },
      { "sa": "eva", "en": "at all" },
      { "sa": "kiñcit", "en": "anything" },
      { "sa": "karoti", "en": "does" },
      { "sa": "saḥ", "en": "he" }
    ],
    "translation": "Having given up attachment to the fruit of action, always content, without dependence, even though engaged in action, he does not do anything at all."
  },
  "21": {
    "words": [
      { "sa": "nirāśīḥ", "en": "without wishes" },
      { "sa": "yata-citta-ātmā", "en": "whose thought and self are restrained", "term": "atman" },
      { "sa": "tyakta-sarva-parigrahaḥ", "en": "who has given up all possessions" },
      { "sa": "śārīram", "en": "bodily" },
      { "sa": "kevalam", "en": "only" },
      { "sa": "karma", "en": "action", "term": "karma" },
      { "sa": "kurvan", "en": "doing" },
      { "sa": "na", "en": "not" },
      { "sa": "āpnoti", "en": "incurs" },
      { "sa": "kilbiṣam", "en": "fault" }
    ],
    "translation": "Without wishes, one whose thought and self are restrained, who has given up all possessions, doing only bodily action, does not incur fault.",
    "notes": [
      "\"Only bodily action\" can also be read as \"action only for keeping the body alive\".",
      "\"All possessions\" can also be read as \"all grasping\"."
    ]
  }
}

      { "sa": "mayā", "en": "by me" },
      { "sa": "sṛṣṭam", "en": "sent forth" },
      { "sa": "guṇa-karma-vibhāgaśaḥ", "en": "according to the division of qualities and actions", "term": "guna" },
      { "sa": "tasya", "en": "of it" },
      { "sa": "kartāram", "en": "the maker" },
      { "sa": "api", "en": "though" },
      { "sa": "mām", "en": "me" },
      { "sa": "viddhi", "en": "know" },
      { "sa": "akartāram", "en": "a non-maker" },
      { "sa": "avyayam", "en": "imperishable" }
    ],
    "translation": "The order of four classes was sent forth by me according to the division of qualities and actions. Though I am the maker of it, know me as an imperishable non-maker.",
    "notes": [
      "\"Maker\" and \"non-maker\" can also be read as \"doer\" and \"non-doer\"."
    ]
  },

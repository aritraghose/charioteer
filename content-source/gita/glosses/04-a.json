      { "sa": "na", "en": "not" },
      { "sa": "me", "en": "of me, for me" },
      { "sa": "karma-phale", "en": "for the fruit of action", "term": "karma" },
      { "sa": "spṛhā", "en": "a craving" },
      { "sa": "iti", "en": "thus" },
      { "sa": "mām", "en": "me" },
      { "sa": "yaḥ", "en": "who" },
      { "sa": "abhijānāti", "en": "recognises" },
      { "sa": "karmabhiḥ", "en": "by actions", "term": "karma" },
      { "sa": "na", "en": "not" },
      { "sa": "saḥ", "en": "he" },
      { "sa": "badhyate", "en": "is bound" }
    ],
    "translation": "Actions do not stain me. There is for me no craving for the fruit of action. One who recognises me thus, he is not bound by actions."
  },

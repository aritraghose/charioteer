      { "sa": "yogaḥ", "en": "yoga", "term": "yoga" },
      { "sa": "proktaḥ", "en": "declared" },
      { "sa": "purātanaḥ", "en": "ancient" },
      { "sa": "bhaktaḥ", "en": "devoted" },
      { "sa": "asi", "en": "you are" },

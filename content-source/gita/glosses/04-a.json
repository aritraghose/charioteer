      { "sa": "yadā", "en": "whenever" },
      { "sa": "hi", "en": "for" },
      { "sa": "dharmasya", "en": "of dharma", "term": "dharma" },
      { "sa": "glāniḥ", "en": "a decline" },
      { "sa": "bhavati", "en": "there is" },
      { "sa": "bhārata", "en": "O descendant of Bharata" },
      { "sa": "abhyutthānam", "en": "a rising up" },
      { "sa": "adharmasya", "en": "of what is not dharma", "term": "dharma" },
      { "sa": "tadā", "en": "then" },
      { "sa": "ātmānam", "en": "the self", "term": "atman" },
      { "sa": "sṛjāmi", "en": "I send forth" },
      { "sa": "aham", "en": "I" }
    ],
    "translation": "For whenever, whenever there is a decline of dharma, O descendant of Bharata, and a rising up of what is not dharma, then I send forth the self.",
    "notes": [
      "\"I send forth the self\" can also be read as \"I send forth myself\"."
    ]
  },
  "8": {
    "words": [
      { "sa": "paritrāṇāya", "en": "for the protection" },
      { "sa": "sādhūnām", "en": "of the good" },
      { "sa": "vināśāya", "en": "for the destruction" },
      { "sa": "ca", "en": "and" },
      { "sa": "duṣkṛtām", "en": "of the doers of evil" },
      { "sa": "dharma-saṁsthāpana-arthāya", "en": "for the purpose of establishing dharma", "term": "dharma" },
      { "sa": "sambhavāmi", "en": "I come into being" },
      { "sa": "yuge", "en": "in age" },
      { "sa": "yuge", "en": "in age" }
    ],
    "translation": "For the protection of the good and for the destruction of the doers of evil, for the purpose of establishing dharma, I come into being in age after age."
  },
  "9": {

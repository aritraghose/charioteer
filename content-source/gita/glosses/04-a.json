    "translation": "That very same ancient yoga is declared by me to you today, for this reason: you are devoted to me and my friend. For this is the highest secret."
  },
  "4": {
    "words": [
      { "sa": "aparam", "en": "later" },
      { "sa": "bhavataḥ", "en": "of you" },
      { "sa": "janma", "en": "birth" },
      { "sa": "param", "en": "earlier" },
      { "sa": "janma", "en": "birth" },
      { "sa": "vivasvataḥ", "en": "of Vivasvān" },
      { "sa": "katham", "en": "how" },
      { "sa": "etat", "en": "this" },
      { "sa": "vijānīyām", "en": "should I understand" },
      { "sa": "tvam", "en": "you" },

      { "sa": "mām", "en": "me" },
      { "sa": "prapadyante", "en": "approach" },
      { "sa": "tān", "en": "them" },
      { "sa": "tathā", "en": "in that way" },
      { "sa": "eva", "en": "very" },
      { "sa": "bhajāmi", "en": "I receive" },
      { "sa": "aham", "en": "I" },
      { "sa": "mama", "en": "my" },
      { "sa": "vartma", "en": "path" },
      { "sa": "anuvartante", "en": "follow" },
      { "sa": "manuṣyāḥ", "en": "human beings" },
      { "sa": "pārtha", "en": "O son of Pṛthā" },
      { "sa": "sarvaśaḥ", "en": "in every way" }
    ],
    "translation": "In whatever way those who approach me do so, in that very way I receive them. Human beings follow my path in every way, O son of Pṛthā.",
    "notes": [
      "\"I receive them\" can also be read as \"I reward them\" or \"I am devoted to them\".",
      "\"In every way\" can also be read as \"everywhere\"."
    ]
  },
  "12": {
    "words": [
      { "sa": "kāṅkṣantaḥ", "en": "longing for" },
      { "sa": "karmaṇām", "en": "of actions", "term": "karma" },
      { "sa": "siddhim", "en": "the success" },
      { "sa": "yajante", "en": "they sacrifice to" },
      { "sa": "iha", "en": "here" },
      { "sa": "devatāḥ", "en": "the deities" },
      { "sa": "kṣipram", "en": "quickly" },
      { "sa": "hi", "en": "for" },
      { "sa": "mānuṣe", "en": "in the human" },
      { "sa": "loke", "en": "in the world" },
      { "sa": "siddhiḥ", "en": "success" },
      { "sa": "bhavati", "en": "comes to be" },
      { "sa": "karma-jā", "en": "born of action", "term": "karma" }
    ],
    "translation": "Longing for the success of actions, they sacrifice to the deities here. For in the human world success born of action comes to be quickly."
  },
  "13": {
    "words": [

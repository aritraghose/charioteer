      { "sa": "pūrvaiḥ", "en": "by the ancients" },
      { "sa": "api", "en": "even" },
      { "sa": "mumukṣubhiḥ", "en": "by those wishing to be free" },
      { "sa": "kuru", "en": "do" },
      { "sa": "karma", "en": "action", "term": "karma" },
      { "sa": "eva", "en": "indeed" },
      { "sa": "tasmāt", "en": "therefore" },
      { "sa": "tvam", "en": "you" },
      { "sa": "pūrvaiḥ", "en": "by the ancients" },
      { "sa": "pūrvataram", "en": "in earlier times" },
      { "sa": "kṛtam", "en": "done" }
    ],
    "translation": "Having known thus, action was done even by the ancients, by those wishing to be free. Therefore you indeed do action, as done by the ancients in earlier times."
  },

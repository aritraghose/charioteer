      { "sa": "akarma", "en": "non-action", "term": "karma" },
      { "sa": "iti", "en": "thus, about this" },
      { "sa": "kavayaḥ", "en": "the sages" },
      { "sa": "api", "en": "even" },
      { "sa": "atra", "en": "here" },
      { "sa": "mohitāḥ", "en": "confused" },
      { "sa": "tat", "en": "that" },
      { "sa": "te", "en": "to you" },
      { "sa": "karma", "en": "action", "term": "karma" },
      { "sa": "pravakṣyāmi", "en": "I will explain" },
      { "sa": "yat", "en": "which" },
      { "sa": "jñātvā", "en": "having known" },
      { "sa": "mokṣyase", "en": "you will be freed" },
      { "sa": "aśubhāt", "en": "from what is inauspicious" }
    ],
    "translation": "What is action? What is non-action? About this even the sages are confused here. I will explain to you that action, having known which you will be freed from what is inauspicious."
  },
  "17": {
    "words": [

      { "sa": "tava", "en": "of you" },
      { "sa": "ca", "en": "and" },
      { "sa": "arjuna", "en": "O Arjuna" },
      { "sa": "tāni", "en": "them" },
      { "sa": "aham", "en": "I" },
      { "sa": "veda", "en": "know" },
      { "sa": "sarvāṇi", "en": "all" },
      { "sa": "na", "en": "not" },
      { "sa": "tvam", "en": "you" },
      { "sa": "vettha", "en": "know" },
      { "sa": "parantapa", "en": "O scorcher of foes" }
    ],
    "translation": "Many births of me have passed, and of you, O Arjuna. I know them all. You do not know them, O scorcher of foes."
  },
  "6": {

      { "sa": "evam", "en": "thus" },
      { "sa": "yaḥ", "en": "who" },
      { "sa": "vetti", "en": "knows" },
      { "sa": "tattvataḥ", "en": "in truth" },
      { "sa": "tyaktvā", "en": "having left" },
      { "sa": "deham", "en": "the body" },
      { "sa": "punaḥ", "en": "again" },
      { "sa": "janma", "en": "to birth" },
      { "sa": "na", "en": "not" },
      { "sa": "eti", "en": "goes" },
      { "sa": "mām", "en": "to me" },

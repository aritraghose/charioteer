      { "sa": "mā", "en": "do not" },
      { "sa": "sma", "en": "at all" },
      { "sa": "gamaḥ", "en": "go" },
      { "sa": "pārtha", "en": "O son of Pṛthā" },
      { "sa": "na", "en": "not" },
      { "sa": "etat", "en": "this" },
      { "sa": "tvayi", "en": "in you" },
      { "sa": "upapadyate", "en": "is fitting" },
      { "sa": "kṣudram", "en": "petty" },
      { "sa": "hṛdaya-daurbalyam", "en": "weakness of heart" },

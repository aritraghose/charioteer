      { "sa": "yat", "en": "whether" },
      { "sa": "vā", "en": "or" },
      { "sa": "jayema", "en": "we should conquer" },
      { "sa": "yadi", "en": "if" },
      { "sa": "vā", "en": "or" },
      { "sa": "naḥ", "en": "us" },
      { "sa": "jayeyuḥ", "en": "they should conquer" },
      { "sa": "yān", "en": "whom" },
      { "sa": "eva", "en": "very" },
      { "sa": "hatvā", "en": "having slain" },
      { "sa": "na", "en": "not" },
      { "sa": "jijīviṣāmaḥ", "en": "we wish to live" },
      { "sa": "te", "en": "they" },
      { "sa": "avasthitāḥ", "en": "standing" },
      { "sa": "pramukhe", "en": "in front" },
      { "sa": "dhārtarāṣṭrāḥ", "en": "the sons of Dhṛtarāṣṭra" }
    ],
    "translation": "And we do not know this, which of the two is weightier for us: whether we should conquer, or if they should conquer us. The very ones whom having slain we do not wish to live, they are standing in front, the sons of Dhṛtarāṣṭra."
  },
  "7": {
    "words": [
      { "sa": "kārpaṇya-doṣa-upahata-svabhāvaḥ", "en": "whose own nature is struck down by the fault of wretchedness" },
      { "sa": "pṛcchāmi", "en": "I ask" },
      { "sa": "tvām", "en": "you" },
      { "sa": "dharma-sammūḍha-cetāḥ", "en": "whose mind is confused about dharma", "term": "dharma" },
      { "sa": "yat", "en": "what" },
      { "sa": "śreyaḥ", "en": "better" },
      { "sa": "syāt", "en": "would be" },
      { "sa": "niścitam", "en": "for certain" },
      { "sa": "brūhi", "en": "tell" },
      { "sa": "tat", "en": "that" },
      { "sa": "me", "en": "to me" },
      { "sa": "śiṣyaḥ", "en": "pupil" },
      { "sa": "te", "en": "your" },
      { "sa": "aham", "en": "I" },
      { "sa": "śādhi", "en": "instruct" },
      { "sa": "mām", "en": "me" },
      { "sa": "tvām", "en": "in you" },
      { "sa": "prapannam", "en": "who has taken refuge" }
    ],
    "translation": "I, whose own nature is struck down by the fault of wretchedness, whose mind is confused about dharma, ask you: what would be better, tell that to me for certain. I am your pupil. Instruct me, who has taken refuge in you."
  },
  "8": {

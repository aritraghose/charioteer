      { "sa": "ataḥ", "en": "from this" },
      { "sa": "param", "en": "onward" }
    ],
    "translation": "But indeed it is not that I ever was not, nor you, nor these lords of men. And indeed it is not that we all shall not be, from this onward."
  },
  "13": {
    "words": [
      { "sa": "dehinaḥ", "en": "of the embodied one", "term": "dehin" },
      { "sa": "asmin", "en": "in this" },
      { "sa": "yathā", "en": "just as" },
      { "sa": "dehe", "en": "in the body" },
      { "sa": "kaumāram", "en": "childhood" },
      { "sa": "yauvanam", "en": "youth" },
      { "sa": "jarā", "en": "old age" },
      { "sa": "tathā", "en": "so" },
      { "sa": "deha-antara-prāptiḥ", "en": "the attaining of another body" },
      { "sa": "dhīraḥ", "en": "the steadfast one" },
      { "sa": "tatra", "en": "about that" },
      { "sa": "na", "en": "not" },
      { "sa": "muhyati", "en": "is confused" }
    ],
    "translation": "Just as childhood, youth and old age are of the embodied one in this body, so is the attaining of another body. The steadfast one is not confused about that."
  },
  "15": {
    "words": [
      { "sa": "yam", "en": "whom" },
      { "sa": "hi", "en": "for" },
      { "sa": "na", "en": "not" },
      { "sa": "vyathayanti", "en": "disturb" },
      { "sa": "ete", "en": "these" },
      { "sa": "puruṣam", "en": "the man" },
      { "sa": "puruṣa-ṛṣabha", "en": "O bull among men" },
      { "sa": "sama-duḥkha-sukham", "en": "the same in pain and pleasure", "term": "samatva" },
      { "sa": "dhīram", "en": "steadfast" },
      { "sa": "saḥ", "en": "he" },
      { "sa": "amṛtatvāya", "en": "for deathlessness" },
      { "sa": "kalpate", "en": "is fit" }
    ],
    "translation": "For the man whom these do not disturb, O bull among men, the same in pain and pleasure, steadfast, he is fit for deathlessness."
  },
  "16": {
    "words": [
      { "sa": "na", "en": "not" },
      { "sa": "asataḥ", "en": "of what is not" },
      { "sa": "vidyate", "en": "is found" },
      { "sa": "bhāvaḥ", "en": "being" },
      { "sa": "na", "en": "not" },
      { "sa": "abhāvaḥ", "en": "non-being" },
      { "sa": "vidyate", "en": "is found" },
      { "sa": "sataḥ", "en": "of what is" },
      { "sa": "ubhayoḥ", "en": "of both" },
      { "sa": "api", "en": "even" },
      { "sa": "dṛṣṭaḥ", "en": "seen" },
      { "sa": "antaḥ", "en": "the end" },
      { "sa": "tu", "en": "but" },
      { "sa": "anayoḥ", "en": "of these two" },
      { "sa": "tattva-darśibhiḥ", "en": "by the seers of the truth" }
    ],
    "translation": "Being is not found of what is not. Non-being is not found of what is. But the end of even both of these two is seen by the seers of the truth."
  },
  "17": {
    "words": [
      { "sa": "avināśi", "en": "indestructible" },
      { "sa": "tu", "en": "but" },
      { "sa": "tat", "en": "that" },
      { "sa": "viddhi", "en": "know" },
      { "sa": "yena", "en": "by which" },
      { "sa": "sarvam", "en": "all" },
      { "sa": "idam", "en": "this" },
      { "sa": "tatam", "en": "pervaded" },
      { "sa": "vināśam", "en": "the destruction" },
      { "sa": "avyayasya", "en": "of the imperishable" },
      { "sa": "asya", "en": "of this" },
      { "sa": "na", "en": "not" },
      { "sa": "kaścit", "en": "anyone" },
      { "sa": "kartum", "en": "to bring about" },
      { "sa": "arhati", "en": "is able" }
    ],
    "translation": "But know that to be indestructible, by which all this is pervaded. Not anyone is able to bring about the destruction of this imperishable."
  },
  "18": {
    "words": [
      { "sa": "antavantaḥ", "en": "having an end" },
      { "sa": "ime", "en": "these" },
      { "sa": "dehāḥ", "en": "bodies" },
      { "sa": "nityasya", "en": "of the eternal" },
      { "sa": "uktāḥ", "en": "are said" },
      { "sa": "śarīriṇaḥ", "en": "of the embodied one", "term": "dehin" },
      { "sa": "anāśinaḥ", "en": "of the indestructible" },
      { "sa": "aprameyasya", "en": "of the immeasurable" },
      { "sa": "tasmāt", "en": "therefore" },
      { "sa": "yudhyasva", "en": "fight" },
      { "sa": "bhārata", "en": "O descendant of Bharata" }
    ],
    "translation": "These bodies of the eternal embodied one, of the indestructible, of the immeasurable, are said to be having an end. Therefore fight, O descendant of Bharata."
  }
}

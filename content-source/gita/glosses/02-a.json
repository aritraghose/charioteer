      { "sa": "madhusūdanaḥ", "en": "the slayer of Madhu" }
    ],
    "translation": "To him, thus overcome by pity, whose eyes were filled with tears and troubled, despairing, the slayer of Madhu spoke this speech."
  },
  "2": {
    "words": [
      { "sa": "kutaḥ", "en": "from where" },
      { "sa": "tvā", "en": "you" },
      { "sa": "kaśmalam", "en": "faintness of spirit" },
      { "sa": "idam", "en": "this" },
      { "sa": "viṣame", "en": "in difficulty" },

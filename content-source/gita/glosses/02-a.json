      { "sa": "bhaikṣyam", "en": "begged food" },
      { "sa": "api", "en": "even" },
      { "sa": "iha", "en": "here" },
      { "sa": "loke", "en": "in the world" },
      { "sa": "hatvā", "en": "having slain" },
      { "sa": "artha-kāmān", "en": "desirous of gain", "term": "kama" },
      { "sa": "tu", "en": "but" },
      { "sa": "gurūn", "en": "the teachers" },
      { "sa": "iha", "en": "here" },
      { "sa": "eva", "en": "right" },
      { "sa": "bhuñjīya", "en": "I would eat" },
      { "sa": "bhogān", "en": "enjoyments" },
      { "sa": "rudhira-pradigdhān", "en": "smeared with blood" }
    ],
    "translation": "For it is better to eat even begged food here in the world, not having slain the teachers of great dignity. But having slain the teachers, desirous of gain, I would eat right here enjoyments smeared with blood."
  },
  "6": {
    "words": [
      { "sa": "na", "en": "not" },
      { "sa": "ca", "en": "and" },
      { "sa": "etat", "en": "this" },
      { "sa": "vidmaḥ", "en": "we know" },
      { "sa": "katarat", "en": "which of the two" },
      { "sa": "naḥ", "en": "for us" },

      { "sa": "mama", "en": "my" },
      { "sa": "apanudyāt", "en": "would drive away" },
      { "sa": "yat", "en": "what" },
      { "sa": "śokam", "en": "grief" },
      { "sa": "ucchoṣaṇam", "en": "drying up" },
      { "sa": "indriyāṇām", "en": "of the senses", "term": "indriya" },
      { "sa": "avāpya", "en": "having obtained" },
      { "sa": "bhūmau", "en": "on earth" },
      { "sa": "asapatnam", "en": "without rival" },
      { "sa": "ṛddham", "en": "prosperous" },
      { "sa": "rājyam", "en": "kingdom" },
      { "sa": "surāṇām", "en": "of the gods" },

      { "sa": "ca", "en": "and" },
      { "sa": "ādhipatyam", "en": "lordship" }
    ],
    "translation": "For I do not see what would drive away my grief, the drying up of the senses, having obtained on earth a prosperous kingdom without rival, and even lordship of the gods."
  },
  "9": {
    "words": [
      { "sa": "evam", "en": "thus" },
      { "sa": "uktvā", "en": "having spoken" },
      { "sa": "hṛṣīkeśam", "en": "to the lord of the senses" },
      { "sa": "guḍākeśaḥ", "en": "the lord of sleep" },
      { "sa": "parantapa", "en": "O scorcher of foes" },
      { "sa": "na", "en": "not" },
      { "sa": "yotsye", "en": "I will fight" },
      { "sa": "iti", "en": "thus" },
      { "sa": "govindam", "en": "to Govinda" },
      { "sa": "uktvā", "en": "having said" },
      { "sa": "tūṣṇīm", "en": "silent" },
      { "sa": "babhūva", "en": "became" },
      { "sa": "ha", "en": "indeed" }
    ],
    "translation": "Having spoken thus to the lord of the senses, the lord of sleep, O scorcher of foes, having said to Govinda thus: \"I will not fight\", became silent indeed."
  },
  "10": {
    "words": [
      { "sa": "tam", "en": "to him" },
      { "sa": "uvāca", "en": "spoke" },
      { "sa": "hṛṣīkeśaḥ", "en": "the lord of the senses" },
      { "sa": "prahasan", "en": "smiling" },
      { "sa": "iva", "en": "as if" },
      { "sa": "bhārata", "en": "O descendant of Bharata" },
      { "sa": "senayoḥ", "en": "of the two armies" },
      { "sa": "ubhayoḥ", "en": "of both" },
      { "sa": "madhye", "en": "in the middle" },
      { "sa": "viṣīdantam", "en": "despairing" },
      { "sa": "idam", "en": "this" },
      { "sa": "vacaḥ", "en": "word" }

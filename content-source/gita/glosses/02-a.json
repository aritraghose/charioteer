      { "sa": "uttiṣṭha", "en": "stand up" },
      { "sa": "parantapa", "en": "O scorcher of foes" }
    ],
    "translation": "Do not go to unmanliness at all, O son of Pṛthā. This is not fitting in you. Having abandoned petty weakness of heart, stand up, O scorcher of foes."
  },
  "4": {
    "words": [
      { "sa": "katham", "en": "how" },
      { "sa": "bhīṣmam", "en": "against Bhīṣma" },
      { "sa": "aham", "en": "I" },
      { "sa": "saṅkhye", "en": "in battle" },
      { "sa": "droṇam", "en": "against Droṇa" },
      { "sa": "ca", "en": "and" },
      { "sa": "madhusūdana", "en": "O slayer of Madhu" },
      { "sa": "iṣubhiḥ", "en": "with arrows" },
      { "sa": "pratiyotsyāmi", "en": "shall I fight back" },
      { "sa": "pūjā-arhau", "en": "the two worthy of worship" },
      { "sa": "ari-sūdana", "en": "O slayer of enemies" }
    ],
    "translation": "How shall I fight back with arrows in battle against Bhīṣma and against Droṇa, O slayer of Madhu, the two worthy of worship, O slayer of enemies?"
  },
  "5": {
    "words": [
      { "sa": "gurūn", "en": "the teachers" },
      { "sa": "ahatvā", "en": "not having slain" },
      { "sa": "hi", "en": "for" },
      { "sa": "mahā-anubhāvān", "en": "of great dignity" },

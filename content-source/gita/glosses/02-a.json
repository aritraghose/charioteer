      { "sa": "na", "en": "not" },
      { "sa": "āsam", "en": "was" },
      { "sa": "na", "en": "nor" },
      { "sa": "tvam", "en": "you" },
      { "sa": "na", "en": "nor" },
      { "sa": "ime", "en": "these" },
      { "sa": "jana-adhipāḥ", "en": "lords of men" },
      { "sa": "na", "en": "not" },
      { "sa": "ca", "en": "and" },
      { "sa": "eva", "en": "indeed" },
      { "sa": "na", "en": "not" },
      { "sa": "bhaviṣyāmaḥ", "en": "shall be" },

      { "sa": "yat", "en": "whatever" },
      { "sa": "karma", "en": "action", "term": "karma" },
      { "sa": "prārabhate", "en": "undertakes" },
      { "sa": "naraḥ", "en": "a man" },
      { "sa": "nyāyyam", "en": "right" },
      { "sa": "vā", "en": "or" },
      { "sa": "viparītam", "en": "the opposite" },
      { "sa": "vā", "en": "or" },
      { "sa": "pañca", "en": "five" },
      { "sa": "ete", "en": "these" },
      { "sa": "tasya", "en": "of it" },
      { "sa": "hetavaḥ", "en": "the causes" }
    ],
    "translation": "Whatever action a man undertakes with body, speech and mind, right or the opposite, these five are the causes of it."
  },

      { "sa": "iti", "en": "thus" },
      { "sa": "eva", "en": "merely" },
      { "sa": "yat", "en": "whatever" },
      { "sa": "karma", "en": "action", "term": "karma" },
      { "sa": "niyatam", "en": "prescribed" },
      { "sa": "kriyate", "en": "is done" },
      { "sa": "arjuna", "en": "O Arjuna" },
      { "sa": "saṅgam", "en": "attachment", "term": "sanga" },
      { "sa": "tyaktvā", "en": "having given up" },
      { "sa": "phalam", "en": "the fruit" },
      { "sa": "ca", "en": "and" },
      { "sa": "eva", "en": "also" },
      { "sa": "saḥ", "en": "that" },
      { "sa": "tyāgaḥ", "en": "giving up" },
      { "sa": "sāttvikaḥ", "en": "of sattva", "term": "guna" },

      { "sa": "na", "en": "not" },
      { "sa": "ahaṅkṛtaḥ", "en": "made of the sense of I" },
      { "sa": "bhāvaḥ", "en": "state of being" },
      { "sa": "buddhiḥ", "en": "buddhi", "term": "buddhi" },
      { "sa": "yasya", "en": "whose" },
      { "sa": "na", "en": "not" },
      { "sa": "lipyate", "en": "is stained" },
      { "sa": "hatvā", "en": "having killed" },
      { "sa": "api", "en": "even" },
      { "sa": "saḥ", "en": "he" },
      { "sa": "imān", "en": "these" },
      { "sa": "lokān", "en": "worlds" },

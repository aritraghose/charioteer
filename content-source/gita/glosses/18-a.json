    ],
    "translation": "Whatever prescribed action is done merely as \"to be done\", O Arjuna, having given up attachment and also the fruit: that giving up is considered to be of sattva."
  },
  "10": {
    "words": [
      { "sa": "na", "en": "not" },
      { "sa": "dveṣṭi", "en": "he hates" },
      { "sa": "akuśalam", "en": "disagreeable" },
      { "sa": "karma", "en": "action", "term": "karma" },
      { "sa": "kuśale", "en": "to the agreeable" },
      { "sa": "na", "en": "not" },
      { "sa": "anuṣajjate", "en": "he clings", "term": "sanga" },
      { "sa": "tyāgī", "en": "the one who gives up" },
      { "sa": "sattva-samāviṣṭaḥ", "en": "filled with sattva", "term": "guna" },
      { "sa": "medhāvī", "en": "intelligent" },
      { "sa": "chinna-saṁśayaḥ", "en": "whose doubt is cut off" }

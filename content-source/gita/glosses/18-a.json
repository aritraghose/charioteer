      { "sa": "kartā", "en": "the doer" },
      { "sa": "karaṇam", "en": "the instrument" },
      { "sa": "ca", "en": "and" },
      { "sa": "pṛthak-vidham", "en": "of separate kinds" },
      { "sa": "vividhāḥ", "en": "various" },
      { "sa": "ca", "en": "and" },
      { "sa": "pṛthak", "en": "separate" },
      { "sa": "ceṣṭāḥ", "en": "movements" },
      { "sa": "daivam", "en": "the divine" },
      { "sa": "ca", "en": "and" },
      { "sa": "eva", "en": "indeed" },
      { "sa": "atra", "en": "here" },
      { "sa": "pañcamam", "en": "the fifth" }

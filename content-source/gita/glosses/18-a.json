      { "sa": "miśram", "en": "mixed" },
      { "sa": "ca", "en": "and" },
      { "sa": "tri-vidham", "en": "of three kinds" },
      { "sa": "karmaṇaḥ", "en": "of action", "term": "karma" },
      { "sa": "phalam", "en": "the fruit" },
      { "sa": "bhavati", "en": "it comes to be" },
      { "sa": "atyāginām", "en": "for those who do not give up" },
      { "sa": "pretya", "en": "after departing" },
      { "sa": "na", "en": "not" },
      { "sa": "tu", "en": "but" },

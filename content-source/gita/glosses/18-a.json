      { "sa": "api", "en": "even" },
      { "sa": "tu", "en": "but" },
      { "sa": "karmāṇi", "en": "actions", "term": "karma" },
      { "sa": "saṅgam", "en": "attachment", "term": "sanga" },
      { "sa": "tyaktvā", "en": "having given up" },
      { "sa": "phalāni", "en": "the fruits" },
      { "sa": "ca", "en": "and" },
      { "sa": "kartavyāni", "en": "to be done" },
      { "sa": "iti", "en": "thus" },
      { "sa": "me", "en": "my" },
      { "sa": "pārtha", "en": "O son of Pṛthā" },
      { "sa": "niścitam", "en": "settled" },
      { "sa": "matam", "en": "view" },
      { "sa": "uttamam", "en": "highest" }
    ],
    "translation": "But even these actions are to be done having given up attachment and the fruits. This, O son of Pṛthā, is my settled, highest view."
  },
  "7": {
    "words": [
      { "sa": "niyatasya", "en": "of prescribed" },
      { "sa": "tu", "en": "but" },
      { "sa": "saṁnyāsaḥ", "en": "renunciation", "term": "sannyasa" },
      { "sa": "karmaṇaḥ", "en": "of action", "term": "karma" },
      { "sa": "na", "en": "not" },
      { "sa": "upapadyate", "en": "is fitting" },
      { "sa": "mohāt", "en": "from delusion" },
      { "sa": "tasya", "en": "of it" },
      { "sa": "parityāgaḥ", "en": "the complete giving up" },
      { "sa": "tāmasaḥ", "en": "of tamas", "term": "guna" },
      { "sa": "parikīrtitaḥ", "en": "is declared" }
    ],
    "translation": "But renunciation of prescribed action is not fitting. The complete giving up of it from delusion is declared to be of tamas.",
    "notes": ["\"Prescribed action\" can also be read as \"necessary action\", meaning what one's own nature and place require."]
  },
  "8": {
    "words": [

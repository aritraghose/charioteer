      { "sa": "evam", "en": "thus" },
      { "sa": "sati", "en": "it being" },
      { "sa": "kartāram", "en": "as the doer" },
      { "sa": "ātmānam", "en": "the self", "term": "atman" },
      { "sa": "kevalam", "en": "alone" },
      { "sa": "tu", "en": "but" },
      { "sa": "yaḥ", "en": "who" },
      { "sa": "paśyati", "en": "sees" },
      { "sa": "akṛta-buddhitvāt", "en": "from having an unformed buddhi", "term": "buddhi" },

    "words": [
      { "sa": "yat", "en": "which" },
      { "sa": "tu", "en": "but" },
      { "sa": "kṛtsna-vat", "en": "as if the whole" },
      { "sa": "ekasmin", "en": "to one" },
      { "sa": "kārye", "en": "to an effect" },
      { "sa": "saktam", "en": "attached", "term": "sanga" },
      { "sa": "ahaitukam", "en": "without reason" },
      { "sa": "atattva-artha-vat", "en": "not having the truth as its object" },
      { "sa": "alpam", "en": "small" },
      { "sa": "ca", "en": "and" },
      { "sa": "tat", "en": "that" },
      { "sa": "tāmasam", "en": "of tamas", "term": "guna" },
      { "sa": "udāhṛtam", "en": "is said to be" }
    ],
    "translation": "But that which is attached to one effect as if it were the whole, without reason, not having the truth as its object, and small: that is said to be of tamas.",
    "notes": ["\"One effect\" can also be read as \"one task\"."]
  },
  "23": {
    "words": [

      { "sa": "iti", "en": "thus" },
      { "sa": "eva", "en": "merely" },
      { "sa": "yat", "en": "whatever" },
      { "sa": "karma", "en": "action", "term": "karma" },
      { "sa": "kāya-kleśa-bhayāt", "en": "from fear of trouble to the body" },
      { "sa": "tyajet", "en": "one would give up" },
      { "sa": "saḥ", "en": "he" },
      { "sa": "kṛtvā", "en": "having done" },
      { "sa": "rājasam", "en": "of rajas", "term": "guna" },
      { "sa": "tyāgam", "en": "a giving up" },
      { "sa": "na", "en": "not" },
      { "sa": "eva", "en": "at all" },
      { "sa": "tyāga-phalam", "en": "the fruit of giving up" },
      { "sa": "labhet", "en": "would obtain" }
    ],
    "translation": "Whatever action one would give up merely as \"painful\", from fear of trouble to the body: he, having done a giving up of rajas, would not at all obtain the fruit of giving up."
  },
  "9": {

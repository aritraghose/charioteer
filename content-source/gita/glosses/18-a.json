    ],
    "translation": "Knowledge, what is to be known and the knower: the urging to action is of three kinds. The instrument, the action and the doer: thus the sum of action is of three kinds."
  },
  "19": {
    "words": [
      { "sa": "jñānam", "en": "knowledge" },
      { "sa": "karma", "en": "action", "term": "karma" },
      { "sa": "ca", "en": "and" },
      { "sa": "kartā", "en": "the doer" },
      { "sa": "ca", "en": "and" },
      { "sa": "tridhā", "en": "in three ways" },
      { "sa": "eva", "en": "only" },
      { "sa": "guṇa-bhedataḥ", "en": "by the division of the guṇas", "term": "guna" },
      { "sa": "procyate", "en": "is declared" },
      { "sa": "guṇa-saṅkhyāne", "en": "in the reckoning of the guṇas", "term": "guna" },
      { "sa": "yathāvat", "en": "as they are" },

    "notes": ["\"These worlds\" can also be read as \"these people\"."]
  },
  "18": {
    "words": [
      { "sa": "jñānam", "en": "knowledge" },
      { "sa": "jñeyam", "en": "what is to be known" },
      { "sa": "parijñātā", "en": "the knower" },
      { "sa": "tri-vidhā", "en": "of three kinds" },
      { "sa": "karma-codanā", "en": "the urging to action", "term": "karma" },
      { "sa": "karaṇam", "en": "the instrument" },
      { "sa": "karma", "en": "the action", "term": "karma" },
      { "sa": "kartā", "en": "the doer" },
      { "sa": "iti", "en": "thus" },
      { "sa": "tri-vidhaḥ", "en": "of three kinds" },

  },
  "20": {
    "words": [
      { "sa": "sarva-bhūteṣu", "en": "in all beings" },
      { "sa": "yena", "en": "by which" },
      { "sa": "ekam", "en": "one" },
      { "sa": "bhāvam", "en": "being" },
      { "sa": "avyayam", "en": "imperishable" },
      { "sa": "īkṣate", "en": "one sees" },
      { "sa": "avibhaktam", "en": "undivided" },
      { "sa": "vibhakteṣu", "en": "in the divided" },
      { "sa": "tat", "en": "that" },
      { "sa": "jñānam", "en": "knowledge" },
      { "sa": "viddhi", "en": "know" },
      { "sa": "sāttvikam", "en": "of sattva", "term": "guna" }

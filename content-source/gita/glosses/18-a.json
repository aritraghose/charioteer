{
  "1": {
    "words": [
      { "sa": "saṁnyāsasya", "en": "of renunciation", "term": "sannyasa" },
      { "sa": "mahā-bāho", "en": "O mighty-armed one" },
      { "sa": "tattvam", "en": "the truth" },
      { "sa": "icchāmi", "en": "I wish" },
      { "sa": "veditum", "en": "to know" },
      { "sa": "tyāgasya", "en": "of giving up" },
      { "sa": "ca", "en": "and" },
      { "sa": "hṛṣīkeśa", "en": "O lord of the senses" },
      { "sa": "pṛthak", "en": "separately" },
      { "sa": "keśi-niṣūdana", "en": "O slayer of Keśī" }
    ],
    "translation": "O mighty-armed one, I wish to know the truth of renunciation, and of giving up, O lord of the senses, separately, O slayer of Keśī."
  },
  "2": {
    "words": [
      { "sa": "kāmyānām", "en": "of those done from desire", "term": "kama" },
      { "sa": "karmaṇām", "en": "of actions", "term": "karma" },
      { "sa": "nyāsam", "en": "the laying down" },
      { "sa": "saṁnyāsam", "en": "renunciation", "term": "sannyasa" },
      { "sa": "kavayaḥ", "en": "the poets" },
      { "sa": "viduḥ", "en": "they know" },
      { "sa": "sarva-karma-phala-tyāgam", "en": "the giving up of the fruit of all actions", "term": "karma" },
      { "sa": "prāhuḥ", "en": "they call" },
      { "sa": "tyāgam", "en": "giving up" },
      { "sa": "vicakṣaṇāḥ", "en": "the clear-sighted" }
    ],
    "translation": "The poets know the laying down of actions done from desire as renunciation. The clear-sighted call the giving up of the fruit of all actions giving up."
  },
  "3": {
    "words": [
      { "sa": "tyājyam", "en": "to be given up" },
      { "sa": "doṣa-vat", "en": "having fault" },
      { "sa": "iti", "en": "thus" },
      { "sa": "eke", "en": "some" },
      { "sa": "karma", "en": "action", "term": "karma" },
      { "sa": "prāhuḥ", "en": "they say" },
      { "sa": "manīṣiṇaḥ", "en": "thoughtful ones" },
      { "sa": "yajña-dāna-tapaḥ-karma", "en": "the action of sacrifice, giving and austerity", "term": "karma" },
      { "sa": "na", "en": "not" },
      { "sa": "tyājyam", "en": "to be given up" },
      { "sa": "iti", "en": "thus" },
      { "sa": "ca", "en": "and" },
      { "sa": "apare", "en": "others" }
    ],
    "translation": "Some thoughtful ones say: \"Action, having fault, is to be given up.\" And others: \"The action of sacrifice, giving and austerity is not to be given up.\"",
    "notes": ["\"Action, having fault, is to be given up\" can also be read as \"action is to be given up like a fault\"."]
  },
  "4": {
    "words": [
      { "sa": "niścayam", "en": "the settled conclusion" },
      { "sa": "śṛṇu", "en": "hear" },
      { "sa": "me", "en": "my" },
      { "sa": "tatra", "en": "there" },
      { "sa": "tyāge", "en": "about giving up" },
      { "sa": "bharata-sattama", "en": "O best of the Bharatas" },
      { "sa": "tyāgaḥ", "en": "giving up" },
      { "sa": "hi", "en": "for" },
      { "sa": "puruṣa-vyāghra", "en": "O tiger among men" },
      { "sa": "tri-vidhaḥ", "en": "of three kinds" },
      { "sa": "samprakīrtitaḥ", "en": "is declared" }
    ],
    "translation": "Hear my settled conclusion there, about giving up, O best of the Bharatas. For giving up, O tiger among men, is declared to be of three kinds."
  },
  "5": {
    "words": [
      { "sa": "yajña-dāna-tapaḥ-karma", "en": "the action of sacrifice, giving and austerity", "term": "karma" },
      { "sa": "na", "en": "not" },
      { "sa": "tyājyam", "en": "to be given up" },
      { "sa": "kāryam", "en": "to be done" },
      { "sa": "eva", "en": "indeed" },
      { "sa": "tat", "en": "that" },
      { "sa": "yajñaḥ", "en": "sacrifice" },
      { "sa": "dānam", "en": "giving" },
      { "sa": "tapaḥ", "en": "austerity" },
      { "sa": "ca", "en": "and" },
      { "sa": "eva", "en": "indeed" },
      { "sa": "pāvanāni", "en": "purifiers" },
      { "sa": "manīṣiṇām", "en": "of the thoughtful" }
    ],
    "translation": "The action of sacrifice, giving and austerity is not to be given up. That is indeed to be done. Sacrifice, giving and austerity are indeed purifiers of the thoughtful."
  },
  "6": {
    "words": [

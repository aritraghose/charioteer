      { "sa": "etāni", "en": "these" },
      { "sa": "mahā-bāho", "en": "O mighty-armed one" },
      { "sa": "kāraṇāni", "en": "causes" },
      { "sa": "nibodha", "en": "learn" },
      { "sa": "me", "en": "from me" },
      { "sa": "sāṅkhye", "en": "in the sāṅkhya", "term": "sankhya" },
      { "sa": "kṛta-ante", "en": "in the settled conclusion" },

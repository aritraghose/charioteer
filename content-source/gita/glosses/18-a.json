      { "sa": "hi", "en": "for" },
      { "sa": "deha-bhṛtā", "en": "by one who bears a body" },
      { "sa": "śakyam", "en": "possible" },
      { "sa": "tyaktum", "en": "to give up" },
      { "sa": "karmāṇi", "en": "actions", "term": "karma" },
      { "sa": "aśeṣataḥ", "en": "without remainder" },
      { "sa": "yaḥ", "en": "who" },
      { "sa": "tu", "en": "but" },
      { "sa": "karma-phala-tyāgī", "en": "one who gives up the fruit of action", "term": "karma" },
      { "sa": "saḥ", "en": "he" },
      { "sa": "tyāgī", "en": "one who gives up" },
      { "sa": "iti", "en": "thus" },
      { "sa": "abhidhīyate", "en": "is called" }

  },
  "21": {
    "words": [
      { "sa": "pṛthaktvena", "en": "by separateness" },
      { "sa": "tu", "en": "but" },
      { "sa": "yat", "en": "which" },
      { "sa": "jñānam", "en": "knowledge" },
      { "sa": "nānā-bhāvān", "en": "manifold beings" },
      { "sa": "pṛthak-vidhān", "en": "of separate kinds" },
      { "sa": "vetti", "en": "knows" },
      { "sa": "sarveṣu", "en": "in all" },
      { "sa": "bhūteṣu", "en": "in beings" },
      { "sa": "tat", "en": "that" },
      { "sa": "jñānam", "en": "knowledge" },
      { "sa": "viddhi", "en": "know" },
      { "sa": "rājasam", "en": "of rajas", "term": "guna" }
    ],
    "translation": "But the knowledge which, by separateness, knows manifold beings of separate kinds in all beings: know that knowledge to be of rajas."
  },

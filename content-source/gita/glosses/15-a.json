{
  "1": {
    "words": [
      { "sa": "ūrdhva-mūlam", "en": "with roots above" },
      { "sa": "adhaḥ-śākham", "en": "with branches below" },
      { "sa": "aśvattham", "en": "the sacred fig tree" },
      { "sa": "prāhuḥ", "en": "they speak of" },
      { "sa": "avyayam", "en": "undecaying" },
      { "sa": "chandāṁsi", "en": "the sacred hymns" },
      { "sa": "yasya", "en": "of which" },
      { "sa": "parṇāni", "en": "the leaves" },
      { "sa": "yaḥ", "en": "he who" },
      { "sa": "tam", "en": "it" },
      { "sa": "veda", "en": "knows" },
      { "sa": "saḥ", "en": "he" },
      { "sa": "veda-vit", "en": "a knower of the Vedas" }
    ],
    "translation": "They speak of the undecaying sacred fig tree with roots above and with branches below, of which the leaves are the sacred hymns. He who knows it, he is a knower of the Vedas."
  },
  "2": {
    "words": [
      { "sa": "adhaḥ", "en": "downward" },
      { "sa": "ca", "en": "and" },
      { "sa": "ūrdhvam", "en": "upward" },
      { "sa": "prasṛtāḥ", "en": "spread out" },
      { "sa": "tasya", "en": "of it" },
      { "sa": "śākhāḥ", "en": "the branches" },
      { "sa": "guṇa-pravṛddhāḥ", "en": "grown strong by the guṇas", "term": "guna" },
      { "sa": "viṣaya-pravālāḥ", "en": "with the objects of sense as shoots" },
      { "sa": "adhaḥ", "en": "downward" },
      { "sa": "ca", "en": "and" },
      { "sa": "mūlāni", "en": "the roots" },
      { "sa": "anusantatāni", "en": "stretched out" },
      { "sa": "karma-anubandhīni", "en": "bound up with action", "term": "karma" },
      { "sa": "manuṣya-loke", "en": "in the world of men" }
    ],
    "translation": "Downward and upward the branches of it are spread out, grown strong by the guṇas, with the objects of sense as shoots. And downward the roots are stretched out, bound up with action, in the world of men.",
    "notes": ["\"Bound up with action\" can also be read as \"resulting in action\"."]
  },
  "3": {
    "words": [
      { "sa": "na", "en": "not" },
      { "sa": "rūpam", "en": "the form" },
      { "sa": "asya", "en": "of it" },
      { "sa": "iha", "en": "here" },
      { "sa": "tathā", "en": "in that way" },
      { "sa": "upalabhyate", "en": "is perceived" },
      { "sa": "na", "en": "not" },
      { "sa": "antaḥ", "en": "the end" },
      { "sa": "na", "en": "not" },
      { "sa": "ca", "en": "and" },
      { "sa": "ādiḥ", "en": "the beginning" },
      { "sa": "na", "en": "not" },
      { "sa": "ca", "en": "and" },
      { "sa": "sampratiṣṭhā", "en": "the foundation" },
      { "sa": "aśvattham", "en": "the sacred fig tree" },
      { "sa": "enam", "en": "this" },
      { "sa": "su-virūḍha-mūlam", "en": "whose roots are fully grown" },
      { "sa": "asaṅga-śastreṇa", "en": "with the weapon of non-attachment", "term": "sanga" },
      { "sa": "dṛḍhena", "en": "firm" },
      { "sa": "chittvā", "en": "having cut" }
    ],
    "translation": "The form of it is not perceived here in that way, nor the end, nor the beginning, nor the foundation. Having cut this sacred fig tree, whose roots are fully grown, with the firm weapon of non-attachment,",
    "notes": ["Verses 3 to 4 are one sentence in the Sanskrit."]
  },
  "4": {
    "words": [
      { "sa": "tataḥ", "en": "then" },
      { "sa": "padam", "en": "place" },
      { "sa": "tat", "en": "that" },
      { "sa": "parimārgitavyam", "en": "is to be sought" },
      { "sa": "yasmin", "en": "to which" },
      { "sa": "gatāḥ", "en": "those who have gone" },
      { "sa": "na", "en": "not" },
      { "sa": "nivartanti", "en": "they return" },
      { "sa": "bhūyaḥ", "en": "again" },
      { "sa": "tam", "en": "in that" },
      { "sa": "eva", "en": "very" },
      { "sa": "ca", "en": "and" },
      { "sa": "ādyam", "en": "primal" },
      { "sa": "puruṣam", "en": "person" },
      { "sa": "prapadye", "en": "I take refuge" },
      { "sa": "yataḥ", "en": "from whom" },
      { "sa": "pravṛttiḥ", "en": "the activity" },
      { "sa": "prasṛtā", "en": "has flowed forth" },
      { "sa": "purāṇī", "en": "ancient" }
    ],
    "translation": "then that place is to be sought, to which those who have gone do not return again. And I take refuge in that very primal person, from whom the ancient activity has flowed forth.",
    "notes": ["\"I take refuge\" is the seeker's own thought, spoken in the first person. It can also be read as \"one should take refuge\"."]
  },
  "5": {
    "words": [
      { "sa": "nirmāna-mohāḥ", "en": "without pride and delusion" },
      { "sa": "jita-saṅga-doṣāḥ", "en": "with the fault of attachment conquered", "term": "sanga" },
      { "sa": "adhyātma-nityāḥ", "en": "constant in what concerns the self", "term": "atman" },
      { "sa": "vinivṛtta-kāmāḥ", "en": "with desires turned away", "term": "kama" },
      { "sa": "dvandvaiḥ", "en": "from the pairs" },
      { "sa": "vimuktāḥ", "en": "freed" },
      { "sa": "sukha-duḥkha-saṁjñaiḥ", "en": "named pleasure and pain" },
      { "sa": "gacchanti", "en": "they go" },
      { "sa": "amūḍhāḥ", "en": "the undeluded" },
      { "sa": "padam", "en": "to the place" },
      { "sa": "avyayam", "en": "undecaying" },
      { "sa": "tat", "en": "that" }
    ],
    "translation": "Without pride and delusion, with the fault of attachment conquered, constant in what concerns the self, with desires turned away, freed from the pairs named pleasure and pain, the undeluded go to that undecaying place."
  },
  "6": {
    "words": [
      { "sa": "na", "en": "not" },
      { "sa": "tat", "en": "that" },
      { "sa": "bhāsayate", "en": "lights up" },
      { "sa": "sūryaḥ", "en": "the sun" },
      { "sa": "na", "en": "not" },
      { "sa": "śaśāṅkaḥ", "en": "the moon" },
      { "sa": "na", "en": "not" },
      { "sa": "pāvakaḥ", "en": "fire" },
      { "sa": "yat", "en": "to which" },
      { "sa": "gatvā", "en": "having gone" },
      { "sa": "na", "en": "not" },
      { "sa": "nivartante", "en": "they return" },
      { "sa": "tat", "en": "that" },
      { "sa": "dhāma", "en": "abode" },
      { "sa": "paramam", "en": "supreme" },
      { "sa": "mama", "en": "my" }
    ],
    "translation": "The sun does not light up that, nor the moon, nor fire. That to which, having gone, they do not return is my supreme abode."
  },
  "7": {
    "words": [
      { "sa": "mama", "en": "of me" },
      { "sa": "eva", "en": "indeed" },
      { "sa": "aṁśaḥ", "en": "a part" },
      { "sa": "jīva-loke", "en": "in the world of the living" },
      { "sa": "jīva-bhūtaḥ", "en": "having become a living being" },
      { "sa": "sanātanaḥ", "en": "eternal" },
      { "sa": "manaḥ-ṣaṣṭhāni", "en": "with the mind as the sixth", "term": "manas" },
      { "sa": "indriyāṇi", "en": "the senses", "term": "indriya" },
      { "sa": "prakṛti-sthāni", "en": "resting in nature" },
      { "sa": "karṣati", "en": "it draws" }
    ],
    "translation": "A part of me indeed, eternal, having become a living being in the world of the living, draws the senses, with the mind as the sixth, resting in nature."
  },
  "8": {
    "words": [
      { "sa": "śarīram", "en": "a body" },
      { "sa": "yat", "en": "when" },
      { "sa": "avāpnoti", "en": "he obtains" },
      { "sa": "yat", "en": "when" },
      { "sa": "ca", "en": "and" },
      { "sa": "api", "en": "also" },
      { "sa": "utkrāmati", "en": "he departs" },
      { "sa": "īśvaraḥ", "en": "the lord" },
      { "sa": "gṛhītvā", "en": "having taken" },
      { "sa": "etāni", "en": "these" },
      { "sa": "saṁyāti", "en": "he goes" },
      { "sa": "vāyuḥ", "en": "the wind" },
      { "sa": "gandhān", "en": "scents" },
      { "sa": "iva", "en": "like" },
      { "sa": "āśayāt", "en": "from their resting place" }
    ],
    "translation": "When the lord obtains a body, and also when he departs, he goes having taken these, like the wind taking scents from their resting place.",
    "notes": ["\"When the lord obtains a body, and also when he departs\" can also be read as \"whatever body the lord obtains, and whatever body he departs from\"."]
  },
  "9": {
    "words": [
      { "sa": "śrotram", "en": "hearing" },
      { "sa": "cakṣuḥ", "en": "sight" },
      { "sa": "sparśanam", "en": "touch" },
      { "sa": "ca", "en": "and" },
      { "sa": "rasanam", "en": "taste" },
      { "sa": "ghrāṇam", "en": "smell" },
      { "sa": "eva", "en": "indeed" },
      { "sa": "ca", "en": "and" },
      { "sa": "adhiṣṭhāya", "en": "presiding over" },
      { "sa": "manaḥ", "en": "the mind", "term": "manas" },
      { "sa": "ca", "en": "and" },
      { "sa": "ayam", "en": "this one" },
      { "sa": "viṣayān", "en": "the objects of sense" },
      { "sa": "upasevate", "en": "attends on" }
    ],
    "translation": "Presiding over hearing, sight and touch, taste and indeed smell, and the mind, this one attends on the objects of sense."
  },
  "10": {
    "words": [
      { "sa": "utkrāmantam", "en": "departing" },
      { "sa": "sthitam", "en": "staying" },
      { "sa": "vā", "en": "or" },
      { "sa": "api", "en": "also" },
      { "sa": "bhuñjānam", "en": "experiencing" },
      { "sa": "vā", "en": "or" },
      { "sa": "guṇa-anvitam", "en": "joined with the guṇas", "term": "guna" },
      { "sa": "vimūḍhāḥ", "en": "the deluded" },
      { "sa": "na", "en": "not" },
      { "sa": "anupaśyanti", "en": "they see" },
      { "sa": "paśyanti", "en": "they see" },
      { "sa": "jñāna-cakṣuṣaḥ", "en": "those with the eye of knowledge" }
    ],
    "translation": "Departing, or also staying, or experiencing, joined with the guṇas: the deluded do not see him. Those with the eye of knowledge see."
  },
  "11": {
    "words": [
      { "sa": "yatantaḥ", "en": "striving" },
      { "sa": "yoginaḥ", "en": "the yogīs", "term": "yoga" },
      { "sa": "ca", "en": "and" },
      { "sa": "enam", "en": "this one" },
      { "sa": "paśyanti", "en": "they see" },
      { "sa": "ātmani", "en": "in the self", "term": "atman" },
      { "sa": "avasthitam", "en": "established" },
      { "sa": "yatantaḥ", "en": "striving" },
      { "sa": "api", "en": "even though" },
      { "sa": "akṛta-ātmānaḥ", "en": "those whose self is unformed", "term": "atman" },
      { "sa": "na", "en": "not" },
      { "sa": "enam", "en": "this one" },
      { "sa": "paśyanti", "en": "they see" },
      { "sa": "acetasaḥ", "en": "the unthinking" }
    ],
    "translation": "And the striving yogīs see this one established in the self. Even though striving, those whose self is unformed, the unthinking, do not see this one.",
    "notes": ["\"Established in the self\" can also be read as \"established in themselves\", meaning in their own body or mind."]
  },
  "12": {
    "words": [
      { "sa": "yat", "en": "which" },
      { "sa": "āditya-gatam", "en": "residing in the sun" },
      { "sa": "tejaḥ", "en": "the brilliance" },
      { "sa": "jagat", "en": "the world" },
      { "sa": "bhāsayate", "en": "lights up" },
      { "sa": "akhilam", "en": "whole" },
      { "sa": "yat", "en": "which" },
      { "sa": "candramasi", "en": "in the moon" },
      { "sa": "yat", "en": "which" },
      { "sa": "ca", "en": "and" },
      { "sa": "agnau", "en": "in fire" },
      { "sa": "tat", "en": "that" },
      { "sa": "tejaḥ", "en": "brilliance" },
      { "sa": "viddhi", "en": "know" },
      { "sa": "māmakam", "en": "mine" }
    ],
    "translation": "The brilliance residing in the sun which lights up the whole world, which is in the moon and which is in fire: know that brilliance to be mine."
  },
  "13": {
    "words": [
      { "sa": "gām", "en": "the earth" },
      { "sa": "āviśya", "en": "having entered" },
      { "sa": "ca", "en": "and" },
      { "sa": "bhūtāni", "en": "beings" },
      { "sa": "dhārayāmi", "en": "I support" },
      { "sa": "aham", "en": "I" },
      { "sa": "ojasā", "en": "by vigour" },
      { "sa": "puṣṇāmi", "en": "I nourish" },
      { "sa": "ca", "en": "and" },
      { "sa": "oṣadhīḥ", "en": "the plants" },
      { "sa": "sarvāḥ", "en": "all" },
      { "sa": "somaḥ", "en": "the moon" },
      { "sa": "bhūtvā", "en": "having become" },
      { "sa": "rasa-ātmakaḥ", "en": "whose nature is sap" }
    ],
    "translation": "And having entered the earth, I support beings by vigour, and I nourish all the plants, having become the moon, whose nature is sap.",
    "notes": ["\"The moon, whose nature is sap\" can also be read as \"the soma plant, whose nature is juice\"."]
  },
  "14": {
    "words": [
      { "sa": "aham", "en": "I" },
      { "sa": "vaiśvānaraḥ", "en": "the fire common to all men" },
      { "sa": "bhūtvā", "en": "having become" },
      { "sa": "prāṇinām", "en": "of breathing creatures" },
      { "sa": "deham", "en": "the body" },
      { "sa": "āśritaḥ", "en": "dwelling in" },
      { "sa": "prāṇa-apāna-samāyuktaḥ", "en": "joined with the outgoing and incoming breaths" },
      { "sa": "pacāmi", "en": "I cook" },
      { "sa": "annam", "en": "food" },
      { "sa": "catur-vidham", "en": "of four kinds" }
    ],
    "translation": "Having become the fire common to all men, dwelling in the body of breathing creatures, joined with the outgoing and incoming breaths, I cook food of four kinds.",
    "notes": ["\"I cook\" can also be read as \"I digest\"."]
  },
  "15": {
    "words": [
      { "sa": "sarvasya", "en": "of all" },
      { "sa": "ca", "en": "and" },
      { "sa": "aham", "en": "I" },
      { "sa": "hṛdi", "en": "in the heart" },
      { "sa": "sanniviṣṭaḥ", "en": "seated" },
      { "sa": "mattaḥ", "en": "from me" },
      { "sa": "smṛtiḥ", "en": "memory" },
      { "sa": "jñānam", "en": "knowledge" },
      { "sa": "apohanam", "en": "their removal" },
      { "sa": "ca", "en": "and" },
      { "sa": "vedaiḥ", "en": "by the Vedas" },
      { "sa": "ca", "en": "and" },
      { "sa": "sarvaiḥ", "en": "all" },
      { "sa": "aham", "en": "I" },
      { "sa": "eva", "en": "alone" },
      { "sa": "vedyaḥ", "en": "to be known" },
      { "sa": "vedānta-kṛt", "en": "the maker of the end of the Vedas" },
      { "sa": "veda-vit", "en": "the knower of the Vedas" },
      { "sa": "eva", "en": "indeed" },
      { "sa": "ca", "en": "and" },
      { "sa": "aham", "en": "I" }
    ],
    "translation": "And I am seated in the heart of all. From me are memory, knowledge and their removal. And by all the Vedas I alone am to be known. I am the maker of the end of the Vedas and indeed the knower of the Vedas.",
    "notes": ["\"Their removal\" can also be read as \"reasoning\", the power of working through doubts."]
  },
  "16": {
    "words": [
      { "sa": "dvau", "en": "two" },
      { "sa": "imau", "en": "these" },
      { "sa": "puruṣau", "en": "persons" },
      { "sa": "loke", "en": "in the world" },
      { "sa": "kṣaraḥ", "en": "the perishable" },
      { "sa": "ca", "en": "and" },
      { "sa": "akṣaraḥ", "en": "the imperishable" },
      { "sa": "eva", "en": "indeed" },
      { "sa": "ca", "en": "and" },
      { "sa": "kṣaraḥ", "en": "the perishable" },
      { "sa": "sarvāṇi", "en": "all" },
      { "sa": "bhūtāni", "en": "beings" },
      { "sa": "kūṭa-sthaḥ", "en": "the one standing at the peak" },
      { "sa": "akṣaraḥ", "en": "the imperishable" },
      { "sa": "ucyate", "en": "is called" }
    ],
    "translation": "There are these two persons in the world: the perishable and indeed the imperishable. The perishable is all beings. The one standing at the peak is called the imperishable.",
    "notes": ["\"The one standing at the peak\" can also be read as \"the one who stands unchanging, like an anvil\"."]
  },
  "17": {
    "words": [
      { "sa": "uttamaḥ", "en": "the highest" },
      { "sa": "puruṣaḥ", "en": "person" },
      { "sa": "tu", "en": "but" },
      { "sa": "anyaḥ", "en": "another" },
      { "sa": "parama-ātmā", "en": "the supreme self", "term": "atman" },
      { "sa": "iti", "en": "thus" },
      { "sa": "udāhṛtaḥ", "en": "declared" },
      { "sa": "yaḥ", "en": "who" },
      { "sa": "loka-trayam", "en": "the three worlds" },
      { "sa": "āviśya", "en": "having entered" },
      { "sa": "bibharti", "en": "sustains" },
      { "sa": "avyayaḥ", "en": "undecaying" },
      { "sa": "īśvaraḥ", "en": "the lord" }
    ],
    "translation": "But the highest person is another, declared thus as the supreme self, the undecaying lord who, having entered the three worlds, sustains them."
  },
  "18": {
    "words": [
      { "sa": "yasmāt", "en": "because" },
      { "sa": "kṣaram", "en": "the perishable" },
      { "sa": "atītaḥ", "en": "gone beyond" },
      { "sa": "aham", "en": "I" },
      { "sa": "akṣarāt", "en": "than the imperishable" },
      { "sa": "api", "en": "even" },
      { "sa": "ca", "en": "and" },
      { "sa": "uttamaḥ", "en": "higher" },
      { "sa": "ataḥ", "en": "therefore" },
      { "sa": "asmi", "en": "I am" },
      { "sa": "loke", "en": "in the world" },
      { "sa": "vede", "en": "in the Veda" },
      { "sa": "ca", "en": "and" },
      { "sa": "prathitaḥ", "en": "celebrated" },
      { "sa": "puruṣa-uttamaḥ", "en": "the highest person" }
    ],
    "translation": "Because I have gone beyond the perishable and am higher even than the imperishable, therefore I am celebrated in the world and in the Veda as the highest person."
  },
  "19": {
    "words": [
      { "sa": "yaḥ", "en": "he who" },
      { "sa": "mām", "en": "me" },
      { "sa": "evam", "en": "thus" },
      { "sa": "asammūḍhaḥ", "en": "undeluded" },
      { "sa": "jānāti", "en": "knows" },
      { "sa": "puruṣa-uttamam", "en": "as the highest person" },
      { "sa": "saḥ", "en": "he" },
      { "sa": "sarva-vit", "en": "knowing all" },
      { "sa": "bhajati", "en": "worships" },
      { "sa": "mām", "en": "me" },
      { "sa": "sarva-bhāvena", "en": "with his whole being" },
      { "sa": "bhārata", "en": "O descendant of Bharata" }
    ],
    "translation": "He who, undeluded, thus knows me as the highest person, he, knowing all, worships me with his whole being, O descendant of Bharata.",
    "notes": ["\"With his whole being\" can also be read as \"in every way\"."]
  },
  "20": {
    "words": [
      { "sa": "iti", "en": "thus" },
      { "sa": "guhyatamam", "en": "most secret" },
      { "sa": "śāstram", "en": "teaching" },
      { "sa": "idam", "en": "this" },
      { "sa": "uktam", "en": "has been spoken" },
      { "sa": "mayā", "en": "by me" },
      { "sa": "anagha", "en": "O sinless one" },
      { "sa": "etat", "en": "this" },
      { "sa": "buddhvā", "en": "having understood" },
      { "sa": "buddhimān", "en": "possessed of buddhi", "term": "buddhi" },
      { "sa": "syāt", "en": "one would be" },
      { "sa": "kṛta-kṛtyaḥ", "en": "one who has done what is to be done" },
      { "sa": "ca", "en": "and" },
      { "sa": "bhārata", "en": "O descendant of Bharata" }
    ],
    "translation": "Thus this most secret teaching has been spoken by me, O sinless one. Having understood this, one would be possessed of buddhi and one who has done what is to be done, O descendant of Bharata."
  }
}

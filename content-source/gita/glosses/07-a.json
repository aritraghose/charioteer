      { "sa": "ātmā", "en": "the self", "term": "atman" },
      { "sa": "eva", "en": "very" },
      { "sa": "me", "en": "my" },
      { "sa": "matam", "en": "view" },
      { "sa": "āsthitaḥ", "en": "has resorted to" },
      { "sa": "saḥ", "en": "he" },
      { "sa": "hi", "en": "for" },
      { "sa": "yukta-ātmā", "en": "with the self yoked", "term": "yoga" },
      { "sa": "mām", "en": "me" },

      { "sa": "priyaḥ", "en": "dear" },
      { "sa": "hi", "en": "for" },
      { "sa": "jñāninaḥ", "en": "to the one who knows" },
      { "sa": "atyartham", "en": "exceedingly" },
      { "sa": "aham", "en": "I" },
      { "sa": "saḥ", "en": "he" },
      { "sa": "ca", "en": "and" },
      { "sa": "mama", "en": "to me" },
      { "sa": "priyaḥ", "en": "dear" }

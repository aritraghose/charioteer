      { "sa": "janāḥ", "en": "people" },
      { "sa": "sukṛtinaḥ", "en": "who do good" },
      { "sa": "arjuna", "en": "O Arjuna" },
      { "sa": "ārtaḥ", "en": "the distressed one" },
      { "sa": "jijñāsuḥ", "en": "the one who wishes to know" },
      { "sa": "artha-arthī", "en": "the one who seeks gain" },
      { "sa": "jñānī", "en": "the one who knows" },
      { "sa": "ca", "en": "and" },
      { "sa": "bharata-ṛṣabha", "en": "O bull of the Bharatas" }

      { "sa": "bhavati", "en": "is" },
      { "sa": "alpa-medhasām", "en": "of little understanding" },
      { "sa": "devān", "en": "to the gods" },
      { "sa": "deva-yajaḥ", "en": "those who sacrifice to the gods" },
      { "sa": "yānti", "en": "go" },
      { "sa": "mat-bhaktāḥ", "en": "my devotees" },
      { "sa": "yānti", "en": "go" },
      { "sa": "mām", "en": "to me" },
      { "sa": "api", "en": "in turn" }
    ],
    "translation": "But that fruit of those of little understanding has an end. Those who sacrifice to the gods go to the gods. My devotees in turn go to me."
  },
  "24": {
    "words": [
      { "sa": "avyaktam", "en": "the unmanifest" },
      { "sa": "vyaktim", "en": "into manifestation" },
      { "sa": "āpannam", "en": "as having come" },
      { "sa": "manyante", "en": "they think" },
      { "sa": "mām", "en": "me" },
      { "sa": "abuddhayaḥ", "en": "those without intelligence", "term": "buddhi" },
      { "sa": "param", "en": "higher" },
      { "sa": "bhāvam", "en": "state of being" },
      { "sa": "ajānantaḥ", "en": "not knowing" },
      { "sa": "mama", "en": "my" },
      { "sa": "avyayam", "en": "imperishable" },
      { "sa": "anuttamam", "en": "unsurpassed" }
    ],
    "translation": "Those without buddhi think of me, the unmanifest, as having come into manifestation, not knowing my higher state of being, imperishable and unsurpassed."
  },
  "25": {
    "words": [
      { "sa": "na", "en": "not" },
      { "sa": "aham", "en": "I" },
      { "sa": "prakāśaḥ", "en": "visible" },
      { "sa": "sarvasya", "en": "to all" },
      { "sa": "yoga-māyā-samāvṛtaḥ", "en": "covered by the illusion of yoga", "term": "yoga" },
      { "sa": "mūḍhaḥ", "en": "deluded" },
      { "sa": "ayam", "en": "this" },
      { "sa": "na", "en": "not" },
      { "sa": "abhijānāti", "en": "recognises" },
      { "sa": "lokaḥ", "en": "world" },
      { "sa": "mām", "en": "me" },
      { "sa": "ajam", "en": "the unborn" },
      { "sa": "avyayam", "en": "the imperishable" }
    ],
    "translation": "I am not visible to all, covered by the illusion of yoga. This deluded world does not recognise me, the unborn, the imperishable."
  },
  "26": {
    "words": [
      { "sa": "veda", "en": "know" },
      { "sa": "aham", "en": "I" },
      { "sa": "samatītāni", "en": "that have passed" },
      { "sa": "vartamānāni", "en": "that are present" },
      { "sa": "ca", "en": "and" },
      { "sa": "arjuna", "en": "O Arjuna" },
      { "sa": "bhaviṣyāṇi", "en": "that are to come" },
      { "sa": "ca", "en": "and" },
      { "sa": "bhūtāni", "en": "the beings" },
      { "sa": "mām", "en": "me" },
      { "sa": "tu", "en": "but" },
      { "sa": "veda", "en": "knows" },
      { "sa": "na", "en": "not" },
      { "sa": "kaścana", "en": "anyone at all" }
    ],
    "translation": "I know the beings that have passed, and those that are present, O Arjuna, and those that are to come. But no one at all knows me."
  },
  "27": {
    "words": [
      { "sa": "icchā-dveṣa-samutthena", "en": "arising from wanting and aversion" },
      { "sa": "dvandva-mohena", "en": "by the delusion of the pairs of opposites" },
      { "sa": "bhārata", "en": "O descendant of Bharata" },
      { "sa": "sarva-bhūtāni", "en": "all beings" },
      { "sa": "sammoham", "en": "to delusion" },
      { "sa": "sarge", "en": "at birth" },
      { "sa": "yānti", "en": "go" },
      { "sa": "parantapa", "en": "O scorcher of foes" }
    ],
    "translation": "By the delusion of the pairs of opposites, arising from wanting and aversion, O descendant of Bharata, all beings go to delusion at birth, O scorcher of foes.",
    "notes": ["\"At birth\" can also be read as \"in creation\", meaning in this created world rather than at the moment each being is born."]
  },
  "28": {
    "words": [
      { "sa": "yeṣām", "en": "of whom" },
      { "sa": "tu", "en": "but" },
      { "sa": "anta-gatam", "en": "come to an end" },
      { "sa": "pāpam", "en": "evil" },
      { "sa": "janānām", "en": "of people" },
      { "sa": "puṇya-karmaṇām", "en": "of pure action", "term": "karma" },
      { "sa": "te", "en": "they" },
      { "sa": "dvandva-moha-nirmuktāḥ", "en": "freed from the delusion of the pairs of opposites" },
      { "sa": "bhajante", "en": "worship" },
      { "sa": "mām", "en": "me" },
      { "sa": "dṛḍha-vratāḥ", "en": "firm in their vows" }
    ],
    "translation": "But the people of pure action, whose evil has come to an end, they, freed from the delusion of the pairs of opposites, worship me, firm in their vows."
  },
  "29": {
    "words": [
      { "sa": "jarā-maraṇa-mokṣāya", "en": "for release from old age and death" },
      { "sa": "mām", "en": "in me" },
      { "sa": "āśritya", "en": "having taken refuge" },
      { "sa": "yatanti", "en": "strive" },
      { "sa": "ye", "en": "those who" },
      { "sa": "te", "en": "they" },
      { "sa": "brahma", "en": "brahman", "term": "brahman" },
      { "sa": "tat", "en": "that" },
      { "sa": "viduḥ", "en": "know" },
      { "sa": "kṛtsnam", "en": "the whole" },
      { "sa": "adhyātmam", "en": "what concerns the self", "term": "atman" },
      { "sa": "karma", "en": "action", "term": "karma" },
      { "sa": "ca", "en": "and" },
      { "sa": "akhilam", "en": "entire" }
    ],
    "translation": "Those who strive for release from old age and death, having taken refuge in me, they know that brahman, the whole of what concerns the self, and the entire action.",
    "notes": ["\"That brahman, the whole of what concerns the self\" can also be read with \"the whole\" describing brahman: they know that brahman completely, and also what concerns the self."]

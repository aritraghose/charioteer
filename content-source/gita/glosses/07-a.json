      { "sa": "ca", "en": "and" },
      { "sa": "ye", "en": "those who" },
      { "sa": "viduḥ", "en": "know" },
      { "sa": "prayāṇa-kāle", "en": "at the time of departure" },
      { "sa": "api", "en": "even" },
      { "sa": "ca", "en": "and" },
      { "sa": "mām", "en": "me" },
      { "sa": "te", "en": "they" },
      { "sa": "viduḥ", "en": "know" },
      { "sa": "yukta-cetasaḥ", "en": "with minds yoked", "term": "yoga" }

      { "sa": "duṣkṛtinaḥ", "en": "the evildoers" },
      { "sa": "mūḍhāḥ", "en": "the deluded" },
      { "sa": "prapadyante", "en": "take refuge" },
      { "sa": "nara-adhamāḥ", "en": "the lowest of men" },
